// Node 3 screen-space radiance source. The final native + Nanite GBuffer is
// the sole visibility/material input. This resource is consumed by screen
// probes later; it is not a final diffuse result.
#pragma kernel BuildScreenSurfaceRadiance
#pragma kernel VisualizeScreenSurface
#pragma multi_compile _ _GBUFFER_NORMALS_OCT
#pragma target 5.0

#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"
#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/GBufferInput.hlsl"

RWTexture2D<float4> _GIScreenSurfaceRadiance;
Texture2D<float4> _GIScreenSurfaceInput;
Texture2D<float4> _GISurfaceLightingTexture;
RWTexture2D<float4> _GIScreenSurfaceDebug;
uint2 _GIOutputSize;
float3 _GIMainLightDirection;
float3 _GIMainLightColor;
uint _GIHasMainLight;
uint _GIScreenSurfaceDebugMode;

bool GIIsBackground(float depth)
{
#if UNITY_REVERSED_Z
    return depth <= 1e-6;
#else
    return depth >= 0.999999;
#endif
}

[numthreads(8, 8, 1)]
void BuildScreenSurfaceRadiance(uint3 dispatchId : SV_DispatchThreadID)
{
    if (any(dispatchId.xy >= _GIOutputSize))
        return;

    GBufferData surface = UnpackGBuffers(dispatchId.xy);
    if (GIIsBackground(surface.depth))
    {
        _GIScreenSurfaceRadiance[dispatchId.xy] = 0.0;
        return;
    }

    BRDFData brdf = GBufferDataToBRDFData(surface);
    float direct = _GIHasMainLight != 0u
        ? saturate(dot(surface.normalWS, normalize(_GIMainLightDirection)))
        : 0.0;
    // Store outgoing diffuse radiance. Probe cosine sampling multiplies by PI
    // to estimate irradiance, and the receiver BRDF applies 1/PI at composite.
    // While realtime diffuse replacement is active, the GBuffer lighting target
    // contains emission only. Native indirect specular belongs to the later
    // Specular/ReSTIR node and must not be diffused through this cache.
    float3 surfaceLighting = max(0.0,
        _GISurfaceLightingTexture.Load(int3(dispatchId.xy, 0)).rgb);
    float3 radiance = max(0.0,
        surfaceLighting + brdf.diffuse * _GIMainLightColor * direct * (1.0 / PI));
    _GIScreenSurfaceRadiance[dispatchId.xy] = float4(radiance, 1.0);
}

[numthreads(8, 8, 1)]
void VisualizeScreenSurface(uint3 dispatchId : SV_DispatchThreadID)
{
    if (any(dispatchId.xy >= _GIOutputSize))
        return;
    float4 surface = _GIScreenSurfaceInput.Load(int3(dispatchId.xy, 0));
    float3 color = _GIScreenSurfaceDebugMode == 0u
        ? surface.rgb
        : surface.aaa;
    _GIScreenSurfaceDebug[dispatchId.xy] = float4(color, 1.0);
}
