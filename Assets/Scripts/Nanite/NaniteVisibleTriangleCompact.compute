static const uint NANITE_PAGE_INVALID = 0xFFFFFFFFu;
static const uint NANITE_RESIDENT_GEOMETRY_READY = 1u << 0u;

// Unreal Nanite-style hybrid raster compatibility backend. Unity ShaderLab does
// not expose SM 6.6 64-bit typed UAV atomics, so software and hardware raster
// run against separate visibility targets and are merged after both complete.
// Classification remains entirely GPU driven and uses the same compact cluster
// ABI as the indexed hardware path.
StructuredBuffer<uint3> _HybridInputClusters;
StructuredBuffer<uint> _HybridInputCountArgs;
AppendStructuredBuffer<uint3> _HybridHardwareClusters;
AppendStructuredBuffer<uint3> _HybridSoftwareClusters;
StructuredBuffer<uint3> _HybridSoftwareClustersRead;
StructuredBuffer<uint> _HybridSoftwareCountArgs;
StructuredBuffer<float> _HybridVertexData;
StructuredBuffer<int> _HybridIndices;
StructuredBuffer<float4x4> _HybridInstanceLocalToWorld;
StructuredBuffer<int> _HybridTriangleCluster;
StructuredBuffer<float4> _HybridClusterBounds;
StructuredBuffer<float> _HybridClusterLongestEdge;
StructuredBuffer<int> _HybridTriangleSubMesh;
StructuredBuffer<float4x4> _HybridViewConstants;
RWStructuredBuffer<float4x4> _HybridViewConstantsWrite;
RWTexture2D<uint> _HybridSoftwareDepth;
RWTexture2D<uint> _HybridSoftwareWinner;
RWStructuredBuffer<uint> _HybridSoftwareTileHeads;
RWStructuredBuffer<uint2> _HybridSoftwareTileNodes;
RWStructuredBuffer<uint> _HybridSoftwareTileNodeCounter;
RWStructuredBuffer<uint> _HybridSoftwareFallbackFlags;
AppendStructuredBuffer<uint> _HybridSoftwareTileList;
StructuredBuffer<uint> _HybridSoftwareTileListRead;
StructuredBuffer<uint> _HybridSoftwareTileCountArgs;
float4x4 _HybridWorldToClip;
uint _HybridVertexStride;
uint _HybridScreenWidth;
uint _HybridScreenHeight;
