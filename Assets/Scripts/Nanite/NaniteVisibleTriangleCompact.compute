uint _HybridTelemetryEnabled;
uint _HybridMaxSubMeshCount;
uint _HybridUseCapturedView;
float4 _HybridShadowLightDirection;
float4 _HybridShadowBias;
StructuredBuffer<uint> _HybridPrepareCountArgs;
RWStructuredBuffer<uint> _HybridDispatchArgs;
uint _HybridDispatchGroupsX;

static const uint HYBRID_INVALID_NODE = 0xFFFFFFFFu;
static const uint HYBRID_TILE_BATCH_SIZE = 128u;

groupshared uint HybridTileBatchRefs[HYBRID_TILE_BATCH_SIZE];
groupshared int2 HybridTileF0[HYBRID_TILE_BATCH_SIZE];
groupshared int2 HybridTileF1[HYBRID_TILE_BATCH_SIZE];
groupshared int2 HybridTileF2[HYBRID_TILE_BATCH_SIZE];
groupshared float HybridTileZ0[HYBRID_TILE_BATCH_SIZE];
groupshared float HybridTileZ1[HYBRID_TILE_BATCH_SIZE];
groupshared float HybridTileZ2[HYBRID_TILE_BATCH_SIZE];
groupshared int HybridTileArea[HYBRID_TILE_BATCH_SIZE];
groupshared uint HybridTileCursor;
groupshared uint HybridTileBatchCount;

float3 HybridLoadPosition(uint logicalVertex)
{
    uint baseOffset = logicalVertex * max(3u, _HybridVertexStride);
    return float3(
        _HybridVertexData[baseOffset + 0u],
        _HybridVertexData[baseOffset + 1u],
        _HybridVertexData[baseOffset + 2u]);
}

bool HybridLoadVertex(
    uint triangleId,
    uint corner,
    out float3 positionOS,
    out float3 normalOS)
{
    positionOS = 0.0.xxx;
    normalOS = float3(0.0, 1.0, 0.0);
    if (_UsePackedPageGeometry != 0u)
    {
        uint2 triangleRef = _TrianglePageRefs[triangleId];
        if (triangleRef.x == NANITE_PAGE_INVALID || triangleRef.y == NANITE_PAGE_INVALID)
            return false;
        NaniteGpuResidentPageEntry page = _NaniteResidentPageTable[triangleRef.y];
        uint localIndex = triangleRef.x + min(corner, 2u);
        if ((page.flags & NANITE_RESIDENT_GEOMETRY_READY) == 0u ||
            page.indexBase == NANITE_PAGE_INVALID ||
            localIndex >= page.indexCount)
            return false;
        uint logicalVertex = _NaniteResidentIndices[page.indexBase + localIndex];
        positionOS = _NaniteResidentVertices[logicalVertex].positionOS;
        normalOS = _NaniteResidentVertices[logicalVertex].normalOS;
        return true;
    }

    uint sourceIndex = triangleId * 3u + min(corner, 2u);
    uint logicalVertex = (uint)max(0, _HybridIndices[sourceIndex]);
    positionOS = HybridLoadPosition(logicalVertex);
    if (_HybridVertexStride >= 8u)
    {
        uint baseOffset = logicalVertex * _HybridVertexStride;
        normalOS = float3(
            _HybridVertexData[baseOffset + 5u],
            _HybridVertexData[baseOffset + 6u],
            _HybridVertexData[baseOffset + 7u]);
    }
    return true;
}

bool HybridTransformVertex(
    uint triangleId,
    uint corner,
    uint instanceId,
    out float4 positionCS)
{
    float3 positionOS;
    float3 normalOS;
    if (!HybridLoadVertex(triangleId, corner, positionOS, normalOS))
    {
        positionCS = 0.0.xxxx;
        return false;
    }
    float4x4 localToWorld = _HybridInstanceLocalToWorld[instanceId];
    float3 positionWS = mul(localToWorld, float4(positionOS, 1.0)).xyz;
    if (_HybridShadowMode != 0u)
    {
        float3x3 m = (float3x3)localToWorld;
        float3 c0 = mul(m, float3(1.0, 0.0, 0.0));
        float3 c1 = mul(m, float3(0.0, 1.0, 0.0));
        float3 c2 = mul(m, float3(0.0, 0.0, 1.0));
        float3 normalWS = normalize(
            normalOS.x * cross(c1, c2) +
            normalOS.y * cross(c2, c0) +
            normalOS.z * cross(c0, c1));
        float3 lightDirection = normalize(_HybridShadowLightDirection.xyz);
        float invNdotL = 1.0 - saturate(dot(lightDirection, normalWS));
        positionWS += lightDirection * _HybridShadowBias.x;
        positionWS += normalWS * (invNdotL * _HybridShadowBias.y);
    }
    float4x4 worldToClip = (_HybridShadowMode != 0u || _HybridUseCapturedView == 0u)
        ? _HybridWorldToClip
        : _HybridViewConstants[0];
    positionCS = mul(worldToClip, float4(positionWS, 1.0));
    return true;
}

bool HybridTriangleNeedsClipping(float4 p0, float4 p1, float4 p2)
{
    // Software raster only receives triangles fully inside the homogeneous
    // clip volume. Any clipping case remains on the fixed-function path.
    if (p0.w <= 1e-6 || p1.w <= 1e-6 || p2.w <= 1e-6)
        return true;
    bool3 outsideLeft = bool3(p0.x < -p0.w, p1.x < -p1.w, p2.x < -p2.w);
    bool3 outsideRight = bool3(p0.x > p0.w, p1.x > p1.w, p2.x > p2.w);
    bool3 outsideBottom = bool3(p0.y < -p0.w, p1.y < -p1.w, p2.y < -p2.w);
    bool3 outsideTop = bool3(p0.y > p0.w, p1.y > p1.w, p2.y > p2.w);
    bool3 outsideNear = bool3(p0.z < 0.0, p1.z < 0.0, p2.z < 0.0);
    bool3 outsideFar = bool3(p0.z > p0.w, p1.z > p1.w, p2.z > p2.w);
    return any(outsideLeft) || any(outsideRight) ||
           any(outsideBottom) || any(outsideTop) ||
           any(outsideNear) || any(outsideFar);
}

float2 HybridClipToPixel(float4 p)
{
    float2 ndc = p.xy / p.w;
    return float2(
        (ndc.x * 0.5 + 0.5) * (float)_HybridScreenWidth,
        (-ndc.y * 0.5 + 0.5) * (float)_HybridScreenHeight);
}

float HybridMaxEdgePixels(float4 p0, float4 p1, float4 p2)
{
    float2 s0 = HybridClipToPixel(p0);
    float2 s1 = HybridClipToPixel(p1);
    float2 s2 = HybridClipToPixel(p2);
    return max(length(s1 - s0), max(length(s2 - s1), length(s0 - s2)));
}

float HybridMaxScale(float4x4 localToWorld)
{
    // Match the transform scale used by NVIDIA's cluster traversal. The old
    // Frobenius norm evaluates to sqrt(3) even for a pure rotation, inflating
    // every projected edge and effectively preventing the software queue from
    // ever receiving work. Unity scene transforms use the first three columns
    // as the transformed object axes; their maximum length is the appropriate
    // no-shear scale used by the rest of the Nanite LOD path.
    float3 axisX = float3(localToWorld[0].x, localToWorld[1].x, localToWorld[2].x);
    float3 axisY = float3(localToWorld[0].y, localToWorld[1].y, localToWorld[2].y);
    float3 axisZ = float3(localToWorld[0].z, localToWorld[1].z, localToWorld[2].z);
    return max(length(axisX), max(length(axisY), length(axisZ)));
}

bool HybridClusterFitsSoftware(uint3 draw)
{
    int geometryClusterIndex = _HybridTriangleCluster[draw.x];
    if (geometryClusterIndex < 0)
        return false;

    float4 localSphere = _HybridClusterBounds[geometryClusterIndex];
    float4x4 localToWorld = _HybridInstanceLocalToWorld[draw.z];
    float3 centerWS = mul(localToWorld, float4(localSphere.xyz, 1.0)).xyz;
    float radiusWS = max(0.0, localSphere.w) * HybridMaxScale(localToWorld);
    float4x4 worldToClip = (_HybridShadowMode != 0u || _HybridUseCapturedView == 0u)
        ? _HybridWorldToClip
        : _HybridViewConstants[0];
    float4 centerCS = mul(worldToClip, float4(centerWS, 1.0));
    float4 row0 = worldToClip[0];
    float4 row1 = worldToClip[1];
    float4 row2 = worldToClip[2];
    float4 row3 = worldToClip[3];

    // The sphere must be fully inside the homogeneous clip volume. Anything
    // touching a clip plane remains on fixed-function raster, preserving exact
    // clipping without decoding every triangle during classification.
    if (centerCS.x + centerCS.w <= radiusWS * length((row0 + row3).xyz) ||
        centerCS.w - centerCS.x <= radiusWS * length((row3 - row0).xyz) ||
        centerCS.y + centerCS.w <= radiusWS * length((row1 + row3).xyz) ||
        centerCS.w - centerCS.y <= radiusWS * length((row3 - row1).xyz) ||
        centerCS.z <= radiusWS * length(row2.xyz) ||
        centerCS.w - centerCS.z <= radiusWS * length((row3 - row2).xyz))
        return false;

    float minW = centerCS.w - radiusWS * length(row3.xyz);
    if (minW <= 1e-6)
        return false;
    float diameterPixels = max(
        radiusWS * length(row0.xyz) * (float)_HybridScreenWidth / minW,
        radiusWS * length(row1.xyz) * (float)_HybridScreenHeight / minW);
    float longestEdgeObject = max(0.0, _HybridClusterLongestEdge[geometryClusterIndex]);
    float longestEdgePixels = localSphere.w > 1e-8
        ? diameterPixels * longestEdgeObject / (2.0 * localSphere.w)
        : diameterPixels;
    // NVIDIA vk_lod_clusters bins a clip-safe cluster to software raster from
    // its baked longest edge relative to the projected cluster bounds. Do not
    // add a coverage/triangle-density gate here: it rejected the exact small-
    // triangle workload software raster is intended to absorb and left forced
    // Hybrid frames with an empty SW queue.
    return longestEdgePixels <= max(1.0, _HybridSoftwareMaxEdgePixels);
}

int HybridEdge(int2 a, int2 b, int2 p)
{
    int2 pa = p - a;
    int2 ba = b - a;
    return pa.x * ba.y - pa.y * ba.x;
}

void HybridAppendTriangleTileWork(
    uint softwareClusterIndex,
    uint triangleInCluster)
{
    uint3 draw = _HybridSoftwareClustersRead[softwareClusterIndex];
    if (triangleInCluster >= draw.y)
        return;

    uint triangleId = draw.x + triangleInCluster;
    float4 p0, p1, p2;
    if (!HybridTransformVertex(triangleId, 0u, draw.z, p0) ||
        !HybridTransformVertex(triangleId, 1u, draw.z, p1) ||
        !HybridTransformVertex(triangleId, 2u, draw.z, p2) ||
        HybridTriangleNeedsClipping(p0, p1, p2))
        return;

    int2 f0 = (int2)round(HybridClipToPixel(p0) * 256.0);
    int2 f1 = (int2)round(HybridClipToPixel(p1) * 256.0);
    int2 f2 = (int2)round(HybridClipToPixel(p2) * 256.0);
    // The production hardware correctness path is Cull Off. Mirror that
    // contract in software: either signed area is a valid surface and only a
    // degenerate triangle is rejected. Choosing one sign here selected the
    // opposite shell of closed meshes on part of the screen, yielding valid
    // IDs but back-face normals/material attributes at resolve time.
    if (HybridEdge(f0, f1, f2) == 0)
        return;

    int2 minPixel = max(
        int2(0, 0),
        (min(f0, min(f1, f2)) + 127) >> 8);
    int2 maxPixel = min(
        int2((int)_HybridScreenWidth - 1, (int)_HybridScreenHeight - 1),
        max(f0, max(f1, f2)) >> 8);
    if (any(minPixel > maxPixel))
        return;

    uint tileSize = max(1u, _HybridTileSize);
    uint2 minTile = (uint2)minPixel / tileSize;
    uint2 maxTile = (uint2)maxPixel / tileSize;
    maxTile = min(maxTile, uint2(_HybridTileCountX - 1u, _HybridTileCountY - 1u));
    uint packedRef = (softwareClusterIndex << 7u) | triangleInCluster;
    for (uint tileY = minTile.y; tileY <= maxTile.y; ++tileY)
    {
        for (uint tileX = minTile.x; tileX <= maxTile.x; ++tileX)
        {
            uint tileIndex = tileX + tileY * _HybridTileCountX;
            uint nodeIndex;
            InterlockedAdd(_HybridSoftwareTileNodeCounter[0], 1u, nodeIndex);
            if (nodeIndex >= _HybridTileNodeCapacity)
            {
                uint wasFallback;
                InterlockedCompareExchange(
                    _HybridSoftwareFallbackFlags[softwareClusterIndex],
                    0u,
                    1u,
                    wasFallback);
                if (wasFallback == 0u)
                    _HybridHardwareClusters.Append(draw);
                continue;
            }

            uint previousHead;
            InterlockedExchange(
                _HybridSoftwareTileHeads[tileIndex],
                nodeIndex,
                previousHead);
            _HybridSoftwareTileNodes[nodeIndex] = uint2(packedRef, previousHead);
            if (previousHead == HYBRID_INVALID_NODE)
                _HybridSoftwareTileList.Append(tileIndex);
        }
    }
}

uint _ClusterCount;
uint _CompactedClusterTriangleSlots;

[numthreads(1, 1, 1)]
void CSClear(uint3 id : SV_DispatchThreadID)
{
    _CompactCounter[0] = 0u;
    _DrawArgs[0] = 0u;
    _DrawArgs[1] = 1u;
    _DrawArgs[2] = 0u;
    _DrawArgs[3] = 0u;
}

[numthreads(64, 1, 1)]
void CSCompactClusters(uint3 id : SV_DispatchThreadID)
{
    uint cluster = id.x;
    if (cluster >= _ClusterCount)
        return;
    if (_ClusterVisible[cluster] == 0u)
        return;

    uint first = _ClusterFirstTri[cluster];
    uint count = _ClusterTriCount[cluster];
    uint instance = _ClusterInstance[cluster];
    if (count == 0u)
        return;

    uint dst;
    InterlockedAdd(_CompactCounter[0], 1u, dst);
    _CompactedTriIds[dst] = first;
    _CompactedTriInstances[dst] = instance;
    _CompactedTriCounts[dst] = count;
}

[numthreads(1, 1, 1)]
void CSFinalizeArgs(uint3 id : SV_DispatchThreadID)
{
    if (id.x != 0)
        return;

    uint visibleClusters = _CompactCounter[0];
    _DrawArgs[0] = visibleClusters * max(1u, _CompactedClusterTriangleSlots) * 3u;
    _DrawArgs[1] = 1u;
    _DrawArgs[2] = 0u;
    _DrawArgs[3] = 0u;
}

[numthreads(1, 1, 1)]
void CSFinalizeVisibleDrawQueueArgs(uint3 id : SV_DispatchThreadID)
{
    if (id.x != 0u)
        return;

    uint visibleClusters = _VisibleDrawCountArgs[0];
    _DrawArgs[0] = visibleClusters * max(1u, _CompactedClusterTriangleSlots) * 3u;
    _DrawArgs[1] = 1u;
    _DrawArgs[2] = 0u;
    _DrawArgs[3] = 0u;
}

[numthreads(1, 1, 1)]
void CSFinalizeVisibleDrawQueueArgs4(uint3 id : SV_DispatchThreadID)
{
    if (id.x != 0u)
        return;

    uint multiplier = max(1u, _CompactedClusterTriangleSlots) * 3u;
    _DrawArgs0[0] = _VisibleDrawCountArgs0[0] * multiplier;
    _DrawArgs0[1] = 1u;
    _DrawArgs0[2] = 0u;
    _DrawArgs0[3] = 0u;
    _DrawArgs1[0] = _VisibleDrawCountArgs1[0] * multiplier;
    _DrawArgs1[1] = 1u;
    _DrawArgs1[2] = 0u;
    _DrawArgs1[3] = 0u;
    _DrawArgs2[0] = _VisibleDrawCountArgs2[0] * multiplier;
    _DrawArgs2[1] = 1u;
    _DrawArgs2[2] = 0u;
    _DrawArgs2[3] = 0u;
    _DrawArgs3[0] = _VisibleDrawCountArgs3[0] * multiplier;
    _DrawArgs3[1] = 1u;
    _DrawArgs3[2] = 0u;
    _DrawArgs3[3] = 0u;
}

[numthreads(1, 1, 1)]
void CSPrepareIndexedDrawQueue(uint3 id : SV_DispatchThreadID)
{
    if (id.x != 0u)
        return;

    uint visibleClusters = _VisibleDrawCountArgs[0];
    uint slots = max(1u, _CompactedClusterTriangleSlots);
    uint remaining = visibleClusters > _IndexedDrawClusterOffset
        ? visibleClusters - _IndexedDrawClusterOffset
        : 0u;
    // Every visible cluster is dispatched. Packet admission is based on its
    // exact triangle count in the build kernel; whole clusters that do not fit
    // are appended to the explicit overflow queue.
    uint indexedClusters = min(remaining, _IndexedDrawCapacityClusters);
    _IndexedCameraBaseCount[0] = indexedClusters;
    _IndexedDrawArgs[0] = 0u;
    _IndexedDrawArgs[1] = 1u;
    _IndexedDrawArgs[2] = 0u;
    _IndexedDrawArgs[3] = 0u;
    // The final recorded chunk owns a procedural tail. Its shader uses an
    // explicit compact-cluster offset, so correctness does not depend on Unity's
    // startVertex -> SV_VertexID behaviour.
    uint fallbackClusters = _IndexedAllowProceduralFallback != 0u
        ? remaining - indexedClusters
        : 0u;
    _IndexedFallbackDrawArgs[0] = fallbackClusters * slots * 3u;
    _IndexedFallbackDrawArgs[1] = 1u;
    _IndexedFallbackDrawArgs[2] = 0u;
    _IndexedFallbackDrawArgs[3] = 0u;
    uint groupsX = min(1024u, indexedClusters);
    _IndexedBuildDispatchArgs[0] = groupsX;
    _IndexedBuildDispatchArgs[1] = groupsX > 0u
        ? (indexedClusters + groupsX - 1u) / groupsX
        : 0u;
    _IndexedBuildDispatchArgs[2] = 1u;
    _IndexedBuildDispatchArgs[3] = 0u;
}

float HybridApplyDeterministicDepthTieBreak(float depth, uint triangleId)
{
    int subMesh = max(0, _HybridTriangleSubMesh[triangleId]);
    uint triangleRank = triangleId;
    triangleRank = (triangleRank ^ 61u) ^ (triangleRank >> 16u);
    triangleRank *= 9u;
    triangleRank ^= triangleRank >> 4u;
    triangleRank *= 0x27d4eb2du;
    triangleRank ^= triangleRank >> 15u;
    triangleRank &= 1023u;
    float materialRank = ((float)subMesh +
        ((float)triangleRank + 0.5) / 1024.0) /
        (float)(max(1u, _HybridMaxSubMeshCount) + 1u);
    const float kTieBreakDepth = 1.0e-5;
    return saturate(_HybridReversedZ != 0u
        ? depth + kTieBreakDepth * materialRank
        : depth - kTieBreakDepth * materialRank);
}

[numthreads(1, 1, 1)]
void CSPrepareRuntimeTelemetry(uint3 id : SV_DispatchThreadID)
{
    uint cameraCount = _TelemetryCameraCountArgs[0];
    uint shadow0 = _TelemetryShadowCountArgs0[0];
    uint shadow1 = _TelemetryShadowCountArgs1[0];
    uint shadow2 = _TelemetryShadowCountArgs2[0];
    uint shadow3 = _TelemetryShadowCountArgs3[0];
    uint maximum = max(cameraCount, max(max(shadow0, shadow1), max(shadow2, shadow3)));

    _RuntimeTelemetryStats[0] = cameraCount;
    _RuntimeTelemetryStats[1] = 0u;
    _RuntimeTelemetryStats[2] = _TelemetryHardwareCountArgs[0];
    _RuntimeTelemetryStats[3] = _TelemetrySoftwareCountArgs[0];
    _RuntimeTelemetryStats[4] = shadow0;
    _RuntimeTelemetryStats[5] = 0u;
    _RuntimeTelemetryStats[6] = shadow1;
    _RuntimeTelemetryStats[7] = 0u;
    _RuntimeTelemetryStats[8] = shadow2;
    _RuntimeTelemetryStats[9] = 0u;
    _RuntimeTelemetryStats[10] = shadow3;
    _RuntimeTelemetryStats[11] = 0u;
    _RuntimeTelemetryDispatchArgs[0] = max(1u, (maximum + 63u) / 64u);
    _RuntimeTelemetryDispatchArgs[1] = 1u;
    _RuntimeTelemetryDispatchArgs[2] = 1u;
}

[numthreads(64, 1, 1)]
void CSAccumulateRuntimeTelemetry(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    if (index < _TelemetryCameraCountArgs[0])
        InterlockedAdd(_RuntimeTelemetryStats[1], _TelemetryCameraClusters[index].y);
    if (index < _TelemetryShadowCountArgs0[0])
        InterlockedAdd(_RuntimeTelemetryStats[5], _TelemetryShadowClusters0[index].y);
    if (index < _TelemetryShadowCountArgs1[0])
        InterlockedAdd(_RuntimeTelemetryStats[7], _TelemetryShadowClusters1[index].y);
    if (index < _TelemetryShadowCountArgs2[0])
        InterlockedAdd(_RuntimeTelemetryStats[9], _TelemetryShadowClusters2[index].y);
    if (index < _TelemetryShadowCountArgs3[0])
        InterlockedAdd(_RuntimeTelemetryStats[11], _TelemetryShadowClusters3[index].y);
}

// The HZB depth pass has already built packets for the Pass1 queue. Pass2 only
// appends recovered clusters to that same GPU queue, so Formal raster can keep
// the existing packets/DrawArgs and build the newly appended tail.
[numthreads(1, 1, 1)]
void CSPrepareIndexedDrawQueueAppend(uint3 id : SV_DispatchThreadID)
{
    if (id.x != 0u)
        return;

    uint visibleClusters = _VisibleDrawCountArgs[0];
    uint baseClusters = min(_IndexedCameraBaseCountRead[0], _IndexedDrawCapacityClusters);
    uint remaining = visibleClusters > baseClusters
        ? visibleClusters - baseClusters
        : 0u;
    uint capacity = _IndexedDrawCapacityClusters - baseClusters;
    uint appendedClusters = min(remaining, capacity);
    uint slots = max(1u, _CompactedClusterTriangleSlots);
    uint basePacket = _IndexedDrawArgsRead[0] / 3u;
    _IndexedCameraPacketSlice[0] = basePacket;
    _IndexedCameraPacketSlice[1] = baseClusters;
    _IndexedCameraPacketSlice[2] = appendedClusters;
    _IndexedCameraPacketSlice[3] = 0u;
    _IndexedAppendDrawArgs[0] = 0u;
    _IndexedAppendDrawArgs[1] = 1u;
    _IndexedAppendDrawArgs[2] = 0u;
    _IndexedAppendDrawArgs[3] = 0u;
    uint fallbackClusters = _IndexedAllowProceduralFallback != 0u
        ? remaining - appendedClusters
        : 0u;
    _IndexedFallbackDrawArgs[0] = fallbackClusters * slots * 3u;
    _IndexedFallbackDrawArgs[1] = 1u;
    _IndexedFallbackDrawArgs[2] = 0u;
    _IndexedFallbackDrawArgs[3] = 0u;

    uint groupsX = min(1024u, appendedClusters);
    _IndexedBuildDispatchArgs[0] = groupsX;
    _IndexedBuildDispatchArgs[1] = groupsX > 0u
        ? (appendedClusters + groupsX - 1u) / groupsX
        : 0u;
    _IndexedBuildDispatchArgs[2] = 1u;
    _IndexedBuildDispatchArgs[3] = 0u;
}

uint IndexedShadowVisibleCount(uint cascadeIndex)
{
    if (cascadeIndex == 0u)
        return _IndexedShadowVisibleDrawCountArgs0[0];
    if (cascadeIndex == 1u)
        return _IndexedShadowVisibleDrawCountArgs1[0];
    if (cascadeIndex == 2u)
        return _IndexedShadowVisibleDrawCountArgs2[0];
    return _IndexedShadowVisibleDrawCountArgs3[0];
}

void ResolveIndexedShadowSlice(
    uint cascadeIndex,
    out uint baseCluster,
    out uint capacityClusters)
{
    baseCluster = 0u;
    capacityClusters = 0u;
    // The native shadow graph records build(cascade N) immediately before
    // draw(cascade N).  In that ordering every cascade owns the whole scratch
    // allocation and the next cascade can safely overwrite it after raster.
    if (_IndexedShadowReuseScratch != 0u)
    {
        capacityClusters = min(
            IndexedShadowVisibleCount(cascadeIndex),
            _IndexedDrawTotalCapacityClusters);
        return;
    }

    uint remaining = _IndexedDrawTotalCapacityClusters;
    [unroll]
    for (uint prior = 0u; prior < 4u; prior++)
    {
        if (prior >= cascadeIndex)
            break;
        uint admitted = min(IndexedShadowVisibleCount(prior), remaining);
        baseCluster += admitted;
        remaining -= admitted;
    }
    capacityClusters = min(IndexedShadowVisibleCount(cascadeIndex), remaining);
}

[numthreads(1, 1, 1)]
void CSPrepareIndexedShadowDrawQueue(uint3 id : SV_DispatchThreadID)
{
    if (id.x != 0u)
        return;

    uint cascadeIndex = min(_IndexedShadowCascadeIndex, 3u);
    uint baseCluster = 0u;
    uint indexedClusters = 0u;
    ResolveIndexedShadowSlice(cascadeIndex, baseCluster, indexedClusters);
    uint visibleClusters = IndexedShadowVisibleCount(cascadeIndex);
    uint slots = max(1u, _CompactedClusterTriangleSlots);

    uint packetBase = baseCluster * slots;
    _IndexedShadowSliceData[cascadeIndex] = uint4(packetBase, indexedClusters, 0u, 0u);
    // The draw is procedural and begins at vertex zero. The shader adds the
    // packet slice base explicitly, avoiding backend-specific startVertex
    // semantics while four cascade slices coexist.
    _IndexedDrawArgs[0] = 0u;
    _IndexedDrawArgs[1] = 1u;
    _IndexedDrawArgs[2] = 0u;
    _IndexedDrawArgs[3] = 0u;
    uint fallbackClusters = visibleClusters - indexedClusters;
    _IndexedFallbackDrawArgs[0] = fallbackClusters * slots * 3u;
    _IndexedFallbackDrawArgs[1] = 1u;
    _IndexedFallbackDrawArgs[2] = 0u;
    _IndexedFallbackDrawArgs[3] = 0u;

    uint groupsX = min(1024u, indexedClusters);
    _IndexedShadowBuildDispatchArgs[0] = groupsX;
    _IndexedShadowBuildDispatchArgs[1] = groupsX > 0u
        ? (indexedClusters + groupsX - 1u) / groupsX
        : 0u;
    _IndexedShadowBuildDispatchArgs[2] = 1u;
    _IndexedShadowBuildDispatchArgs[3] = 0u;
}

void BuildTrianglePacketCluster(
    uint localClusterIndex,
    uint capacityClusters,
    uint clusterOffset,
    uint triangleInCluster)
{
    uint visibleClusters = _VisibleDrawCountArgs[0];
    if (localClusterIndex >= capacityClusters)
        return;
    uint clusterIndex = clusterOffset + localClusterIndex;
    if (clusterIndex >= visibleClusters)
        return;

    uint slots = max(1u, _CompactedClusterTriangleSlots);
    if (triangleInCluster >= slots)
        return;

    uint3 draw = _CompactedDrawClusters[clusterIndex];
    uint firstTriangle = draw.x;
    uint triangleCount = draw.y;
    uint instanceId = draw.z;
    if (triangleInCluster >= triangleCount)
        return;

    uint outputPacket = IndexedGroupOutputBasePacket + triangleInCluster;
    uint packedPacket = ((firstTriangle + triangleInCluster) << _IndexedPacketInstanceBits) |
                        (instanceId & _IndexedPacketInstanceMask);
    _IndexedTrianglePackets[outputPacket] = packedPacket;
}

bool ReserveIndexedCameraPackets(
    uint triangleCount,
    uint basePacket,
    out uint outputBasePacket)
{
    outputBasePacket = 0u;
    if (triangleCount == 0u || basePacket >= _IndexedTrianglePacketCapacity ||
        triangleCount > _IndexedTrianglePacketCapacity - basePacket)
        return false;

    uint reservedPackets;
    InterlockedAdd(_IndexedBuildDispatchArgs[3], triangleCount, reservedPackets);
    if (reservedPackets > _IndexedTrianglePacketCapacity - basePacket - triangleCount)
        return false;

    outputBasePacket = basePacket + reservedPackets;
    InterlockedAdd(_IndexedDrawArgs[0], triangleCount * 3u);
    return true;
}

bool ReserveIndexedAppendPackets(
    uint triangleCount,
    uint basePacket,
    out uint outputBasePacket)
{
    outputBasePacket = 0u;
    if (triangleCount == 0u || basePacket >= _IndexedTrianglePacketCapacity ||
        triangleCount > _IndexedTrianglePacketCapacity - basePacket)
        return false;

    uint reservedPackets;
    InterlockedAdd(_IndexedBuildDispatchArgs[3], triangleCount, reservedPackets);
    if (reservedPackets > _IndexedTrianglePacketCapacity - basePacket - triangleCount)
        return false;

    outputBasePacket = basePacket + reservedPackets;
    InterlockedAdd(_IndexedAppendDrawArgs[0], triangleCount * 3u);
    return true;
}

bool ReserveIndexedShadowPackets(
    uint triangleCount,
    uint basePacket,
    out uint outputBasePacket)
{
    outputBasePacket = 0u;
    if (triangleCount == 0u || basePacket >= _IndexedTrianglePacketCapacity ||
        triangleCount > _IndexedTrianglePacketCapacity - basePacket)
        return false;

    uint reservedPackets;
    InterlockedAdd(_IndexedShadowBuildDispatchArgs[3], triangleCount, reservedPackets);
    if (reservedPackets > _IndexedTrianglePacketCapacity - basePacket - triangleCount)
        return false;

    outputBasePacket = basePacket + reservedPackets;
    InterlockedAdd(_IndexedDrawArgs[0], triangleCount * 3u);
    return true;
}

[numthreads(128, 1, 1)]
void CSBuildIndexedDrawQueue(
    uint3 groupId : SV_GroupID,
    uint3 groupThreadId : SV_GroupThreadID)
{
    uint localClusterIndex = groupId.x + groupId.y * max(1u, _IndexedDispatchGroupsX);
    if (groupThreadId.x == 0u)
    {
        IndexedGroupOutputBasePacket = 0u;
        IndexedGroupTriangleCount = 0u;
        IndexedGroupAdmitted = 0u;
        uint visibleClusters = _VisibleDrawCountArgs[0];
        uint clusterIndex = _IndexedDrawClusterOffset + localClusterIndex;
        if (localClusterIndex < _IndexedDrawCapacityClusters &&
            clusterIndex < visibleClusters)
        {
            uint3 draw = _CompactedDrawClusters[clusterIndex];
            IndexedGroupTriangleCount = min(draw.y, max(1u, _CompactedClusterTriangleSlots));
            if (ReserveIndexedCameraPackets(
                    IndexedGroupTriangleCount,
                    0u,
                    IndexedGroupOutputBasePacket))
            {
                IndexedGroupAdmitted = 1u;
            }
            else
            {
                _IndexedOverflowClusterIndices.Append(clusterIndex);
            }
        }
    }
    GroupMemoryBarrierWithGroupSync();
    if (IndexedGroupAdmitted == 0u || groupThreadId.x >= IndexedGroupTriangleCount)
        return;
    BuildTrianglePacketCluster(
        localClusterIndex,
        _IndexedDrawCapacityClusters,
        _IndexedDrawClusterOffset,
        groupThreadId.x);
}

[numthreads(128, 1, 1)]
void CSBuildIndexedDrawQueueAppend(
    uint3 groupId : SV_GroupID,
    uint3 groupThreadId : SV_GroupThreadID)
{
    uint localClusterIndex = groupId.x + groupId.y * max(1u, _IndexedDispatchGroupsX);
    uint baseClusters = min(
        _IndexedCameraBaseCountRead[0],
        _IndexedDrawCapacityClusters);
    uint capacityClusters = _IndexedDrawCapacityClusters - baseClusters;
    if (groupThreadId.x == 0u)
    {
        IndexedGroupOutputBasePacket = 0u;
        IndexedGroupTriangleCount = 0u;
        IndexedGroupAdmitted = 0u;
        uint visibleClusters = _VisibleDrawCountArgs[0];
        uint clusterIndex = baseClusters + localClusterIndex;
        if (localClusterIndex < capacityClusters && clusterIndex < visibleClusters)
        {
            uint3 draw = _CompactedDrawClusters[clusterIndex];
            IndexedGroupTriangleCount = min(draw.y, max(1u, _CompactedClusterTriangleSlots));
            uint basePacket = _IndexedCameraPacketSliceRead[0];
            if (ReserveIndexedAppendPackets(
                    IndexedGroupTriangleCount,
                    basePacket,
                    IndexedGroupOutputBasePacket))
            {
                IndexedGroupAdmitted = 1u;
            }
            else
            {
                _IndexedOverflowClusterIndices.Append(clusterIndex);
            }
        }
    }
    GroupMemoryBarrierWithGroupSync();
    if (IndexedGroupAdmitted == 0u || groupThreadId.x >= IndexedGroupTriangleCount)
        return;
    BuildTrianglePacketCluster(
        localClusterIndex,
        capacityClusters,
        baseClusters,
        groupThreadId.x);
}

[numthreads(128, 1, 1)]
void CSBuildIndexedShadowDrawQueue(
    uint3 groupId : SV_GroupID,
    uint3 groupThreadId : SV_GroupThreadID)
{
    uint cascadeIndex = min(_IndexedShadowCascadeIndex, 3u);
    uint4 slice = _IndexedShadowSliceData[cascadeIndex];
    uint dispatchGroupsX = min(1024u, slice.y);
    uint localClusterIndex = groupId.x + groupId.y * max(1u, dispatchGroupsX);
    uint visibleClusters = _VisibleDrawCountArgs[0];
    uint slots = max(1u, _CompactedClusterTriangleSlots);

    if (groupThreadId.x == 0u)
    {
        IndexedShadowGroupOutputBasePacket = 0u;
        IndexedShadowGroupTriangleCount = 0u;
        IndexedGroupAdmitted = 0u;
        if (localClusterIndex < slice.y &&
            localClusterIndex < visibleClusters)
        {
            uint3 draw = _CompactedDrawClusters[localClusterIndex];
            IndexedShadowGroupTriangleCount = min(draw.y, slots);
            if (ReserveIndexedShadowPackets(
                    IndexedShadowGroupTriangleCount,
                    slice.x,
                    IndexedShadowGroupOutputBasePacket))
            {
                IndexedGroupAdmitted = 1u;
            }
            else
            {
                _IndexedOverflowClusterIndices.Append(localClusterIndex);
            }
        }
    }
    GroupMemoryBarrierWithGroupSync();

    uint triangleInCluster = groupThreadId.x;
    if (IndexedGroupAdmitted == 0u || triangleInCluster >= IndexedShadowGroupTriangleCount)
        return;
    uint3 draw = _CompactedDrawClusters[localClusterIndex];
    uint packedPacket = ((draw.x + triangleInCluster) << _IndexedPacketInstanceBits) |
                        (draw.z & _IndexedPacketInstanceMask);
    _IndexedTrianglePackets[IndexedShadowGroupOutputBasePacket + triangleInCluster] = packedPacket;
}

[numthreads(256, 1, 1)]
void CSClearHybridTileHeads(uint3 id : SV_DispatchThreadID)
{
    if (id.x < _HybridTileCount)
        _HybridSoftwareTileHeads[id.x] = HYBRID_INVALID_NODE;
}

[numthreads(1, 1, 1)]
void CSClearHybridTileWork(uint3 id : SV_DispatchThreadID)
{
    _HybridSoftwareTileNodeCounter[0] = 0u;
    _HybridSoftwareTileNodeCounter[1] = 0u;
    _HybridSoftwareTileNodeCounter[2] = 0u;
    _HybridSoftwareTileNodeCounter[3] = 0u;
}

[numthreads(128, 1, 1)]
void CSBuildHybridTileWork(
    uint3 groupId : SV_GroupID,
    uint3 groupThreadId : SV_GroupThreadID)
{
    uint softwareClusterIndex = groupId.x + groupId.y * max(1u, _HybridDispatchGroupsX);
    if (softwareClusterIndex >= _HybridSoftwareCountArgs[0])
        return;

    if (groupThreadId.x == 0u)
        _HybridSoftwareFallbackFlags[softwareClusterIndex] = 0u;
    GroupMemoryBarrierWithGroupSync();
    HybridAppendTriangleTileWork(softwareClusterIndex, groupThreadId.x);
}

[numthreads(16, 16, 1)]
void CSSoftwareRasterTiles(
    uint3 groupId : SV_GroupID,
    uint3 groupThreadId : SV_GroupThreadID,
    uint groupThreadIndex : SV_GroupIndex)
{
    uint compactTileIndex = groupId.x + groupId.y * max(1u, _HybridDispatchGroupsX);
    if (compactTileIndex >= _HybridSoftwareTileCountArgs[0])
        return;

    if (_HybridTelemetryEnabled != 0u && groupThreadIndex == 0u)
        InterlockedAdd(_HybridSoftwareTileNodeCounter[3], 1u);

    uint tileIndex = _HybridSoftwareTileListRead[compactTileIndex];
    uint2 tile = uint2(tileIndex % _HybridTileCountX, tileIndex / _HybridTileCountX);
    uint2 pixel = tile * max(1u, _HybridTileSize) + groupThreadId.xy;
    bool validPixel = pixel.x < _HybridScreenWidth && pixel.y < _HybridScreenHeight;
    int2 sample = int2((pixel.x << 8u) + 128u, (pixel.y << 8u) + 128u);
    uint bestDepth = _HybridReversedZ != 0u ? 0u : asuint(1.0);
    uint bestWinner = 0u;

    if (groupThreadIndex == 0u)
        HybridTileCursor = _HybridSoftwareTileHeads[tileIndex];
    GroupMemoryBarrierWithGroupSync();

    while (true)
    {
        if (groupThreadIndex == 0u)
        {
            uint cursor = HybridTileCursor;
            uint count = 0u;
            while (cursor != HYBRID_INVALID_NODE && count < HYBRID_TILE_BATCH_SIZE)
            {
                uint2 node = _HybridSoftwareTileNodes[cursor];
                HybridTileBatchRefs[count++] = node.x;
                cursor = node.y;
            }
            HybridTileCursor = cursor;
            HybridTileBatchCount = count;
        }
        GroupMemoryBarrierWithGroupSync();

        uint batchCount = HybridTileBatchCount;
        if (batchCount == 0u)
            break;

        if (groupThreadIndex < batchCount)
        {
            uint packedRef = HybridTileBatchRefs[groupThreadIndex];
            uint softwareClusterIndex = packedRef >> 7u;
            uint triangleInCluster = packedRef & 127u;
            int area = 0;
            int2 f0 = 0, f1 = 0, f2 = 0;
            float z0 = 0.0, z1 = 0.0, z2 = 0.0;
            if (_HybridSoftwareFallbackFlags[softwareClusterIndex] == 0u)
            {
                uint3 draw = _HybridSoftwareClustersRead[softwareClusterIndex];
                if (triangleInCluster < draw.y)
                {
                    uint triangleId = draw.x + triangleInCluster;
                    float4 p0, p1, p2;
                    if (HybridTransformVertex(triangleId, 0u, draw.z, p0) &&
                        HybridTransformVertex(triangleId, 1u, draw.z, p1) &&
                        HybridTransformVertex(triangleId, 2u, draw.z, p2) &&
                        !HybridTriangleNeedsClipping(p0, p1, p2))
                    {
                        f0 = (int2)round(HybridClipToPixel(p0) * 256.0);
                        f1 = (int2)round(HybridClipToPixel(p1) * 256.0);
                        f2 = (int2)round(HybridClipToPixel(p2) * 256.0);
                        area = HybridEdge(f0, f1, f2);
                        z0 = HybridApplyDeterministicDepthTieBreak(
                            saturate(p0.z / p0.w), triangleId);
                        z1 = HybridApplyDeterministicDepthTieBreak(
                            saturate(p1.z / p1.w), triangleId);
                        z2 = HybridApplyDeterministicDepthTieBreak(
                            saturate(p2.z / p2.w), triangleId);
                        // Normalize either source winding to the positive edge
                        // convention consumed below. This is equivalent to the
                        // Cull Off hardware raster contract and naturally
                        // handles negative-scale instances without a separate
                        // determinant branch.
                        if (area < 0)
                        {
                            int2 swapF = f1;
                            f1 = f2;
                            f2 = swapF;
                            float swapZ = z1;
                            z1 = z2;
                            z2 = swapZ;
                            area = -area;
                        }
                    }
                }
            }
            HybridTileF0[groupThreadIndex] = f0;
            HybridTileF1[groupThreadIndex] = f1;
            HybridTileF2[groupThreadIndex] = f2;
            HybridTileZ0[groupThreadIndex] = z0;
            HybridTileZ1[groupThreadIndex] = z1;
            HybridTileZ2[groupThreadIndex] = z2;
            HybridTileArea[groupThreadIndex] = area;
        }
        GroupMemoryBarrierWithGroupSync();

        if (validPixel)
        {
            for (uint i = 0u; i < batchCount; ++i)
            {
                int area = HybridTileArea[i];
                if (area <= 0)
                    continue;
                int e0 = HybridEdge(HybridTileF1[i], HybridTileF2[i], sample);
                int e1 = HybridEdge(HybridTileF2[i], HybridTileF0[i], sample);
                int e2 = HybridEdge(HybridTileF0[i], HybridTileF1[i], sample);
                if (e0 < 0 || e1 < 0 || e2 < 0)
                    continue;

                float depth = saturate(
                    ((float)e0 * HybridTileZ0[i] +
                     (float)e1 * HybridTileZ1[i] +
                     (float)e2 * HybridTileZ2[i]) / (float)area);
                uint depthBits = asuint(depth);
                uint winner = HybridTileBatchRefs[i] + 1u;
                bool closer = _HybridReversedZ != 0u
                    ? depthBits > bestDepth
                    : depthBits < bestDepth;
                if (closer || (depthBits == bestDepth && winner > bestWinner))
                {
                    bestDepth = depthBits;
                    bestWinner = winner;
                }
            }
        }
        GroupMemoryBarrierWithGroupSync();
    }

    if (validPixel)
    {
        _HybridSoftwareDepth[pixel] = bestDepth;
        if (_HybridDepthOnly == 0u)
            _HybridSoftwareWinner[pixel] = bestWinner;
        if (_HybridTelemetryEnabled != 0u && bestWinner != 0u)
        {
            InterlockedAdd(_HybridSoftwareTileNodeCounter[1], 1u);
            InterlockedMax(_HybridSoftwareTileNodeCounter[2], bestWinner);
        }
    }
}

[numthreads(1, 1, 1)]
void CSCaptureHybridView(uint3 id : SV_DispatchThreadID)
{
    _HybridViewConstantsWrite[0] = GetWorldToHClipMatrix();
}

[numthreads(1, 1, 1)]
void CSPrepareHybridDispatch(uint3 id : SV_DispatchThreadID)
{
    uint count = _HybridPrepareCountArgs[0];
    uint groupsX = min(count, max(1u, _HybridDispatchGroupsX));
    uint groupsY = count > 0u
        ? (count + max(1u, _HybridDispatchGroupsX) - 1u) / max(1u, _HybridDispatchGroupsX)
        : 1u;
    _HybridDispatchArgs[0] = groupsX;
    _HybridDispatchArgs[1] = groupsY;
    _HybridDispatchArgs[2] = 1u;
    _HybridDispatchArgs[3] = 0u;
}

[numthreads(1, 1, 1)]
void CSClassifyHybridClusters(
    uint3 groupId : SV_GroupID)
{
    uint visibleCount = _HybridInputCountArgs[0];
    uint visibleIndex = groupId.x + groupId.y * max(1u, _HybridDispatchGroupsX);
    if (visibleIndex >= visibleCount)
        return;

    uint3 draw = _HybridInputClusters[visibleIndex];
    // The software winner payload reserves seven bits for triangle-in-cluster.
    bool software = draw.y <= 128u && HybridClusterFitsSoftware(draw);
    if (software)
        _HybridSoftwareClusters.Append(draw);
    else
        _HybridHardwareClusters.Append(draw);
}
