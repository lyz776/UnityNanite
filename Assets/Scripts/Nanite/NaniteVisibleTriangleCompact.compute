// Indexed cluster raster keeps the current visible-cluster ABI, but expands the
// selected clusters into a transient hardware index buffer.  The encoded index
// is instance * geometryVertexCount + geometryVertex, so the VS can recover both
// values while the fixed-function post-transform cache reuses shared vertices.
StructuredBuffer<int> _Indices;
StructuredBuffer<uint3> _CompactedDrawClusters;
struct NaniteGpuResidentPageEntry
{
    uint vertexBase;
    uint indexBase;
    uint vertexCount;
    uint indexCount;
    uint flags;
    uint generation;
    uint reserved0;
    uint reserved1;
};
struct NaniteResidentVertex
{
    float3 positionOS;
    float2 uv;
    float3 normalOS;
    float4 tangentOS;
};
StructuredBuffer<uint2> _TrianglePageRefs;
StructuredBuffer<NaniteGpuResidentPageEntry> _NaniteResidentPageTable;
StructuredBuffer<NaniteResidentVertex> _NaniteResidentVertices;
StructuredBuffer<uint> _NaniteResidentIndices;
// Exact procedural packet ABI: one 4-byte record per admitted triangle.
// This replaces the old 3x uint index stream + uint primitive-id stream.
// Raster expands the three corners from SV_VertexID and decodes geometry only
// when the fixed-function pipeline actually consumes the triangle.
RWStructuredBuffer<uint> _IndexedTrianglePackets;   // triangleId << instanceBits | instanceId
RWStructuredBuffer<uint> _IndexedDrawArgs;          // 4 uint procedural arguments
StructuredBuffer<uint> _IndexedDrawArgsRead;
RWStructuredBuffer<uint> _IndexedAppendDrawArgs;    // Pass2-only procedural arguments
RWStructuredBuffer<uint> _IndexedFallbackDrawArgs;  // 4 uint procedural arguments
AppendStructuredBuffer<uint> _IndexedOverflowClusterIndices;
RWStructuredBuffer<uint> _IndexedBuildDispatchArgs;
RWStructuredBuffer<uint> _IndexedCameraBaseCount;
StructuredBuffer<uint> _IndexedCameraBaseCountRead;
RWStructuredBuffer<uint> _IndexedCameraPacketSlice; // basePacket, baseClusters, appendClusters, reserved
StructuredBuffer<uint> _IndexedCameraPacketSliceRead;
uint _UsePackedPageGeometry;
uint _IndexedDrawBaseIndex;
uint _IndexedDrawCapacityClusters;
uint _IndexedDrawClusterOffset;
uint _IndexedAllowProceduralFallback;
uint _IndexedDispatchGroupsX;
uint _IndexedPacketInstanceBits;
uint _IndexedPacketInstanceMask;
uint _IndexedTrianglePacketCapacity;
StructuredBuffer<uint> _IndexedShadowVisibleDrawCountArgs0;
StructuredBuffer<uint> _IndexedShadowVisibleDrawCountArgs1;
StructuredBuffer<uint> _IndexedShadowVisibleDrawCountArgs2;
StructuredBuffer<uint> _IndexedShadowVisibleDrawCountArgs3;
RWStructuredBuffer<uint4> _IndexedShadowSliceData;  // packetBase, admittedClusters, reserved, reserved
RWStructuredBuffer<uint> _IndexedShadowBuildDispatchArgs;
uint _IndexedShadowCascadeIndex;
uint _IndexedDrawTotalCapacityClusters;
uint _IndexedShadowReuseScratch;
groupshared uint IndexedShadowGroupOutputBasePacket;
