// Nyx-style persistent task queue. State and task payload share one raw UAV so the
// traversal kernel stays within the eight-UAV Windows compatibility limit.
// reservedWrite is allocation only; consumers are gated by the contiguous
// publishedWrite frontier. This prevents unpublished producers from parking all
// persistent workers on incomplete slots.
// state: read, reservedWrite, publishedWrite, activeWorkers, done, overflow,
//        processedTaskCount, selectedRefCount (eight uints)
// task: uint3(instance, hierarchyRef, viewMask) + uint readyEpoch (16 bytes)
globallycoherent RWByteAddressBuffer _HierarchyPersistentWork;
