// CullPassMode:
// 0 = legacy full frustum/LOD cut with optional HZB
// 1 = main pass: previous-frame HZB, rejected clusters become post-pass candidates
// 2 = post pass: current-frame HZB retests candidates and appends disocclusions
#define CULL_MODE_LEGACY 0
#define CULL_MODE_PASS1 1
#define CULL_MODE_PASS2 2

struct GpuPartData
{
    float4 selfSphere;
    float4 parentSphere;
    float maxParentError;
    int clusterStart;
    int clusterCount;
    int instanceIndex;
    uint lodFlags;
    uint consumerGroupIndex;
};

struct GpuClusterData
{
    float4 geometrySphere;
    float4 selfSphere;
    float4 parentSphere;
    float selfError;
    float parentError;
    int partIndex;
    int pageIndex;
    int clusterIndex;
    int instanceIndex;
    uint lodFlags;
    uint refinementGroupIndex;
    uint packedCone;
    float longestEdge;
};

#define LOD_FLAG_TERMINAL_DISAPPEAR 1u
#define TERMINAL_DISAPPEAR_PIXELS 0.5
#define TERMINAL_DISAPPEAR_SHADOW_TEXELS 1.0
// A one-texel geometric error target over-shades CSMs: PCF/filtering cannot
// preserve that detail and four cascades multiply it. Keep primary visibility
// at the authored pixel threshold, but use the same conservative two-texel
// shadow target as a raster-specific LOD bias. This is independent per cascade
// because ShadowProjectionScale already contains that cascade's texel density.
float _ShadowLodMinTexels;

StructuredBuffer<GpuPartData> _Parts;
StructuredBuffer<GpuClusterData> _Clusters;
// GPU Scene indirection: immutable Part/Cluster data is stored once per unique mesh.
// Each virtual reference is only uint4(instance, geometryIndex, relation/range).
StructuredBuffer<uint4> _VirtualParts;
StructuredBuffer<uint4> _VirtualClusters;
// One immutable Page-table address per unique geometry cluster. Production
// queues carry (instance, geometryCluster), so residency must not recover the
// Page through an instance-expanded virtual-cluster record.
StructuredBuffer<uint> _GeometryClusterPageIndex;
// Part cull writes this mask while cluster cull only reads it. Splitting the
// declarations removes one otherwise unnecessary UAV from cluster kernels.
StructuredBuffer<uint> _PartVisible;
RWStructuredBuffer<uint> _PartVisibleWrite;
// Production traversal carries (instance, immutable geometry Part). This is
// the same indirection used by NVIDIA's render-cluster list and avoids a full
// instance x Part expansion in the hot queue.
AppendStructuredBuffer<uint2> _VisiblePartsOut;
StructuredBuffer<uint2> _VisiblePartsIn;
// The finalize kernel writes these args, while indirect cluster cull only reads
// them. Keeping both views separate prevents the read-only cluster kernel from
// consuming an unnecessary UAV slot on D3D12 (Windows Player supports eight).
StructuredBuffer<uint> _VisiblePartDispatchArgs;
RWStructuredBuffer<uint> _VisiblePartDispatchArgsWrite;
AppendStructuredBuffer<uint> _VisibleInstancesOut;
StructuredBuffer<uint> _VisibleInstancesIn;
StructuredBuffer<uint> _VisibleInstancePartDispatchArgs;
