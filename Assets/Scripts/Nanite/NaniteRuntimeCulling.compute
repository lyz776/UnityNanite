#pragma kernel CSPartCull
#pragma kernel CSClusterCull
#pragma kernel CSClusterCullByPart
#pragma kernel CSFinalizeVisiblePartDispatch
#pragma kernel CSClusterCullVisibleParts
#pragma kernel CSInstanceCull
#pragma kernel CSPartCullVisibleInstances
#pragma kernel CSClearClusterVisible
#pragma kernel CSClearSecondPassCandidates
#pragma kernel CSCopyUintBuffer
#pragma kernel CSClearCullStats
#pragma kernel CSOrMasksToVisible
#pragma kernel CSShadowCullMultiCascadeByPart

// CullPassMode:
// 0 = legacy（全量 frustum+LOD，可选 HZB）
// 1 = Bevy Pass1：仅 prevVisible（无 HZB）；其余进 secondPassCandidates
// 2 = Bevy Pass2：仅 secondPassCandidates + HZB，追加写 visible
#define CULL_MODE_LEGACY 0
#define CULL_MODE_PASS1 1
#define CULL_MODE_PASS2 2

struct GpuPartData
{
    float4 selfSphere;
    float4 parentSphere;
    float maxParentError;
    int clusterStart;
    int clusterCount;
    int instanceIndex;
};

struct GpuClusterData
{
    float4 selfSphere;
    float4 parentSphere;
    float selfError;
    float parentError;
    int partIndex;
    int pageIndex;
    int clusterIndex;
    int instanceIndex;
};

StructuredBuffer<GpuPartData> _Parts;
StructuredBuffer<GpuClusterData> _Clusters;
// GPU Scene indirection: immutable Part/Cluster data is stored once per unique mesh.
// Each virtual reference is only uint4(instance, geometryIndex, relation/range).
StructuredBuffer<uint4> _VirtualParts;
StructuredBuffer<uint4> _VirtualClusters;
RWStructuredBuffer<uint> _PartVisible;
AppendStructuredBuffer<uint> _VisiblePartsOut;
StructuredBuffer<uint> _VisiblePartsIn;
RWStructuredBuffer<uint> _VisiblePartDispatchArgs;
AppendStructuredBuffer<uint> _VisibleInstancesOut;
StructuredBuffer<uint> _VisibleInstancesIn;
StructuredBuffer<uint> _VisibleInstancePartDispatchArgs;
AppendStructuredBuffer<uint3> _VisibleClusters;
AppendStructuredBuffer<uint3> _VisibleDrawClusters;
AppendStructuredBuffer<uint3> _ShadowVisibleDrawClusters0;
AppendStructuredBuffer<uint3> _ShadowVisibleDrawClusters1;
AppendStructuredBuffer<uint3> _ShadowVisibleDrawClusters2;
AppendStructuredBuffer<uint3> _ShadowVisibleDrawClusters3;
RWStructuredBuffer<uint> _ClusterVisible;
StructuredBuffer<uint> _ClusterSceneIndex;
StructuredBuffer<uint> _SceneClusterFirstTri;
StructuredBuffer<uint> _SceneClusterTriCount;
StructuredBuffer<uint> _PrevClusterVisible;
RWStructuredBuffer<uint> _SecondPassCandidates;
RWStructuredBuffer<uint> _Pass2Drawn;
StructuredBuffer<uint> _UintCopySrc;
RWStructuredBuffer<uint> _UintCopyDst;
RWStructuredBuffer<uint> _CullStats; // [0]=pass1Drawn [1]=pass2Candidates [2]=pass2Drawn
StructuredBuffer<uint> _Pass1Visible;
StructuredBuffer<uint> _OrMaskB;
Texture2D<float> _HizTexture;
SamplerState sampler_HizTexture;
StructuredBuffer<uint> _ClusterCandidates;
StructuredBuffer<uint> _PageResidency;
RWStructuredBuffer<uint> _PageRequests;

int _PartCount;
int _ClusterCount;
int _ClusterCandidateCount;
int _HizMipCount;
int _UseHzb;
int _ReversedZ;
int _UseClusterCandidates;
int _EnableVisibleAppend;
int _EnableVisibleDrawAppend;
int _EnableClusterVisibleWrite;
int _SceneClusterCount;
int _CullPassMode;
int _HasPrevVisible;
int _EnableCullStats;
int _UseGpuSceneRefs;
int _EnableVisiblePartQueue;
int _EnableVisibleInstanceQueue;
int _PageCount;
int _EnablePageRequests;
int _TrackPageUsage;

struct GpuInstanceData
{
    float4x4 localToWorld;
    float4 bounds;
    float maxScale;
    float lodErrorPixels;
    uint partOffset;
    uint partCount;
};

float4 _FrustumPlanes[6];
float4 _ShadowFrustumPlanes[24];
int _ShadowCascadeCount;
StructuredBuffer<GpuInstanceData> _Instances;
RWStructuredBuffer<uint> _InstanceVisible;

float4 _CameraPos;
float _ProjectionScale;
float _OrthographicLodScale;
float _ZNear;
float4x4 _WorldToClip;
float4 _ScreenSize;
float4 _ShadowProjectionScales;
int _InstanceCount;
int _UseInstanceCull;
int _UseOrthographicLod;

float4 TransformSphere(float4 localSphere, int instanceIndex)
{
    instanceIndex = clamp(instanceIndex, 0, max(_InstanceCount - 1, 0));
    GpuInstanceData instanceData = _Instances[instanceIndex];
    float4x4 localToWorld = instanceData.localToWorld;
    float maxScale = max(instanceData.maxScale, 1e-6);
    float3 center = mul(localToWorld, float4(localSphere.xyz, 1.0)).xyz;
    float radius = localSphere.w * maxScale;
    return float4(center, radius);
}

float LodErrorPixels(int instanceIndex)
{
    instanceIndex = clamp(instanceIndex, 0, max(_InstanceCount - 1, 0));
    return _Instances[instanceIndex].lodErrorPixels;
}

bool SphereVisible(float4 sphere)
{
    float3 center = sphere.xyz;
    float radius = sphere.w;
    [unroll]
    for (int i = 0; i < 6; i++)
    {
        float4 p = _FrustumPlanes[i];
        if (dot(p.xyz, center) + p.w < -radius)
            return false;
    }
    return true;
}

float ProjectedError(float error, float4 sphere, int instanceIndex)
{
    if (error >= 1e29)
        return 1e30;

    instanceIndex = clamp(instanceIndex, 0, max(_InstanceCount - 1, 0));
    float worldError = error * max(_Instances[instanceIndex].maxScale, 1e-6);
    if (_UseOrthographicLod != 0)
        return 2.0 * worldError * _OrthographicLodScale;

    // 屏幕空间投影「直径」像素（Bevy/Nanite 常用 diameter < ~1px 作为 imperceptible）。
    // 此前按半径估会偏保守 → 远处残留过多 cluster。
    float dist = max(length(sphere.xyz - _CameraPos.xyz) - sphere.w, _ZNear);
    return (2.0 * worldError * _ProjectionScale) / dist;
}

// Bevy: lod_error_is_imperceptible — 误差球屏幕投影 ≤ threshold。
bool LodErrorIsImperceptible(float error, float4 sphere, float thresholdPixels, int instanceIndex)
{
    return ProjectedError(error, sphere, instanceIndex) <= thresholdPixels;
}

// 互斥 DAG 切割（禁止宽重叠带）：同一表面只能选一层。
// 宽带（0.5×/1.5×）会在阈值附近同时选中父子 → 浮动碎块/叠画假破洞。
bool ShouldSelectClusterLod(
    float parentError,
    float selfError,
    float4 parentSphere,
    float4 selfSphere,
    float lodErrorPixels,
    int instanceIndex)
{
    return !LodErrorIsImperceptible(parentError, parentSphere, lodErrorPixels, instanceIndex) &&
           LodErrorIsImperceptible(selfError, selfSphere, lodErrorPixels, instanceIndex);
}

float ProjectedDiameterPixels(float4 sphere)
{
    if (_UseOrthographicLod != 0)
        return 2.0 * sphere.w * _OrthographicLodScale;
    float dist = max(length(sphere.xyz - _CameraPos.xyz) - sphere.w, _ZNear);
    return (2.0 * sphere.w * _ProjectionScale) / dist;
}

float2 ProjectToUv(float3 worldPos, out float depth01)
{
    float4 clip = mul(_WorldToClip, float4(worldPos, 1.0));
    float invW = 1.0 / max(abs(clip.w), 1e-6);
    float2 ndc = clip.xy * invW;
    float2 uv = ndc * 0.5 + 0.5;
    depth01 = saturate(clip.z * invW);
    return uv;
}

bool IsOccludedByHzb(float4 sphere)
{
    if (_UseHzb == 0 || _HizMipCount <= 0)
        return false;

    float3 toCenter = sphere.xyz - _CameraPos.xyz;
    float centerDist = length(toCenter);
    if (centerDist <= sphere.w * 1.25 + _ZNear)
        return false;

    float depth01;
    float2 uv = ProjectToUv(sphere.xyz, depth01);
    if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0)
        return false;

    float dist = max(centerDist, _ZNear);
    float radiusPixels = max(1.0, _ProjectionScale * sphere.w / dist);
    if (radiusPixels > 64.0)
        return false;

    int mip = (int)clamp(floor(log2(radiusPixels)), 0.0, (float)min(_HizMipCount - 1, 3));

    float hzbDepth = _HizTexture.SampleLevel(sampler_HizTexture, uv, mip);
    float depthBias = saturate(sphere.w / max(dist, 1e-5)) * 1.5 + 0.02;
    if (_ReversedZ != 0)
    {
        float closestDepth = saturate(depth01 + depthBias);
        return closestDepth < hzbDepth - 1e-3;
    }
    else
    {
        float closestDepth = saturate(depth01 - depthBias);
        return closestDepth > hzbDepth + 1e-3;
    }
}

[numthreads(64, 1, 1)]
void CSClearClusterVisible(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= (uint)_SceneClusterCount)
        return;
    _ClusterVisible[i] = 0u;
}

[numthreads(64, 1, 1)]
void CSClearSecondPassCandidates(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= (uint)_SceneClusterCount)
        return;
    _SecondPassCandidates[i] = 0u;
    _Pass2Drawn[i] = 0u;
}

[numthreads(64, 1, 1)]
void CSCopyUintBuffer(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= (uint)_SceneClusterCount)
        return;
    _UintCopyDst[i] = _UintCopySrc[i];
}

[numthreads(64, 1, 1)]
void CSOrMasksToVisible(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= (uint)_SceneClusterCount)
        return;
    _ClusterVisible[i] = (_Pass1Visible[i] | _OrMaskB[i]) != 0u ? 1u : 0u;
}

[numthreads(1, 1, 1)]
void CSClearCullStats(uint3 id : SV_DispatchThreadID)
{
    if (id.x == 0)
    {
        _CullStats[0] = 0u;
        _CullStats[1] = 0u;
        _CullStats[2] = 0u;
    }
}

[numthreads(64, 1, 1)]
void CSInstanceCull(uint3 id : SV_DispatchThreadID)
{
    uint instanceIndex = id.x;
    if (instanceIndex >= (uint)_InstanceCount)
        return;

    float4 sphere = TransformSphere(_Instances[instanceIndex].bounds, (int)instanceIndex);
    bool visible = SphereVisible(sphere);
    _InstanceVisible[instanceIndex] = visible ? 1u : 0u;
    if (visible && _EnableVisibleInstanceQueue != 0)
        _VisibleInstancesOut.Append(instanceIndex);
}

GpuPartData LoadPartData(uint workIndex, out int instanceIndex, out uint clusterStart, out uint clusterCount)
{
    if (_UseGpuSceneRefs != 0)
    {
        uint4 virtualPart = _VirtualParts[workIndex];
        instanceIndex = (int)virtualPart.x;
        clusterStart = virtualPart.z;
        clusterCount = virtualPart.w;
        return _Parts[virtualPart.y];
    }

    GpuPartData part = _Parts[workIndex];
    instanceIndex = part.instanceIndex;
    clusterStart = (uint)max(0, part.clusterStart);
    clusterCount = (uint)max(0, part.clusterCount);
    return part;
}

GpuClusterData LoadClusterData(
    uint workIndex,
    out int instanceIndex,
    out int partIndex,
    out uint globalPageIndex)
{
    if (_UseGpuSceneRefs != 0)
    {
        uint4 virtualCluster = _VirtualClusters[workIndex];
        instanceIndex = (int)virtualCluster.x;
        partIndex = (int)virtualCluster.z;
        globalPageIndex = virtualCluster.w;
        return _Clusters[virtualCluster.y];
    }

    GpuClusterData cluster = _Clusters[workIndex];
    instanceIndex = cluster.instanceIndex;
    partIndex = cluster.partIndex;
    globalPageIndex = (uint)max(0, cluster.pageIndex);
    return cluster;
}

void CullPart(uint i)
{
    if (i >= (uint)_PartCount)
        return;

    int instanceIndex;
    uint unusedClusterStart;
    uint unusedClusterCount;
    GpuPartData part = LoadPartData(i, instanceIndex, unusedClusterStart, unusedClusterCount);
    if (_UseInstanceCull != 0 && _InstanceVisible[instanceIndex] == 0u)
    {
        _PartVisible[i] = 0u;
        return;
    }
    float lodError = LodErrorPixels(instanceIndex);
    float4 selfSphere = TransformSphere(part.selfSphere, instanceIndex);
    float4 lodSphere = TransformSphere(part.parentSphere.w > 0 ? part.parentSphere : part.selfSphere, instanceIndex);

    // Part：父误差尚可感知则保留（与 Bevy part 粗筛一致）。
    bool visible = SphereVisible(selfSphere) &&
                   !LodErrorIsImperceptible(part.maxParentError, lodSphere, lodError, instanceIndex);

    // Pass1 不做 HZB；Pass2/legacy 才测遮挡。
    if (visible && _CullPassMode != CULL_MODE_PASS1 && IsOccludedByHzb(selfSphere))
        visible = false;

    _PartVisible[i] = visible ? 1u : 0u;
    if (visible && _EnableVisiblePartQueue != 0)
        _VisiblePartsOut.Append(i);
}

[numthreads(64, 1, 1)]
void CSPartCull(uint3 id : SV_DispatchThreadID)
{
    CullPart(id.x);
}

// One 64-lane group owns one visible instance and expands its Part range cooperatively.
// CopyCount writes visibleInstanceCount directly into indirectArgs.x, so this stage
// needs no CPU readback, no prefix sum and no finalize dispatch.
[numthreads(64, 1, 1)]
void CSPartCullVisibleInstances(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID)
{
    uint visibleInstanceIndex = groupId.x;
    uint visibleInstanceCount = _VisibleInstancePartDispatchArgs[0];
    if (visibleInstanceIndex >= visibleInstanceCount)
        return;

    uint instanceIndex = _VisibleInstancesIn[visibleInstanceIndex];
    if (instanceIndex >= (uint)_InstanceCount)
        return;

    GpuInstanceData instanceData = _Instances[instanceIndex];
    for (uint localPartIndex = groupThreadId.x;
         localPartIndex < instanceData.partCount;
         localPartIndex += 64u)
    {
        CullPart(instanceData.partOffset + localPartIndex);
    }
}

void AppendVisibleDrawCluster(uint sceneClusterIndex, uint instanceIndex)
{
    if (_EnableVisibleDrawAppend == 0 || sceneClusterIndex >= (uint)_SceneClusterCount)
        return;

    uint triangleCount = _SceneClusterTriCount[sceneClusterIndex];
    if (triangleCount == 0u)
        return;

    _VisibleDrawClusters.Append(uint3(
        _SceneClusterFirstTri[sceneClusterIndex],
        triangleCount,
        instanceIndex));
}

void RequestPageIfNeeded(uint globalPageIndex)
{
    if (_EnablePageRequests == 0 || globalPageIndex >= (uint)_PageCount)
        return;

    uint wordIndex = globalPageIndex >> 5u;
    uint bit = 1u << (globalPageIndex & 31u);
    if (_TrackPageUsage != 0 || (_PageResidency[wordIndex] & bit) == 0u)
        InterlockedOr(_PageRequests[wordIndex], bit);
}

void CullCluster(uint clusterIdx)
{
    int instanceIndex;
    int virtualPartIndex;
    uint globalPageIndex;
    GpuClusterData c = LoadClusterData(
        clusterIdx,
        instanceIndex,
        virtualPartIndex,
        globalPageIndex);
    if (virtualPartIndex < 0 || virtualPartIndex >= _PartCount)
        return;
    if (_PartVisible[virtualPartIndex] == 0)
        return;

    // Compatibility rendering remains valid while packed streaming is introduced. Missing
    // pages therefore emit a request but are not rejected until parent/root fallback selection
    // is enabled in the hierarchy traversal.
    RequestPageIfNeeded(globalPageIndex);

    float lodError = LodErrorPixels(instanceIndex);
    float4 selfSphere = TransformSphere(c.selfSphere, instanceIndex);
    if (!SphereVisible(selfSphere))
        return;

    // parent / self 必须用各自的误差球投影（Bevy/Nanite），不能共用一个球。
    float4 parentSphere = TransformSphere(c.parentSphere.w > 0 ? c.parentSphere : c.selfSphere, instanceIndex);
    if (!ShouldSelectClusterLod(
            c.parentError,
            c.selfError,
            parentSphere,
            selfSphere,
            lodError,
            instanceIndex))
        return;

    // 整簇屏幕直径 < 1px：亚像素簇直接丢（与 lodError 脱钩，避免 T=8 时误挖 6px 洞）。
    {
        if (ProjectedDiameterPixels(selfSphere) < 1.0)
            return;
    }

    uint gi = 0xFFFFFFFFu;
    if ((_EnableClusterVisibleWrite != 0 || _EnableVisibleDrawAppend != 0) &&
        clusterIdx < (uint)_ClusterCount)
        gi = _ClusterSceneIndex[clusterIdx];

    if (_CullPassMode == CULL_MODE_PASS1)
    {
        // Pass1：无 HZB。
        // _HasPrevVisible==0 或未启用时间滤波：画全部 LOD 切割（安全，避免 LOD 切换破洞）。
        // 启用 prev 时：prev 命中则画；未命中进 Pass2 候选（需 HZB Pass2 补洞）。
        bool usePrevFilter = (_HasPrevVisible != 0);
        bool inPrev = (gi < (uint)_SceneClusterCount && _PrevClusterVisible[gi] != 0u);
        bool drawNow = !usePrevFilter || inPrev;
        if (!drawNow)
        {
            if (gi < (uint)_SceneClusterCount)
            {
                _SecondPassCandidates[gi] = 1u;
                if (_EnableCullStats != 0)
                    InterlockedAdd(_CullStats[1], 1u);
            }
            return;
        }

        AppendVisibleDrawCluster(gi, (uint)instanceIndex);

        if (_EnableVisibleAppend != 0)
            _VisibleClusters.Append(uint3((uint)instanceIndex, (uint)c.pageIndex, (uint)c.clusterIndex));

        if (gi < (uint)_SceneClusterCount)
        {
            _ClusterVisible[gi] = 1u;
            if (_EnableCullStats != 0)
                InterlockedAdd(_CullStats[0], 1u);
        }
        return;
    }

    if (_CullPassMode == CULL_MODE_PASS2)
    {
        // Pass2：补画 Pass1 未画的候选。无 HZB 时不做遮挡剔（只补洞）。
        if (gi >= (uint)_SceneClusterCount || _SecondPassCandidates[gi] == 0u)
            return;
        if (IsOccludedByHzb(selfSphere))
            return;

        AppendVisibleDrawCluster(gi, (uint)instanceIndex);

        if (_EnableVisibleAppend != 0)
            _VisibleClusters.Append(uint3((uint)instanceIndex, (uint)c.pageIndex, (uint)c.clusterIndex));

        _ClusterVisible[gi] = 1u;
        _Pass2Drawn[gi] = 1u;
        if (_EnableCullStats != 0)
            InterlockedAdd(_CullStats[2], 1u);
        return;
    }

    // Legacy
    if (IsOccludedByHzb(selfSphere))
        return;

    AppendVisibleDrawCluster(gi, (uint)instanceIndex);

    if (_EnableVisibleAppend != 0)
        _VisibleClusters.Append(uint3((uint)instanceIndex, (uint)c.pageIndex, (uint)c.clusterIndex));

    if (_EnableClusterVisibleWrite != 0 && gi < (uint)_SceneClusterCount)
        _ClusterVisible[gi] = 1u;
}

[numthreads(64, 1, 1)]
void CSClusterCull(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    uint workCount = (_UseClusterCandidates != 0) ? (uint)_ClusterCandidateCount : (uint)_ClusterCount;
    if (i >= workCount)
        return;
    uint clusterIdx = (_UseClusterCandidates != 0) ? _ClusterCandidates[i] : i;
    CullCluster(clusterIdx);
}

// Large instance scenes avoid CPU BVH traversal and avoid scanning clusters belonging to
// rejected parts. One lane owns a part and expands its usually-small cluster range.
[numthreads(64, 1, 1)]
void CSClusterCullByPart(uint3 id : SV_DispatchThreadID)
{
    uint partIndex = id.x;
    if (partIndex >= (uint)_PartCount || _PartVisible[partIndex] == 0u)
        return;

    int instanceIndex;
    uint clusterStart;
    uint clusterCount;
    LoadPartData(partIndex, instanceIndex, clusterStart, clusterCount);
    uint end = min((uint)_ClusterCount, clusterStart + clusterCount);
    for (uint clusterIndex = clusterStart; clusterIndex < end; clusterIndex++)
        CullCluster(clusterIndex);
}

[numthreads(1, 1, 1)]
void CSFinalizeVisiblePartDispatch(uint3 id : SV_DispatchThreadID)
{
    if (id.x != 0u)
        return;
    uint visiblePartCount = _VisiblePartDispatchArgs[0];
    _VisiblePartDispatchArgs[0] = (visiblePartCount + 63u) / 64u;
    _VisiblePartDispatchArgs[1] = 1u;
    _VisiblePartDispatchArgs[2] = 1u;
    _VisiblePartDispatchArgs[3] = visiblePartCount;
}

// Indirect cluster stage: only revisit parts that survived Instance/Part culling.
[numthreads(64, 1, 1)]
void CSClusterCullVisibleParts(uint3 id : SV_DispatchThreadID)
{
    uint queueIndex = id.x;
    uint visiblePartCount = _VisiblePartDispatchArgs[3];
    if (queueIndex >= visiblePartCount)
        return;

    uint partIndex = _VisiblePartsIn[queueIndex];
    if (partIndex >= (uint)_PartCount)
        return;

    int instanceIndex;
    uint clusterStart;
    uint clusterCount;
    LoadPartData(partIndex, instanceIndex, clusterStart, clusterCount);
    uint end = min((uint)_ClusterCount, clusterStart + clusterCount);
    for (uint clusterIndex = clusterStart; clusterIndex < end; clusterIndex++)
        CullCluster(clusterIndex);
}

bool ShadowSphereVisible(float4 sphere, int cascadeIndex)
{
    int planeBase = cascadeIndex * 6;
    [unroll]
    for (int planeIndex = 0; planeIndex < 6; planeIndex++)
    {
        float4 p = _ShadowFrustumPlanes[planeBase + planeIndex];
        if (dot(p.xyz, sphere.xyz) + p.w < -sphere.w)
            return false;
    }
    return true;
}

float ShadowProjectionScale(int cascadeIndex)
{
    if (cascadeIndex == 0)
        return _ShadowProjectionScales.x;
    if (cascadeIndex == 1)
        return _ShadowProjectionScales.y;
    if (cascadeIndex == 2)
        return _ShadowProjectionScales.z;
    return _ShadowProjectionScales.w;
}

float ShadowProjectedError(float error, int instanceIndex, int cascadeIndex)
{
    if (error >= 1e29)
        return 1e30;
    instanceIndex = clamp(instanceIndex, 0, max(_InstanceCount - 1, 0));
    float worldError = error * max(_Instances[instanceIndex].maxScale, 1e-6);
    return 2.0 * worldError * ShadowProjectionScale(cascadeIndex);
}

bool ShadowLodErrorIsImperceptible(
    float error,
    float thresholdPixels,
    int instanceIndex,
    int cascadeIndex)
{
    return ShadowProjectedError(error, instanceIndex, cascadeIndex) <= thresholdPixels;
}

bool ShouldSelectShadowClusterLod(
    float parentError,
    float selfError,
    float thresholdPixels,
    int instanceIndex,
    int cascadeIndex)
{
    return !ShadowLodErrorIsImperceptible(
               parentError,
               thresholdPixels,
               instanceIndex,
               cascadeIndex) &&
           ShadowLodErrorIsImperceptible(
               selfError,
               thresholdPixels,
               instanceIndex,
               cascadeIndex);
}

void AppendShadowVisibleDrawCluster(int cascadeIndex, uint sceneClusterIndex, uint instanceIndex)
{
    if (sceneClusterIndex >= (uint)_SceneClusterCount)
        return;

    uint triangleCount = _SceneClusterTriCount[sceneClusterIndex];
    if (triangleCount == 0u)
        return;

    uint3 draw = uint3(_SceneClusterFirstTri[sceneClusterIndex], triangleCount, instanceIndex);
    if (cascadeIndex == 0)
        _ShadowVisibleDrawClusters0.Append(draw);
    else if (cascadeIndex == 1)
        _ShadowVisibleDrawClusters1.Append(draw);
    else if (cascadeIndex == 2)
        _ShadowVisibleDrawClusters2.Append(draw);
    else
        _ShadowVisibleDrawClusters3.Append(draw);
}

// Small shadow scenes pay more for four independent Instance/Part/Cluster dispatch chains
// than for their culling work. One lane owns a virtual Part, evaluates all cascade frusta,
// and appends to four independent draw queues. Large scenes keep the hierarchical path.
[numthreads(64, 1, 1)]
void CSShadowCullMultiCascadeByPart(uint3 id : SV_DispatchThreadID)
{
    uint partIndex = id.x;
    if (partIndex >= (uint)_PartCount)
        return;

    int instanceIndex;
    uint clusterStart;
    uint partClusterCount;
    GpuPartData part = LoadPartData(partIndex, instanceIndex, clusterStart, partClusterCount);
    float lodError = LodErrorPixels(instanceIndex);
    float4 partSphere = TransformSphere(part.selfSphere, instanceIndex);

    int cascadeCount = min(max(_ShadowCascadeCount, 0), 4);
    uint partCascadeMask = 0u;
    for (int cascadeIndex = 0; cascadeIndex < cascadeCount; cascadeIndex++)
    {
        if (ShadowSphereVisible(partSphere, cascadeIndex) &&
            !ShadowLodErrorIsImperceptible(
                part.maxParentError,
                lodError,
                instanceIndex,
                cascadeIndex))
            partCascadeMask |= 1u << cascadeIndex;
    }
    if (partCascadeMask == 0u)
        return;

    uint clusterEnd = min((uint)_ClusterCount, clusterStart + partClusterCount);
    for (uint clusterIndex = clusterStart; clusterIndex < clusterEnd; clusterIndex++)
    {
        int clusterInstanceIndex;
        int unusedPartIndex;
        uint globalPageIndex;
        GpuClusterData cluster = LoadClusterData(
            clusterIndex,
            clusterInstanceIndex,
            unusedPartIndex,
            globalPageIndex);

        float4 clusterSphere = TransformSphere(cluster.selfSphere, clusterInstanceIndex);
        uint sceneClusterIndex = _ClusterSceneIndex[clusterIndex];
        bool requestedPage = false;
        for (int cascadeIndex = 0; cascadeIndex < cascadeCount; cascadeIndex++)
        {
            uint cascadeBit = 1u << cascadeIndex;
            if ((partCascadeMask & cascadeBit) == 0u ||
                !ShadowSphereVisible(clusterSphere, cascadeIndex))
                continue;
            if (!ShouldSelectShadowClusterLod(
                    cluster.parentError,
                    cluster.selfError,
                    lodError,
                    clusterInstanceIndex,
                    cascadeIndex))
                continue;
            if (2.0 * clusterSphere.w * ShadowProjectionScale(cascadeIndex) < 1.0)
                continue;

            if (!requestedPage)
            {
                RequestPageIfNeeded(globalPageIndex);
                requestedPage = true;
            }
            AppendShadowVisibleDrawCluster(
                cascadeIndex,
                sceneClusterIndex,
                (uint)clusterInstanceIndex);
        }
    }
}
