// CullPassMode:
// 0 = legacy full frustum/LOD cut with optional HZB
// 1 = main pass: previous-frame HZB, rejected clusters become post-pass candidates
// 2 = post pass: current-frame HZB retests candidates and appends disocclusions
#define CULL_MODE_LEGACY 0
#define CULL_MODE_PASS1 1
#define CULL_MODE_PASS2 2

struct GpuPartData
{
    float4 selfSphere;
    float4 parentSphere;
    float maxParentError;
    int clusterStart;
    int clusterCount;
    int instanceIndex;
    uint lodFlags;
};

struct GpuClusterData
{
    float4 geometrySphere;
    float4 selfSphere;
    float4 parentSphere;
    float selfError;
    float parentError;
    int partIndex;
    int pageIndex;
    int clusterIndex;
    int instanceIndex;
    uint lodFlags;
    uint refinementGroupIndex;
    uint packedCone;
    float longestEdge;
};

#define LOD_FLAG_TERMINAL_DISAPPEAR 1u
#define TERMINAL_DISAPPEAR_PIXELS 0.5
#define TERMINAL_DISAPPEAR_SHADOW_TEXELS 1.0
// A one-texel geometric error target over-shades CSMs: PCF/filtering cannot
// preserve that detail and four cascades multiply it. Keep primary visibility
// at the authored pixel threshold, but use the same conservative two-texel
// shadow target as a raster-specific LOD bias. This is independent per cascade
// because ShadowProjectionScale already contains that cascade's texel density.
#define SHADOW_LOD_MIN_TEXELS 2.0

StructuredBuffer<GpuPartData> _Parts;
StructuredBuffer<GpuClusterData> _Clusters;
// GPU Scene indirection: immutable Part/Cluster data is stored once per unique mesh.
// Each virtual reference is only uint4(instance, geometryIndex, relation/range).
StructuredBuffer<uint4> _VirtualParts;
StructuredBuffer<uint4> _VirtualClusters;
// Part cull writes this mask while cluster cull only reads it. Splitting the
// declarations removes one otherwise unnecessary UAV from cluster kernels.
StructuredBuffer<uint> _PartVisible;
RWStructuredBuffer<uint> _PartVisibleWrite;
AppendStructuredBuffer<uint> _VisiblePartsOut;
StructuredBuffer<uint> _VisiblePartsIn;
// The finalize kernel writes these args, while indirect cluster cull only reads
// them. Keeping both views separate prevents the read-only cluster kernel from
// consuming an unnecessary UAV slot on D3D12 (Windows Player supports eight).
StructuredBuffer<uint> _VisiblePartDispatchArgs;
RWStructuredBuffer<uint> _VisiblePartDispatchArgsWrite;
AppendStructuredBuffer<uint> _VisibleInstancesOut;
StructuredBuffer<uint> _VisibleInstancesIn;
StructuredBuffer<uint> _VisibleInstancePartDispatchArgs;
struct GpuHierarchyGroup
{
    float4 boundingSphere;
    float minLodError;
    float maxParentLodError;
    uint fineClusterStart;
    uint fineClusterCount;
    uint coarseClusterStart;
    uint coarseClusterCount;
    uint mipLevel;
    uint flags;
};
struct GpuSpatialNode
{
    float4 boundingSphere;
    float4 lodSphere;
    float maxParentError;
    uint childStart;
    uint childCount;
    uint partRefStart;
    uint partRefCount;
    uint flags;
};
#define SPATIAL_NODE_LEAF 1u
#define SPATIAL_NODE_HAS_TERMINAL 2u
StructuredBuffer<GpuSpatialNode> _SpatialNodes;
StructuredBuffer<uint> _SpatialPartRefs;
StructuredBuffer<uint2> _SpatialInputQueue;
AppendStructuredBuffer<uint2> _SpatialOutputQueue;
StructuredBuffer<uint3> _ShadowSpatialInputQueue;
AppendStructuredBuffer<uint3> _ShadowSpatialOutputQueue;
StructuredBuffer<GpuHierarchyGroup> _HierarchyGroups;
StructuredBuffer<uint4> _HierarchyClusterRefs;
StructuredBuffer<uint2> _HierarchyResidencyRefs;
StructuredBuffer<uint> _HierarchyGroupResidency;
RWStructuredBuffer<uint> _HierarchyGroupResidencyWrite;
StructuredBuffer<uint> _HierarchyRootGroups;
StructuredBuffer<uint2> _HierarchyInputQueue;
AppendStructuredBuffer<uint2> _HierarchyOutputQueue;
StructuredBuffer<uint> _HierarchyDispatchArgs;
RWStructuredBuffer<uint> _HierarchyDispatchArgsWrite;
// Nyx-style persistent task queue. State and task payload share one raw UAV so the
// traversal kernel stays within the eight-UAV Windows compatibility limit.
// reservedWrite is allocation only; consumers are gated by the contiguous
// publishedWrite frontier. This prevents unpublished producers from parking all
// persistent workers on incomplete slots.
// state: read, reservedWrite, publishedWrite, activeWorkers, done, overflow,
//        processedTaskCount, selectedRefCount (eight uints)
// task: uint3(instance, hierarchyRef, viewMask) + uint readyEpoch (16 bytes)
globallycoherent RWByteAddressBuffer _HierarchyPersistentWork;
AppendStructuredBuffer<uint3> _VisibleClusters;
AppendStructuredBuffer<uint3> _VisibleDrawClusters;
AppendStructuredBuffer<uint3> _HardwareRasterClusters;
AppendStructuredBuffer<uint3> _SoftwareRasterClusters;
AppendStructuredBuffer<uint3> _ShadowVisibleDrawClusters0;
AppendStructuredBuffer<uint3> _ShadowVisibleDrawClusters1;
AppendStructuredBuffer<uint3> _ShadowVisibleDrawClusters2;
AppendStructuredBuffer<uint3> _ShadowVisibleDrawClusters3;
RWStructuredBuffer<uint> _ClusterVisible;
StructuredBuffer<uint> _ClusterSceneIndex;
StructuredBuffer<uint> _SceneClusterFirstTri;
StructuredBuffer<uint> _SceneClusterTriCount;
StructuredBuffer<uint> _PrevClusterVisible;
RWStructuredBuffer<uint> _SecondPassCandidates;
RWStructuredBuffer<uint> _Pass2Drawn;
StructuredBuffer<uint> _UintCopySrc;
RWStructuredBuffer<uint> _UintCopyDst;
RWStructuredBuffer<uint> _CullStats; // [0]=pass1Drawn [1]=pass2Candidates [2]=pass2Drawn
StructuredBuffer<uint> _Pass1Visible;
StructuredBuffer<uint> _OrMaskB;
Texture2D<float> _HizTexture;
SamplerState sampler_HizTexture;
StructuredBuffer<uint> _ClusterCandidates;
StructuredBuffer<uint> _PageResidency;
RWStructuredBuffer<uint> _PageRequests;

