#pragma kernel TraceDebug
#pragma target 5.0

#include "../../Shaders/GIClipmapCommon.hlsl"

StructuredBuffer<GIClipmapLevelData> _GIClipmapLevels;
StructuredBuffer<int> _GIStaticPageTable;
StructuredBuffer<uint> _GIStaticOccupancy;
StructuredBuffer<uint> _GIStaticSurface;
StructuredBuffer<uint> _GIStaticDistance;
StructuredBuffer<int> _GIDynamicPageTable;
StructuredBuffer<uint> _GIDynamicOccupancy;
StructuredBuffer<uint> _GIDynamicSurface;
StructuredBuffer<uint> _GIDynamicDistance;
RWTexture2D<float4> _GIResult;

float4x4 _GIInverseViewProjection;
float3 _GICameraPosition;
float _GIMaxTraceDistance;
uint2 _GIOutputSize;

float3 GIUnpackOctNormal(uint packedSurface)
{
    float2 oct = float2(packedSurface & 0xffu, (packedSurface >> 8u) & 0xffu) / 255.0 * 2.0 - 1.0;
    float3 normal = float3(oct, 1.0 - abs(oct.x) - abs(oct.y));
    if (normal.z < 0.0)
    {
        float2 signNotZero = float2(normal.x >= 0.0 ? 1.0 : -1.0, normal.y >= 0.0 ? 1.0 : -1.0);
        normal.xy = (1.0 - abs(normal.yx)) * signNotZero;
    }
    return normalize(normal);
}

float3 GIHashColor(uint value)
{
    value ^= value >> 16u;
    value *= 0x7feb352du;
    value ^= value >> 15u;
    return float3(value & 255u, (value >> 8u) & 255u, (value >> 16u) & 255u) / 255.0;
}

[numthreads(8, 8, 1)]
void TraceDebug(uint3 dispatchId : SV_DispatchThreadID)
{
    if (any(dispatchId.xy >= _GIOutputSize))
        return;
    float2 uv = (float2(dispatchId.xy) + 0.5) / float2(_GIOutputSize);
    float2 ndc = uv * 2.0 - 1.0;
    float4 world0 = mul(_GIInverseViewProjection, float4(ndc, 0.0, 1.0));
    float4 world1 = mul(_GIInverseViewProjection, float4(ndc, 1.0, 1.0));
    world0.xyz /= max(abs(world0.w), 1e-6);
    world1.xyz /= max(abs(world1.w), 1e-6);
    float3 candidate0 = world0.xyz - _GICameraPosition;
    float3 candidate1 = world1.xyz - _GICameraPosition;
    float3 direction = normalize(dot(candidate0, candidate0) > dot(candidate1, candidate1) ? candidate0 : candidate1);

    float hitT;
    uint packedSurface;
    uint hitLayer;
    uint hitLevel;
    uint traceSteps;
    bool hit = GITraceUnifiedClipmaps(
        _GIClipmapLevels,
        _GIStaticPageTable, _GIStaticOccupancy, _GIStaticSurface, _GIStaticDistance,
        _GIDynamicPageTable, _GIDynamicOccupancy, _GIDynamicSurface, _GIDynamicDistance,
        _GICameraPosition, direction, _GIMaxTraceDistance, 0u,
        hitT, packedSurface, hitLayer, hitLevel, traceSteps);
    if (!hit)
    {
        _GIResult[dispatchId.xy] = float4(0.015, 0.02, 0.03, 1.0);
        return;
    }

    uint materialIndex = (packedSurface >> 16u) & 0x7fffu;
    float3 normal = GIUnpackOctNormal(packedSurface);
    float3 materialColor = GIHashColor(materialIndex + 1u);
    float lighting = 0.25 + 0.75 * saturate(dot(normal, normalize(float3(0.4, 0.8, 0.2))));
    float3 layerTint = hitLayer == 0u ? float3(1.0, 0.85, 0.75) : float3(0.6, 0.85, 1.0);
    _GIResult[dispatchId.xy] = float4(materialColor * layerTint * lighting, 1.0);
}
