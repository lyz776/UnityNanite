uint2 GIGetFullSize()
{
    return max((uint2)_GIViewportSize.xy, 1u);
}

uint2 GIGetDiffuseSize()
{
    uint width, height;
    _GICurrentDiffuse.GetDimensions(width, height);
    return uint2(width, height);
}

uint2 GIGetSpecularSize()
{
    return max((uint2)_GISpecularBufferSize.xy, 1u);
}

#define _GIFullSize GIGetFullSize()
#define _GIDiffuseSize GIGetDiffuseSize()
#define _GISpecularSize GIGetSpecularSize()

float GIHZBReduce(float a, float b)
{
#if UNITY_REVERSED_Z
    return max(a, b);
#else
    return min(a, b);
#endif
}

[numthreads(8, 8, 1)]
void BuildHzbMip0(uint3 dispatchId : SV_DispatchThreadID)
{
    uint targetWidth, targetHeight;
    _GIHzbMip.GetDimensions(targetWidth, targetHeight);
    if (dispatchId.x >= targetWidth || dispatchId.y >= targetHeight)
        return;
    uint2 sourceSize = (uint2)_GIHzbSourceSize.xy;
    uint2 sourceBase = min(
        (uint2)((float2(dispatchId.xy) / float2(targetWidth, targetHeight)) * float2(sourceSize)),
        sourceSize - 1u);
    uint2 sourceNext = min(sourceBase + 1u, sourceSize - 1u);
    float d = _GIDepthTexture.Load(int3(sourceBase, 0));
    d = GIHZBReduce(d, _GIDepthTexture.Load(int3(uint2(sourceNext.x, sourceBase.y), 0)));
    d = GIHZBReduce(d, _GIDepthTexture.Load(int3(uint2(sourceBase.x, sourceNext.y), 0)));
    d = GIHZBReduce(d, _GIDepthTexture.Load(int3(sourceNext, 0)));
    _GIHzbMip[dispatchId.xy] = d;
}

[numthreads(8, 8, 1)]
void BuildHzbMip(uint3 dispatchId : SV_DispatchThreadID)
{
    uint targetWidth, targetHeight;
    _GIHzbMip.GetDimensions(targetWidth, targetHeight);
    if (dispatchId.x >= targetWidth || dispatchId.y >= targetHeight)
        return;
    uint2 sourceSize = (uint2)_GIHzbSourceSize.xy;
    uint2 p0 = min(dispatchId.xy * 2u, sourceSize - 1u);
    uint2 p1 = min(p0 + 1u, sourceSize - 1u);
    float d = _GIHzbSource.Load(int3(p0, 0));
    d = GIHZBReduce(d, _GIHzbSource.Load(int3(uint2(p1.x, p0.y), 0)));
    d = GIHZBReduce(d, _GIHzbSource.Load(int3(uint2(p0.x, p1.y), 0)));
    d = GIHZBReduce(d, _GIHzbSource.Load(int3(p1, 0)));
    _GIHzbMip[dispatchId.xy] = d;
}

bool GIIsBackground(float depth)
{
#if UNITY_REVERSED_Z
    return depth <= 1e-6;
#else
    return depth >= 0.999999;
#endif
}

float2 GIUvFromPixel(uint2 pixel, uint2 size)
{
    return (float2(pixel) + 0.5) / float2(size);
}

uint2 GIFullPixelFromUv(float2 uv)
{
    return min((uint2)(uv * float2(_GIFullSize)), _GIFullSize - 1u);
}

float3 GIDecodeNormal(float3 packed)
{
#if defined(_GBUFFER_NORMALS_OCT)
    float2 remapped = Unpack888ToFloat2(packed);
    return normalize(UnpackNormalOctQuadEncode(remapped * 2.0 - 1.0));
#else
    return normalize(packed);
#endif
}

float3 GILoadNormal(float2 uv)
{
    return GIDecodeNormal(_GINormalsTexture.Load(int3(GIFullPixelFromUv(uv), 0)).xyz);
}

float GILoadDepth(float2 uv)
{
    return _GIDepthTexture.Load(int3(GIFullPixelFromUv(uv), 0));
}

float3 GIWorldPosition(float2 uv, float depth)
{
    return ComputeWorldSpacePosition(uv, depth, _GIInverseViewProjection);
}

uint GIHash(uint value)
{
    value ^= value >> 16u;
    value *= 0x7feb352du;
    value ^= value >> 15u;
    value *= 0x846ca68bu;
    value ^= value >> 16u;
    return value;
}

float2 GIRandom2(uint seed)
{
    uint a = GIHash(seed);
    uint b = GIHash(a ^ 0x9e3779b9u);
    return float2(a & 0x00ffffffu, b & 0x00ffffffu) / 16777216.0;
}

// Per-pixel Cranley-Patterson rotation over an R2 sequence.  Independent white-noise
// frames made large quarter-resolution blocks choose unrelated emissive paths every frame.
// This sequence still explores the hemisphere but distributes successive frames evenly.
float2 GIDiffuseSequence(uint2 pixel, uint rayIndex)
{
    uint pixelSeed = pixel.x + pixel.y * _GIDiffuseSize.x;
    float2 rotation = GIRandom2(pixelSeed ^ 0xa511e9b3u);
    // Reserve four sequence slots per frame so bounded disocclusion rays never reuse the
    // indices consumed by the following frame's base ray.
    float sequenceIndex = (float)(_GIFrameIndex * 4u + rayIndex + 1u);
    float2 sequence = frac(
        rotation + sequenceIndex * float2(0.754877666, 0.569840296));
    // A 2x2 low-resolution quad corresponds to one 8x8 full-resolution screen probe at
    // the default quarter scale.  Stratify its four lanes over the 2-D cosine sample
    // domain, and rotate lane ownership every frame so each pixel remains unbiased even
    // when geometry discontinuities prevent cross-lane reuse.
    bool interleavedProbe = _GIDiffuseRayCount == 1u &&
        _GIDiffuseSize.x * 4u >= _GIFullSize.x &&
        _GIDiffuseSize.y * 4u >= _GIFullSize.y;
    uint lane = (pixel.x & 1u) | ((pixel.y & 1u) << 1u);
    // In the interleaved path the active lane already rotates with FrameIndex. Adding
    // FrameIndex a second time sampled only strata 0/2.  Compact 1/8-resolution probes
    // instead cycle all four strata temporally at one fresh ray per probe per frame.
    uint stratum = interleavedProbe
        ? lane : ((_GIFrameIndex + rayIndex) & 3u);
    float2 stratumOffset = float2(stratum & 1u, (stratum >> 1u) & 1u);
    return (stratumOffset + sequence) * 0.5;
}

// Separate low-discrepancy dimensions for proposal-family, alias-entry and cone
// selection.  The former implementation hashed the frame number for all three choices,
// turning a well-stratified cosine sequence back into white noise whenever emissive NEE
// was enabled.  A Cranley-Patterson rotation keeps pixels decorrelated while successive
// frames cover each dimension evenly.
float2 GIDiffuseProposalSequence(uint2 pixel, uint rayIndex, uint salt)
{
    uint pixelSeed = pixel.x + pixel.y * _GIDiffuseSize.x;
    float2 rotation = GIRandom2(pixelSeed ^ salt);
    float sequenceIndex = (float)(_GIFrameIndex * 4u + rayIndex + 1u);
    return frac(rotation + sequenceIndex * float2(0.754877666, 0.569840296));
}

void GIBasis(float3 n, out float3 tangent, out float3 bitangent)
{
    float signValue = n.z >= 0.0 ? 1.0 : -1.0;
    float a = -1.0 / (signValue + n.z);
    float b = n.x * n.y * a;
    tangent = float3(1.0 + signValue * n.x * n.x * a, signValue * b, -signValue * n.x);
    bitangent = float3(b, signValue + n.y * n.y * a, -n.y);
}

float3 GICosineDirection(float3 normal, float2 randomValue)
{
    float radius = sqrt(randomValue.x);
    float phi = TWO_PI * randomValue.y;
    float3 tangent;
    float3 bitangent;
    GIBasis(normal, tangent, bitangent);
    return normalize(tangent * (radius * cos(phi)) + bitangent * (radius * sin(phi)) +
                     normal * sqrt(saturate(1.0 - randomValue.x)));
}

float2 GIDiffuseSequence(uint2 pixel, uint rayIndex);

float GIEmissiveDirectionalPdf(float3 origin, float3 direction)
{
    float pdf = 0.0;
    [loop]
    for (uint i = 0u; i < min(_GIEmissiveAliasCount, 32u); i++)
    {
        GIEmissiveAliasData source = _GIEmissiveAliases[i];
        float3 toCenter = source.worldBoundingSphere.xyz - origin;
        float distanceSquared = dot(toCenter, toCenter);
        float radius = max(0.05, source.worldBoundingSphere.w);
        if (distanceSquared <= radius * radius * 1.0001)
            continue;
        float inverseDistance = rsqrt(distanceSquared);
        float cosThetaMax = sqrt(saturate(1.0 - radius * radius / distanceSquared));
        if (dot(direction, toCenter * inverseDistance) >= cosThetaMax)
            pdf += source.probability /
                max(TWO_PI * (1.0 - cosThetaMax), 1e-6);
    }
    return pdf;
}

bool GISampleEmissiveDirection(float3 origin, uint2 pixel, uint rayIndex,
                               out float3 direction)
{
    direction = 0.0;
    if (_GIEmissiveAliasCount == 0u)
        return false;
    float2 aliasRandom = GIDiffuseProposalSequence(
        pixel, rayIndex, 0xd1b54a35u);
    uint tableIndex = min((uint)(aliasRandom.x * _GIEmissiveAliasCount),
                          _GIEmissiveAliasCount - 1u);
    GIEmissiveAliasData tableEntry = _GIEmissiveAliases[tableIndex];
    uint selectedIndex = aliasRandom.y < tableEntry.aliasProbability
        ? tableIndex : min(tableEntry.aliasIndex, _GIEmissiveAliasCount - 1u);
    GIEmissiveAliasData source = _GIEmissiveAliases[selectedIndex];
    float3 toCenter = source.worldBoundingSphere.xyz - origin;
    float distanceSquared = dot(toCenter, toCenter);
    float radius = max(0.05, source.worldBoundingSphere.w);
    if (distanceSquared <= radius * radius * 1.0001)
        return false;
    float3 axis = toCenter * rsqrt(distanceSquared);
    float cosThetaMax = sqrt(saturate(1.0 - radius * radius / distanceSquared));
    float2 coneRandom = GIDiffuseProposalSequence(
        pixel, rayIndex, 0x94d049bbu);
    float cosTheta = lerp(1.0, cosThetaMax, coneRandom.x);
    float sinTheta = sqrt(saturate(1.0 - cosTheta * cosTheta));
    float phi = TWO_PI * coneRandom.y;
    float3 tangent;
    float3 bitangent;
    GIBasis(axis, tangent, bitangent);
    direction = normalize(axis * cosTheta +
        (tangent * cos(phi) + bitangent * sin(phi)) * sinTheta);
    return true;
}

float GIDiffuseMixturePdf(float3 origin, float3 normal, float3 direction)
{
    const float emissiveProbability = 0.35;
    float qEmissive = _GIEmissiveAliasCount > 0u ? emissiveProbability : 0.0;
    float cosinePdf = max(dot(normal, direction), 0.0) / PI;
    float emissivePdf = qEmissive > 0.0
        ? GIEmissiveDirectionalPdf(origin, direction) : 0.0;
    return max((1.0 - qEmissive) * cosinePdf + qEmissive * emissivePdf, 1e-6);
}

bool GIChooseDiffuseDirection(uint2 pixel, uint ray, float3 origin, float3 normal,
                              out float3 direction, out float sourcePdf)
{
    direction = normal;
    sourcePdf = 1.0;
    const float emissiveProbability = 0.35;
    float qEmissive = _GIEmissiveAliasCount > 0u ? emissiveProbability : 0.0;
    // Stratify the proposal family across the aligned 2x2 screen-probe lanes.  At the
    // default q=0.35 every probe receives one or two emissive proposals instead of
    // occasionally receiving four or none, which was visible as swapping red blocks.
    uint lane = (pixel.x & 1u) | ((pixel.y & 1u) << 1u);
    uint2 probe = pixel >> 1u;
    float probeRotation = GIRandom2(
        probe.x + probe.y * max(1u, (_GIDiffuseSize.x + 1u) >> 1u) ^ 0x632be59bu).x;
    float familyValue = frac(probeRotation +
        ((float)lane + (float)ray * 0.618033989 +
         (float)_GIFrameIndex * 0.754877666) * 0.25);
    bool choseEmissive = qEmissive > 0.0 && familyValue < qEmissive;
    if (!choseEmissive)
    {
        direction = GICosineDirection(normal, GIDiffuseSequence(pixel, ray));
    }
    else
    {
        // Keep the out-parameter initialized across the short-circuit path.  Unity's
        // D3D11 frontend otherwise treats direction as potentially undefined when the
        // emitter sampler rejects before the hemisphere test.
        float3 emissiveDirection = normal;
        bool validEmissive = GISampleEmissiveDirection(
            origin, pixel, ray, emissiveDirection);
        if (!validEmissive || dot(normal, emissiveDirection) <= 1e-4)
        {
            // Do not silently turn a rejected emissive proposal into another cosine sample.
            // That changes the actual mixture probability without changing its PDF and creates
            // a systematic bright bias for receivers inside/behind large emitter bounds.
            direction = normal;
            sourcePdf = 1.0;
            return false;
        }
        direction = emissiveDirection;
    }
    sourcePdf = GIDiffuseMixturePdf(origin, normal, direction);
    return true;
}

float3 GIGgxDirection(float3 normal, float3 viewDirection, float roughness, float2 randomValue)
{
    float alpha = max(roughness * roughness, 0.0025);
    // Frostbite-style truncation: keep rough lobes concentrated around the mirror direction
    // so a single initial ray remains useful before full-resolution ray reuse.
    randomValue.y *= lerp(1.0, 0.35, roughness);
    float phi = TWO_PI * randomValue.x;
    float cosTheta = sqrt((1.0 - randomValue.y) /
        max(1.0 + (alpha * alpha - 1.0) * randomValue.y, 1e-5));
    float sinTheta = sqrt(saturate(1.0 - cosTheta * cosTheta));
    float3 tangent;
    float3 bitangent;
    GIBasis(normal, tangent, bitangent);
    float3 halfVector = normalize(tangent * (sinTheta * cos(phi)) +
                                  bitangent * (sinTheta * sin(phi)) + normal * cosTheta);
    float3 direction = reflect(-viewDirection, halfVector);
    return dot(direction, normal) > 0.001 ? normalize(direction) : reflect(-viewDirection, normal);
}

float GIGgxDirectionPdf(float3 normal, float3 viewDirection, float3 direction, float roughness)
{
    float3 halfVector = normalize(viewDirection + direction);
    float noH = max(0.0, dot(normal, halfVector));
    float voH = max(1e-5, dot(viewDirection, halfVector));
    float alpha = max(roughness * roughness, 0.0025);
    float alpha2 = alpha * alpha;
    float denominator = max(PI * pow(noH * noH * (alpha2 - 1.0) + 1.0, 2.0), 1e-6);
    float distribution = alpha2 / denominator;
    return max(1e-6, distribution * noH / (4.0 * voH));
}

float3 GIUnpackSurfaceNormal(uint packedSurface)
{
    float2 oct = float2(packedSurface & 0xffu, (packedSurface >> 8u) & 0xffu) / 255.0 * 2.0 - 1.0;
    float3 normal = float3(oct, 1.0 - abs(oct.x) - abs(oct.y));
    if (normal.z < 0.0)
    {
        float2 signNotZero = float2(normal.x >= 0.0 ? 1.0 : -1.0, normal.y >= 0.0 ? 1.0 : -1.0);
        normal.xy = (1.0 - abs(normal.yx)) * signNotZero;
    }
    return normalize(normal);
}

float4 GIEncodeDiffuseHit(float3 normal, float valid, uint2 stableId)
{
    normal /= max(abs(normal.x) + abs(normal.y) + abs(normal.z), 1e-6);
    float2 oct = normal.xy;
    if (normal.z < 0.0)
    {
        float2 signNotZero = float2(oct.x >= 0.0 ? 1.0 : -1.0,
                                    oct.y >= 0.0 ? 1.0 : -1.0);
        oct = (1.0 - abs(oct.yx)) * signNotZero;
    }
    uint2 encoded = (uint2)round(saturate(oct * 0.5 + 0.5) * 65535.0);
    uint packedNormal = encoded.x | (encoded.y << 16u);
    return float4(asfloat(packedNormal), asfloat(stableId.x), asfloat(stableId.y), valid);
}

float3 GIDecodeDiffuseHitNormal(float4 record)
{
    uint packed = asuint(record.x);
    float2 oct = float2(packed & 0xffffu, packed >> 16u) / 65535.0 * 2.0 - 1.0;
    float3 normal = float3(oct, 1.0 - abs(oct.x) - abs(oct.y));
    if (normal.z < 0.0)
    {
        float2 signNotZero = float2(normal.x >= 0.0 ? 1.0 : -1.0,
                                    normal.y >= 0.0 ? 1.0 : -1.0);
        normal.xy = (1.0 - abs(normal.yx)) * signNotZero;
    }
    return normalize(normal);
}

uint2 GIDecodeDiffuseHitStableId(float4 record)
{
    return uint2(asuint(record.y), asuint(record.z));
}

void GIEvaluateMaterialAtUv(
    uint materialIndex,
    float2 uv,
    uint hitLevel,
    out float3 baseColor,
    out float3 emissive,
    out float roughness,
    out float metallic)
{
    baseColor = 0.6;
    emissive = 0.0;
    roughness = 0.5;
    metallic = 0.0;
    if (materialIndex >= _GIMaterialCount)
        return;

    GIMaterialData material = _GIMaterials[materialIndex];
    baseColor = max(0.0, material.baseColor.rgb);
    emissive = max(0.0, material.emissive.rgb);
    roughness = saturate(material.surface.x);
    metallic = saturate(material.surface.y);
    if (materialIndex >= _GITextureSliceCount)
        return;
    float mipLevel = min((float)hitLevel, 6.0);
    if ((material.flags & GI_MATERIAL_HAS_BASE_MAP) != 0u)
        baseColor *= _GIBaseColorTextures.SampleLevel(
            sampler_LinearRepeat,
            float3(uv * material.baseMapST.xy + material.baseMapST.zw, materialIndex),
            mipLevel).rgb;
    if ((material.flags & GI_MATERIAL_HAS_EMISSION_MAP) != 0u)
        emissive *= _GIEmissionTextures.SampleLevel(
            sampler_LinearRepeat,
            float3(uv * material.emissionMapST.xy + material.emissionMapST.zw, materialIndex),
            mipLevel).rgb;
    if ((material.flags & GI_MATERIAL_HAS_MASK_MAP) != 0u)
    {
        float4 mask = _GIMaskTextures.SampleLevel(
            sampler_LinearRepeat,
            float3(uv * material.maskMapST.xy + material.maskMapST.zw, materialIndex),
            mipLevel);
        uint metallicChannel = GIMaterialMetallicChannel(material);
        uint roughnessChannel = GIMaterialRoughnessChannel(material);
        if (metallicChannel != GI_MASK_CHANNEL_CONSTANT)
            metallic = saturate(GISelectMaterialChannel(mask, metallicChannel, metallic) *
                                material.maskRemap0.x + material.maskRemap0.y);
        if (roughnessChannel != GI_MASK_CHANNEL_CONSTANT)
            roughness = saturate(GISelectMaterialChannel(mask, roughnessChannel, roughness) *
                                 material.maskRemap0.z + material.maskRemap0.w);
    }
}

void GIEvaluateHitMaterial(
    uint packedSurface,
    uint hitLayer,
    int hitPhysicalBrick,
    uint hitLocalCell,
    uint hitLevel,
    out float3 baseColor,
    out float3 emissive,
    out float roughness,
    out float metallic)
{
    uint materialIndex = (packedSurface >> 16u) & 0x7fffu;
    float2 uv = 0.0;
    if (hitPhysicalBrick >= 0)
    {
        uint uvAddress = (uint)hitPhysicalBrick * GI_SURFACE_UV_WORDS_PER_BRICK + hitLocalCell;
        uint packedUv = hitLayer == 0u
            ? _GIStaticSurfaceUV[uvAddress]
            : _GIDynamicSurfaceUV[uvAddress];
        uv = float2(f16tof32(packedUv & 0xffffu), f16tof32(packedUv >> 16u));
    }
    GIEvaluateMaterialAtUv(materialIndex, uv, hitLevel,
                           baseColor, emissive, roughness, metallic);
}

float3 GIUnpackRgb9E5(uint packed)
{
    if (packed == 0u)
        return 0.0;
    uint3 mantissa = uint3(packed & 0x1ffu, (packed >> 9u) & 0x1ffu,
                           (packed >> 18u) & 0x1ffu);
    int exponentValue = (int)((packed >> 27u) & 0x1fu) - 15;
    return (float3)mantissa * exp2((float)exponentValue - 9.0);
}

float3 GIReadDirectionalCell(int physicalBrick, uint localCell, uint hitLayer,
                             float3 outgoingDirection)
{
    uint cellAddress = (uint)physicalBrick * GI_CELLS_PER_BRICK + localCell;
    uint validity = hitLayer == 0u ? _GIStaticValidity[cellAddress] : _GIDynamicValidity[cellAddress];
    float confidence = (validity & 0xffu) / 255.0;
    if (confidence < 0.125)
        return 0.0;
    uint surfaceAddress = (uint)physicalBrick * GI_SURFACE_WORDS_PER_BRICK + localCell;
    uint packedSurface = hitLayer == 0u ? _GIStaticSurface[surfaceAddress]
                                        : _GIDynamicSurface[surfaceAddress];
    float3 surfaceNormal = GIUnpackSurfaceNormal(packedSurface);
    uint materialIndex = (packedSurface >> 16u) & 0x7fffu;
    bool twoSided = materialIndex < _GIMaterialCount &&
        (_GIMaterials[materialIndex].flags & GI_MATERIAL_DOUBLE_SIDED) != 0u;
    if (!twoSided && dot(surfaceNormal, normalize(outgoingDirection)) <= 0.0)
        return 0.0;
    float3 direction = normalize(outgoingDirection);
    float3 weights = abs(direction);
    uint3 lobes = uint3(direction.x >= 0.0 ? 0u : 1u,
                        direction.y >= 0.0 ? 2u : 3u,
                        direction.z >= 0.0 ? 4u : 5u);
    uint baseAddress = (uint)physicalBrick * GI_RADIANCE_WORDS_PER_BRICK +
                       localCell * GI_RADIANCE_LOBE_COUNT;
    float3 x = GIUnpackRgb9E5(hitLayer == 0u ? _GIStaticRadiance[baseAddress + lobes.x]
                                             : _GIDynamicRadiance[baseAddress + lobes.x]);
    float3 y = GIUnpackRgb9E5(hitLayer == 0u ? _GIStaticRadiance[baseAddress + lobes.y]
                                             : _GIDynamicRadiance[baseAddress + lobes.y]);
    float3 z = GIUnpackRgb9E5(hitLayer == 0u ? _GIStaticRadiance[baseAddress + lobes.z]
                                             : _GIDynamicRadiance[baseAddress + lobes.z]);
    // Confidence participates in reconstruction weights below.  The RGB payload is already
    // outgoing radiance and must never be attenuated a second time by convergence state.
    return x * weights.x + y * weights.y + z * weights.z;
}

int3 GIFilterOffset(uint sampleIndex)
{
    if (sampleIndex == 1u) return int3(1, 0, 0);
    if (sampleIndex == 2u) return int3(-1, 0, 0);
    if (sampleIndex == 3u) return int3(0, 1, 0);
    if (sampleIndex == 4u) return int3(0, -1, 0);
    if (sampleIndex == 5u) return int3(0, 0, 1);
    if (sampleIndex == 6u) return int3(0, 0, -1);
    return 0;
}

float3 GIReadCachedRadiance(int centerBrick, uint centerLocalCell, int3 centerWorldCell,
                            uint centerIdentity, uint hitLayer, uint hitLevel, float3 hitPosition,
                            float3 outgoingDirection, out float cacheWeight)
{
    cacheWeight = 0.0;
    uint cellAddress = (uint)centerBrick * GI_CELLS_PER_BRICK + centerLocalCell;
    uint validity = hitLayer == 0u ? _GIStaticValidity[cellAddress] : _GIDynamicValidity[cellAddress];
    float confidence = (validity & 0xffu) / 255.0;
    if (confidence < 0.125)
        return 0.0;

    // Reconstruct continuously from the eight cell centres surrounding the hit. The previous
    // fixed 3x3x3 gather always gave the hit cell unit weight, so its neighbourhood changed
    // discontinuously at every world-cell boundary and made the clipmap grid visible.
    GIClipmapLevelData level = _GIClipmapLevels[hitLevel];
    uint centerPacked = hitLayer == 0u
        ? _GIStaticSurface[(uint)centerBrick * GI_SURFACE_WORDS_PER_BRICK + centerLocalCell]
        : _GIDynamicSurface[(uint)centerBrick * GI_SURFACE_WORDS_PER_BRICK + centerLocalCell];
    float3 centerNormal = GIUnpackSurfaceNormal(centerPacked);
    uint centerMaterial = (centerPacked >> 16u) & 0x7fffu;
    float3 sampleCoordinate = hitPosition / level.cellSize - 0.5;
    int3 baseWorldCell = (int3)floor(sampleCoordinate);
    float3 fraction = frac(sampleCoordinate);
    float3 accumulated = 0.0;
    float accumulatedWeight = 0.0;
    [unroll]
    for (int z = 0; z <= 1; z++)
    [unroll]
    for (int y = 0; y <= 1; y++)
    [unroll]
    for (int x = 0; x <= 1; x++)
    {
        int3 worldCell = baseWorldCell + int3(x, y, z);
        int physicalBrick = -1;
        uint localCell = 0u;
        bool occupied = hitLayer == 0u
            ? GIReadOccupancy(level, _GIStaticPageTable, _GIStaticOccupancy,
                              worldCell, physicalBrick, localCell)
            : GIReadOccupancy(level, _GIDynamicPageTable, _GIDynamicOccupancy,
                              worldCell, physicalBrick, localCell);
        if (!occupied)
            continue;

        uint packedSurface = hitLayer == 0u
            ? _GIStaticSurface[(uint)physicalBrick * GI_SURFACE_WORDS_PER_BRICK + localCell]
            : _GIDynamicSurface[(uint)physicalBrick * GI_SURFACE_WORDS_PER_BRICK + localCell];
        uint sampleIdentity = hitLayer == 0u
            ? _GIStaticSurfaceIdentity[(uint)physicalBrick * GI_SURFACE_WORDS_PER_BRICK + localCell]
            : _GIDynamicSurfaceIdentity[(uint)physicalBrick * GI_SURFACE_WORDS_PER_BRICK + localCell];
        uint sampleMaterial = (packedSurface >> 16u) & 0x7fffu;
        if (sampleIdentity != centerIdentity || sampleMaterial != centerMaterial)
            continue;
        float3 sampleNormal = GIUnpackSurfaceNormal(packedSurface);
        float normalAgreement = saturate(dot(centerNormal, sampleNormal));
        if (normalAgreement < 0.70)
            continue;

        uint sampleAddress = (uint)physicalBrick * GI_CELLS_PER_BRICK + localCell;
        uint sampleValidity = hitLayer == 0u
            ? _GIStaticValidity[sampleAddress] : _GIDynamicValidity[sampleAddress];
        float sampleConfidence = (sampleValidity & 0xffu) / 255.0;
        if (sampleConfidence < 0.125)
            continue;

        float3 axisWeight = lerp(1.0 - fraction, fraction, float3(x, y, z));
        float weight = axisWeight.x * axisWeight.y * axisWeight.z *
                       pow(normalAgreement, 4.0) * sampleConfidence;
        accumulated += GIReadDirectionalCell(physicalBrick, localCell, hitLayer,
                                               outgoingDirection) * weight;
        accumulatedWeight += weight;
    }
    // Thin or highly curved surfaces may have only the traced voxel represented in this level.
    // Preserve that valid result instead of turning a sparse trilinear footprint into sky.
    if (accumulatedWeight <= 1e-5)
    {
        accumulated = GIReadDirectionalCell(centerBrick, centerLocalCell, hitLayer,
                                             outgoingDirection);
        accumulatedWeight = confidence;
    }
    cacheWeight = accumulatedWeight;
    return accumulatedWeight > 1e-5 ? accumulated / accumulatedWeight : 0.0;
}

float3 GIUniformHemisphereDirection(float3 normal, float2 randomValue)
{
    float cosTheta = randomValue.x;
    float sinTheta = sqrt(saturate(1.0 - cosTheta * cosTheta));
    float phi = TWO_PI * randomValue.y;
    float3 tangent;
    float3 bitangent;
    GIBasis(normal, tangent, bitangent);
    return normalize(tangent * (sinTheta * cos(phi)) +
                     bitangent * (sinTheta * sin(phi)) + normal * cosTheta);
}

bool GITryReadCachedRadianceAtLevel(
    uint hitLayer, uint levelIndex, float3 hitPosition, uint expectedIdentity,
    uint expectedMaterial, float3 referenceNormal, float3 outgoingDirection,
    out float3 radiance, out float cacheWeight)
{
    radiance = 0.0;
    cacheWeight = 0.0;
    if (levelIndex >= GI_CLIPMAP_LEVEL_COUNT)
        return false;

    GIClipmapLevelData level = _GIClipmapLevels[levelIndex];
    int3 centerWorldCell = (int3)floor(hitPosition / level.cellSize);
    [unroll]
    for (uint offsetIndex = 0u; offsetIndex < 7u; offsetIndex++)
    {
        int3 worldCell = centerWorldCell + GIFilterOffset(offsetIndex);
        int physicalBrick = -1;
        uint localCell = 0u;
        bool occupied = hitLayer == 0u
            ? GIReadOccupancy(level, _GIStaticPageTable, _GIStaticOccupancy,
                              worldCell, physicalBrick, localCell)
            : GIReadOccupancy(level, _GIDynamicPageTable, _GIDynamicOccupancy,
                              worldCell, physicalBrick, localCell);
        if (!occupied)
            continue;

        uint address = (uint)physicalBrick * GI_SURFACE_WORDS_PER_BRICK + localCell;
        uint packedSurface = hitLayer == 0u
            ? _GIStaticSurface[address] : _GIDynamicSurface[address];
        uint identity = hitLayer == 0u
            ? _GIStaticSurfaceIdentity[address] : _GIDynamicSurfaceIdentity[address];
        uint material = (packedSurface >> 16u) & 0x7fffu;
        float3 normal = GIUnpackSurfaceNormal(packedSurface);
        if (identity != expectedIdentity || material != expectedMaterial ||
            dot(normal, referenceNormal) < 0.65)
            continue;

        radiance = GIReadCachedRadiance(
            physicalBrick, localCell, worldCell, identity, hitLayer, levelIndex,
            hitPosition, outgoingDirection, cacheWeight);
        if (cacheWeight > 1e-5)
            return true;
    }
    return false;
}

bool GIRayDepthBehindScene(float rayDepth, float sceneDepth, float thickness)
{
#if UNITY_REVERSED_Z
    return rayDepth <= sceneDepth + thickness;
#else
    return rayDepth >= sceneDepth - thickness;
#endif
}

float2 GIPackHistoryNormal(float3 normal)
{
    return PackNormalOctQuadEncode(normalize(normal)) * 0.5 + 0.5;
}

float3 GIUnpackHistoryNormal(float2 packed)
{
    return normalize(UnpackNormalOctQuadEncode(packed * 2.0 - 1.0));
}

uint GIMaterialSignature(float2 uv)
{
    uint2 pixel = GIFullPixelFromUv(uv);
    float4 g0 = _GIGBuffer0.Load(int3(pixel, 0));
    float4 g2 = _GIGBuffer2.Load(int3(pixel, 0));
    // Geometry history is RGBA16F, so keep the value directly representable instead of
    // hashing a high precision signature down to 11 bits. Coarse bins are deliberately
    // stable across neighbouring texels of the same material while red/cyan/neutral
    // surfaces remain distinct.
    uint flags = (uint)round(saturate(g0.a) * 7.0);
    uint3 albedo = (uint3)round(saturate(g0.rgb) * 3.0);
    uint roughness = (uint)round(saturate(1.0 - g2.a) * 3.0);
    return flags | (albedo.r << 3u) | (albedo.g << 5u) |
           (albedo.b << 7u) | (roughness << 9u);
}

uint GIBrickLightCount(uint hitLayer, int hitPhysicalBrick)
{
    if (hitPhysicalBrick < 0 || _GIMaxLightsPerBrick == 0u)
        return 0u;
    uint count = hitLayer == 0u
        ? _GIStaticLightCounts[(uint)hitPhysicalBrick]
        : _GIDynamicLightCounts[(uint)hitPhysicalBrick];
    return min(count, _GIMaxLightsPerBrick);
}

uint GIBrickLightIndex(uint hitLayer, int hitPhysicalBrick, uint slot)
{
    uint address = (uint)hitPhysicalBrick * _GIMaxLightsPerBrick + slot;
    return hitLayer == 0u
        ? _GIStaticLightIndices[address]
        : _GIDynamicLightIndices[address];
}

float3 GIAnalyticDiffuseHit(uint packedSurface, float3 hitPosition, float3 hitNormal,
                            uint hitLayer, int hitPhysicalBrick, uint hitLocalCell,
                            uint hitLevel)
{
    float3 baseColor;
    float3 emissive;
    float roughness;
    float metallic;
    GIEvaluateHitMaterial(packedSurface, hitLayer, hitPhysicalBrick, hitLocalCell,
                          hitLevel, baseColor, emissive, roughness, metallic);

    float3 diffuseColor = baseColor * (1.0 - metallic);
    float3 mainDirection = normalize(-_GIMainLightDirection);
    float mainNoL = saturate(dot(hitNormal, mainDirection));
    // Match the persistent cache's energy contract. Main visibility is unavailable while
    // the cache is pending, so use a conservative half-visible estimate instead of
    // misclassifying this occupied cell as an unoccluded sky miss.
    float3 directIrradiance = GIEvaluateTODDiffuseSky(hitNormal) * _GISkyIrradianceScale +
        _GIMainLightColor * (mainNoL * _GIMainLightBounceScale * 0.5);

    uint brickLightCount = GIBrickLightCount(hitLayer, hitPhysicalBrick);
    [loop]
    for (uint brickLight = 0u; brickLight < brickLightCount; brickLight++)
    {
        uint lightIndex = GIBrickLightIndex(hitLayer, hitPhysicalBrick, brickLight);
        if (lightIndex >= _GILocalLightCount)
            continue;
        GILocalLightData light = _GILocalLights[lightIndex];
        float3 lightDirection;
        float lightDistance;
        float attenuation = GILocalLightAttenuation(
            light, hitPosition, lightDirection, lightDistance);
        float noL = saturate(dot(hitNormal, lightDirection));
        directIrradiance += GILocalLightRadiance(light) *
            (attenuation * noL * max(0.0, light.parameters.w));
    }
    return emissive + diffuseColor * directIrradiance * (1.0 / PI);
}

void GITraceRadianceDetailed(float3 origin, float3 direction, uint preferredLevel,
                             out float3 radiance, out float hitDistance,
                             out float3 hitNormal, out float hitValid, out uint2 stableId)
{
    hitDistance = _GIMaxTraceDistance;
    hitNormal = -direction;
    hitValid = 0.0;
    radiance = GIEvaluateTODSky(direction);
    stableId = 0u;
    hitDistance = _GIMaxTraceDistance;
    float hitT = _GIMaxTraceDistance;
    uint packedSurface = 0u;
    uint hitIdentity = 0u;
    uint hitLayer = 0u;
    uint hitLevel = 0u;
    int3 hitWorldCell = 0;
    int hitPhysicalBrick = -1;
    uint hitLocalCell = 0u;
    uint traceSteps = 0u;
    bool worldHit = GITraceUnifiedClipmaps(
        _GIClipmapLevels,
        _GIStaticPageTable, _GIStaticOccupancy, _GIStaticSurface, _GIStaticSurfaceIdentity,
        _GIStaticDistance,
        _GIDynamicPageTable, _GIDynamicOccupancy, _GIDynamicSurface, _GIDynamicSurfaceIdentity,
        _GIDynamicDistance,
        origin, direction, _GIMaxTraceDistance, preferredLevel, 0u,
        hitT, packedSurface, hitIdentity, hitLayer, hitLevel, hitWorldCell, hitPhysicalBrick,
        hitLocalCell, traceSteps);
    if (_GIEnableTraceCounters != 0u)
    {
        InterlockedAdd(_GITraceCounters[2], traceSteps);
        InterlockedAdd(_GITraceCounters[worldHit ? 3u : 4u], 1u);
    }
    if (worldHit)
    {
        uint surfaceAddress = (uint)hitPhysicalBrick * GI_SURFACE_WORDS_PER_BRICK + hitLocalCell;
        stableId = hitLayer == 0u ? _GIStaticSurfaceStableId[surfaceAddress]
                                  : _GIDynamicSurfaceStableId[surfaceAddress];
        hitDistance = hitT;
        hitNormal = GIUnpackSurfaceNormal(packedSurface);
        hitValid = 1.0;
        float3 hitPosition = origin + direction * hitT;
        if (_GIDebugHitMaterialColor != 0u)
        {
            uint materialIndex = (packedSurface >> 16u) & 0x7fffu;
            // Magenta is an invalid material-table reference, rather than a lighting value.
            radiance = materialIndex < _GIMaterialCount
                ? _GIMaterials[materialIndex].baseColor.rgb
                : float3(1.0, 0.0, 1.0);
            return;
        }
        float cacheWeight = 0.0;
        // FXC's definite-assignment analysis does not follow the hit predicate through the
        // unified trace helper. Keep an explicit fallback value for D3D11 as well as DX12.
        float3 cachedRadiance = 0.0;
        cachedRadiance = GIReadCachedRadiance(
            hitPhysicalBrick, hitLocalCell, hitWorldCell, hitIdentity, hitLayer, hitLevel,
            hitPosition, -direction, cacheWeight);
        // Clipmap levels overlap, but selecting one cache abruptly makes a world-space
        // ring/band wherever a ray leaves the finer volume. Fade the fine cache into the
        // matching coarser surface over four cells near the level boundary.
        if (hitLevel + 1u < GI_CLIPMAP_LEVEL_COUNT)
        {
            GIClipmapLevelData hitLevelData = _GIClipmapLevels[hitLevel];
            float3 boundsMin = (float3)(hitLevelData.originBrick * GI_BRICK_SIZE) *
                               hitLevelData.cellSize;
            float3 boundsMax = boundsMin + GI_CLIPMAP_RESOLUTION * hitLevelData.cellSize;
            float3 edgeCells = min(hitPosition - boundsMin, boundsMax - hitPosition) /
                               max(hitLevelData.cellSize, 1e-5);
            float fineWeight = smoothstep(
                1.0, 4.0, min(edgeCells.x, min(edgeCells.y, edgeCells.z)));
            if (fineWeight < 0.999)
            {
                uint materialIndex = (packedSurface >> 16u) & 0x7fffu;
                float3 referenceNormal = GIUnpackSurfaceNormal(packedSurface);
                float3 coarseRadiance;
                float coarseWeight;
                if (GITryReadCachedRadianceAtLevel(
                        hitLayer, hitLevel + 1u, hitPosition, hitIdentity,
                        materialIndex, referenceNormal, -direction,
                        coarseRadiance, coarseWeight))
                {
                    cachedRadiance = cacheWeight > 1e-5
                        ? lerp(coarseRadiance, cachedRadiance, fineWeight)
                        : coarseRadiance;
                    cacheWeight = max(cacheWeight, coarseWeight);
                }
            }
        }
        // Geometry can become traceable before its radiance cache has received a valid
        // update.  It is still an occupied hit, never a sky miss: use the same analytic
        // direct-light contract as the cache until the persistent payload is ready.
        if (cacheWeight > 1e-5)
        {
            radiance = cachedRadiance;
            if (_GIEnableTraceCounters != 0u)
                InterlockedAdd(_GITraceCounters[5], 1u);
        }
        else
        {
            radiance = GIAnalyticDiffuseHit(
                packedSurface, hitPosition, hitNormal, hitLayer, hitPhysicalBrick,
                hitLocalCell, hitLevel);
            if (_GIEnableTraceCounters != 0u)
                InterlockedAdd(_GITraceCounters[6], 1u);
        }
    }
}

float3 GITraceRadiance(float3 origin, float3 direction, uint preferredLevel)
{
    float ignoredDistance = _GIMaxTraceDistance;
    float3 ignoredNormal;
    float ignoredHitValid;
    uint2 ignoredStableId;
    float3 radiance = 0.0;
    GITraceRadianceDetailed(origin, direction, preferredLevel, radiance, ignoredDistance,
                            ignoredNormal, ignoredHitValid, ignoredStableId);
    return radiance;
}

float3 GIEvaluateHitGgx(float3 normal, float3 viewDirection, float3 lightDirection,
                        float3 f0, float roughness)
{
    float noV = saturate(dot(normal, viewDirection));
    float noL = saturate(dot(normal, lightDirection));
    if (noV <= 1e-4 || noL <= 1e-4)
        return 0.0;
    float3 halfVector = normalize(viewDirection + lightDirection);
    float noH = saturate(dot(normal, halfVector));
    float voH = saturate(dot(viewDirection, halfVector));
    float alpha = max(roughness * roughness, 0.0025);
    float alpha2 = alpha * alpha;
    float dDenominator = max(PI * pow(noH * noH * (alpha2 - 1.0) + 1.0, 2.0), 1e-5);
    float distribution = alpha2 / dDenominator;
    float k = pow(roughness + 1.0, 2.0) * 0.125;
    float geometryV = noV / lerp(noV, 1.0, k);
    float geometryL = noL / lerp(noL, 1.0, k);
    float3 fresnel = f0 + (1.0 - f0) * pow(1.0 - voH, 5.0);
    return fresnel * distribution * geometryV * geometryL * noL /
           max(4.0 * noV * noL, 1e-4);
}

float3 GIShadeSpecularWorldHit(uint packedSurface, float3 hitPosition, float3 hitNormal,
                               float3 viewDirection, float3 cachedRadiance, float cacheWeight,
                               uint hitLayer, int hitPhysicalBrick, uint hitLocalCell,
                               uint hitLevel, bool useExactMaterial,
                               uint exactMaterialIndex, float2 exactUv)
{
    float3 baseColor;
    float3 emissive;
    float roughness;
    float metallic;
    if (useExactMaterial)
        GIEvaluateMaterialAtUv(exactMaterialIndex, exactUv, hitLevel,
                               baseColor, emissive, roughness, metallic);
    else
        GIEvaluateHitMaterial(packedSurface, hitLayer, hitPhysicalBrick, hitLocalCell,
                              hitLevel, baseColor, emissive, roughness, metallic);

    // Cache radiance is the low-frequency diffuse/emissive base.  If geometry became
    // traceable before its cache update, use the shared analytic fallback so diffuse and
    // glossy paths cannot disagree about sky, main-light, local-light, or material energy.
    float3 outgoing = cacheWeight > 1e-5
        ? cachedRadiance
        : GIAnalyticDiffuseHit(
            packedSurface, hitPosition, hitNormal, hitLayer, hitPhysicalBrick,
            hitLocalCell, hitLevel);
    float3 mainDirection = normalize(-_GIMainLightDirection);
    float3 f0 = lerp(0.04.xxx, baseColor, metallic);
    outgoing += _GIMainLightColor *
                GIEvaluateHitGgx(hitNormal, viewDirection, mainDirection, f0, roughness);

    uint brickLightCount = GIBrickLightCount(hitLayer, hitPhysicalBrick);
    [loop]
    for (uint brickLight = 0u; brickLight < brickLightCount; brickLight++)
    {
        uint lightIndex = GIBrickLightIndex(hitLayer, hitPhysicalBrick, brickLight);
        if (lightIndex >= _GILocalLightCount)
            continue;
        GILocalLightData light = _GILocalLights[lightIndex];
        float3 lightDirection;
        float lightDistance;
        float attenuation = GILocalLightAttenuation(
            light, hitPosition, lightDirection, lightDistance);
        outgoing += GILocalLightRadiance(light) *
                    (attenuation * max(0.0, light.parameters.w)) *
                    GIEvaluateHitGgx(
                        hitNormal, viewDirection, lightDirection, f0, roughness);
    }
    return max(0.0, outgoing);
}

bool GIRefinementAlphaPass(uint materialIndex, float2 uv, uint levelIndex)
{
    if (materialIndex >= _GIMaterialCount)
        return true;
    GIMaterialData material = _GIMaterials[materialIndex];
    if ((material.flags & GI_MATERIAL_ALPHA_TESTED) == 0u)
        return true;
    float4 baseSample = 1.0;
    float4 maskSample = 1.0;
    float mipLevel = min((float)levelIndex, 6.0);
    if (materialIndex < _GITextureSliceCount &&
        (material.flags & GI_MATERIAL_HAS_BASE_MAP) != 0u)
        baseSample = _GIBaseColorTextures.SampleLevel(
            sampler_LinearRepeat,
            float3(uv * material.baseMapST.xy + material.baseMapST.zw, materialIndex), mipLevel);
    if (materialIndex < _GITextureSliceCount &&
        (material.flags & GI_MATERIAL_HAS_MASK_MAP) != 0u)
        maskSample = _GIMaskTextures.SampleLevel(
            sampler_LinearRepeat,
            float3(uv * material.maskMapST.xy + material.maskMapST.zw, materialIndex), mipLevel);
    uint source = GIMaterialAlphaSource(material);
    float alpha = baseSample.a * material.baseColor.a * material.surface.z;
    if (source >= 1u && source <= 4u)
    {
        uint channel = source - 1u;
        alpha = GISelectMaterialChannel(maskSample, channel, material.surface.z);
        if (channel == GIMaterialOpacityChannel(material))
            alpha = alpha * material.maskRemap1.x + material.maskRemap1.y;
    }
    else if (source == 5u)
        alpha = material.surface.z;
    return alpha >= material.surface.w;
}

bool GIScreenNanitePageReady(uint pageId, uint expectedMeshIndex,
                             out GINaniteResidentPageEntry resident)
{
    resident = (GINaniteResidentPageEntry)0;
    if (pageId >= _GINanitePageCount)
        return false;
    GINanitePageTableEntry page = _GINanitePageTable[pageId];
    resident = _GINaniteResidentPageTable[pageId];
    uint residencyWord = _GINaniteResidencyBits[pageId >> 5u];
    return page.meshIndex == expectedMeshIndex &&
           page.generation == _GINanitePoolGeneration &&
           resident.generation == _GINanitePoolGeneration &&
           (page.flags & 1u) != 0u &&
           (resident.flags & _GINaniteGeometryReadyFlag) != 0u &&
           (residencyWord & (1u << (pageId & 31u))) != 0u;
}

bool GILoadRefinementTriangle(
    GIGeometryStreamData range, uint primitiveKey,
    out float3 p0, out float3 p1, out float3 p2,
    out float2 uv0, out float2 uv1, out float2 uv2, out uint subMesh)
{
    p0 = p1 = p2 = 0.0;
    uv0 = uv1 = uv2 = 0.0;
    subMesh = 0u;
    if ((primitiveKey & 0x80000000u) != 0u &&
        (range.flags & GI_GEOMETRY_STREAM_NANITE_RESIDENT_PAGES) != 0u)
    {
        uint pageId = (primitiveKey >> 14u) & 0x1ffffu;
        uint localTriangle = primitiveKey & 0x3fffu;
        GINaniteResidentPageEntry resident;
        if (!GIScreenNanitePageReady(pageId, range.padding0, resident) ||
            localTriangle >= resident.indexCount / 3u)
            return false;
        uint firstIndex = resident.indexBase + localTriangle * 3u;
        uint i0 = _GINaniteResidentIndices[firstIndex];
        uint i1 = _GINaniteResidentIndices[firstIndex + 1u];
        uint i2 = _GINaniteResidentIndices[firstIndex + 2u];
        GINaniteResidentVertex v0 = _GINaniteResidentVertices[i0];
        GINaniteResidentVertex v1 = _GINaniteResidentVertices[i1];
        GINaniteResidentVertex v2 = _GINaniteResidentVertices[i2];
        p0 = v0.position; p1 = v1.position; p2 = v2.position;
        uv0 = v0.uv; uv1 = v1.uv; uv2 = v2.uv;
        subMesh = _GINaniteResidentTriangleSubMeshes[firstIndex / 3u];
        return true;
    }
    if (primitiveKey >= range.triangleCount)
        return false;
    uint firstIndex = range.indexOffset + primitiveKey * 3u;
    uint i0 = _GIIndices[firstIndex];
    uint i1 = _GIIndices[firstIndex + 1u];
    uint i2 = _GIIndices[firstIndex + 2u];
    p0 = _GIVertices[i0]; p1 = _GIVertices[i1]; p2 = _GIVertices[i2];
    uv0 = _GIUVs[i0]; uv1 = _GIUVs[i1]; uv2 = _GIUVs[i2];
    subMesh = _GITriangleSubMeshes[range.triangleOffset + primitiveKey];
    return true;
}

bool GIRayTriangleCandidate(uint instanceIndex, uint triangleIndex,
                            float3 origin, float3 direction, float minimumT, float maximumT,
                            uint levelIndex, out float hitT, out float3 hitNormal,
                            out uint materialIndex, out uint materialSlot,
                            out float2 barycentrics, out uint2 stableId)
{
    hitT = maximumT;
    hitNormal = -direction;
    materialIndex = 0u;
    materialSlot = 0u;
    barycentrics = 0.0;
    stableId = 0u;
    if (instanceIndex >= _GIInstanceCount)
        return false;
    GIInstanceData instance = _GIInstances[instanceIndex];
    GIGeometryStreamData range = _GIGeometryRanges[instance.geometryIndex];
    float3 localP0, localP1, localP2;
    float2 uv0, uv1, uv2;
    uint subMesh;
    if (!GILoadRefinementTriangle(
            range, triangleIndex, localP0, localP1, localP2,
            uv0, uv1, uv2, subMesh))
        return false;
    float3 p0 = mul(instance.localToWorld, float4(localP0, 1.0)).xyz;
    float3 p1 = mul(instance.localToWorld, float4(localP1, 1.0)).xyz;
    float3 p2 = mul(instance.localToWorld, float4(localP2, 1.0)).xyz;
    float3 edge1 = p1 - p0;
    float3 edge2 = p2 - p0;
    float3 pvec = cross(direction, edge2);
    float determinant = dot(edge1, pvec);
    bool twoSided = (instance.flags & GI_INSTANCE_TWO_SIDED) != 0u;
    if ((!twoSided && determinant <= 1e-7) || (twoSided && abs(determinant) <= 1e-7))
        return false;
    float inverseDeterminant = rcp(determinant);
    float3 tvec = origin - p0;
    float baryU = dot(tvec, pvec) * inverseDeterminant;
    if (baryU < -1e-4 || baryU > 1.0001)
        return false;
    float3 qvec = cross(tvec, edge1);
    float baryV = dot(direction, qvec) * inverseDeterminant;
    if (baryV < -1e-4 || baryU + baryV > 1.0001)
        return false;
    float candidateT = dot(edge2, qvec) * inverseDeterminant;
    if (candidateT < minimumT || candidateT > maximumT)
        return false;
    uint bindingOffset = min(subMesh, max(1u, instance.materialBindingCount) - 1u);
    materialIndex = _GIMaterialBindings[instance.firstMaterialBinding + bindingOffset].materialIndex;
    float baryW = 1.0 - baryU - baryV;
    float2 uv = uv0 * baryW + uv1 * baryU + uv2 * baryV;
    if (!GIRefinementAlphaPass(materialIndex, uv, levelIndex))
        return false;
    hitT = candidateT;
    materialSlot = subMesh;
    barycentrics = float2(baryU, baryV);
    hitNormal = normalize(cross(edge1, edge2));
    if (twoSided && dot(hitNormal, direction) > 0.0)
        hitNormal = -hitNormal;
    GIGeometryData geometry = _GIGeometries[instance.geometryIndex];
    uint surfaceKey = geometry.sourceObjectId * 0x9e3779b9u ^ triangleIndex * 0x85ebca6bu ^
                      geometry.sourceRevision * 0xc2b2ae35u ^ instance.revision * 0x27d4eb2fu ^
                      instance.transformSignature * 0x165667b1u;
    surfaceKey ^= surfaceKey >> 16u;
    surfaceKey *= 0x7feb352du;
    surfaceKey ^= surfaceKey >> 15u;
    surfaceKey *= 0x846ca68bu;
    surfaceKey ^= surfaceKey >> 16u;
    // High bit is reserved by the Clipmap representation for complete-mip proxy IDs.
    // Authoritative BVH triangles always publish an exact (non-proxy) surface key.
    surfaceKey &= 0x7fffffffu;
    stableId = uint2(instance.objectId, surfaceKey);
    return true;
}

bool GIRayAabb(float3 origin, float3 direction, float3 boundsMin, float3 boundsMax,
               float minimumT, float maximumT, out float entryT)
{
    float3 safeDirection = float3(
        abs(direction.x) < 1e-8 ? (direction.x < 0.0 ? -1e-8 : 1e-8) : direction.x,
        abs(direction.y) < 1e-8 ? (direction.y < 0.0 ? -1e-8 : 1e-8) : direction.y,
        abs(direction.z) < 1e-8 ? (direction.z < 0.0 ? -1e-8 : 1e-8) : direction.z);
    float3 inverseDirection = rcp(safeDirection);
    float3 t0 = (boundsMin - origin) * inverseDirection;
    float3 t1 = (boundsMax - origin) * inverseDirection;
    float3 nearAxis = min(t0, t1);
    float3 farAxis = max(t0, t1);
    entryT = max(minimumT, max(nearAxis.x, max(nearAxis.y, nearAxis.z)));
    float exitT = min(maximumT, min(farAxis.x, min(farAxis.y, farAxis.z)));
    return exitT >= entryT;
}

void GITransformLocalBounds(GIInstanceData instance, float3 localMin, float3 localMax,
                            out float3 worldMin, out float3 worldMax)
{
    float3 center = (localMin + localMax) * 0.5;
    float3 extent = max(0.0, (localMax - localMin) * 0.5);
    float3 worldCenter = mul(instance.localToWorld, float4(center, 1.0)).xyz;
    float3 worldExtent = mul(abs((float3x3)instance.localToWorld), extent);
    worldMin = worldCenter - worldExtent;
    worldMax = worldCenter + worldExtent;
}

bool GITraceInstanceBlas(
    uint instanceIndex, float3 origin, float3 direction, float minimumT, float maximumT,
    uint levelIndex, inout uint testedTriangles,
    out float hitT, out float3 hitNormal, out uint materialIndex, out uint materialSlot,
    out float2 barycentrics, out uint triangleIndex, out uint2 stableId)
{
    hitT = maximumT;
    hitNormal = -direction;
    materialIndex = 0u;
    materialSlot = 0u;
    barycentrics = 0.0;
    triangleIndex = 0xffffffffu;
    stableId = 0u;
    if (instanceIndex >= _GIInstanceCount)
        return false;
    GIInstanceData instance = _GIInstances[instanceIndex];
    GIBvhRange range = _GIBvhRanges[instance.geometryIndex];
    if (range.nodeCount == 0u || range.primitiveCount == 0u)
        return false;

    bool found = false;
    uint stack[32];
    uint stackSize = 1u;
    stack[0] = range.rootNode;
    [loop]
    while (stackSize > 0u)
    {
        uint nodeIndex = stack[--stackSize];
        if (nodeIndex < range.rootNode || nodeIndex >= range.rootNode + range.nodeCount)
            continue;
        GIBvhNode node = _GIBvhNodes[nodeIndex];
        float3 worldMin, worldMax;
        GITransformLocalBounds(instance, node.boundsMin, node.boundsMax, worldMin, worldMax);
        float entryT;
        if (!GIRayAabb(origin, direction, worldMin, worldMax, minimumT,
                       found ? hitT : maximumT, entryT))
            continue;
        if (node.primitiveCount == 0u)
        {
            if (stackSize + 2u <= 32u)
            {
                uint leftIndex = node.leftFirst;
                uint rightIndex = node.leftFirst + 1u;
                GIBvhNode leftNode = _GIBvhNodes[leftIndex];
                GIBvhNode rightNode = _GIBvhNodes[rightIndex];
                float3 leftMin, leftMax, rightMin, rightMax;
                GITransformLocalBounds(instance, leftNode.boundsMin, leftNode.boundsMax,
                                       leftMin, leftMax);
                GITransformLocalBounds(instance, rightNode.boundsMin, rightNode.boundsMax,
                                       rightMin, rightMax);
                float leftEntry, rightEntry;
                bool hitLeft = GIRayAabb(origin, direction, leftMin, leftMax, minimumT,
                                         found ? hitT : maximumT, leftEntry);
                bool hitRight = GIRayAabb(origin, direction, rightMin, rightMax, minimumT,
                                          found ? hitT : maximumT, rightEntry);
                if (hitLeft && hitRight)
                {
                    uint nearIndex = leftEntry <= rightEntry ? leftIndex : rightIndex;
                    uint farIndex = leftEntry <= rightEntry ? rightIndex : leftIndex;
                    stack[stackSize++] = farIndex;
                    stack[stackSize++] = nearIndex;
                }
                else if (hitLeft)
                    stack[stackSize++] = leftIndex;
                else if (hitRight)
                    stack[stackSize++] = rightIndex;
            }
            continue;
        }

        [loop]
        for (uint leafIndex = 0u; leafIndex < node.primitiveCount; leafIndex++)
        {
            GIBvhPrimitive primitive = _GIBvhPrimitives[node.leftFirst + leafIndex];
            uint firstTriangle = primitive.firstTriangle;
            uint triangleCount = primitive.triangleCount;
            if ((primitive.flags & GI_BVH_PRIMITIVE_NANITE_PAGE) != 0u)
            {
                GIGeometryStreamData geometryRange = _GIGeometryRanges[instance.geometryIndex];
                GINaniteResidentPageEntry resident;
                if (!GIScreenNanitePageReady(primitive.primitiveKey, geometryRange.padding0, resident))
                    continue;
                firstTriangle = min(firstTriangle, resident.indexCount / 3u);
                triangleCount = min(triangleCount, resident.indexCount / 3u - firstTriangle);
                triangleCount = min(triangleCount, 0x4000u - min(firstTriangle, 0x4000u));
            }
            [loop]
            for (uint localTriangle = 0u; localTriangle < triangleCount; localTriangle++)
            {
                uint candidateLimit = (primitive.flags & GI_BVH_PRIMITIVE_NANITE_PAGE) != 0u
                    ? max(128u, _GITriangleRefinementCandidateLimit)
                    : max(1u, _GITriangleRefinementCandidateLimit);
                if (testedTriangles++ >= candidateLimit)
                    return found;
                uint pageTriangle = firstTriangle + localTriangle;
                uint candidateKey = (primitive.flags & GI_BVH_PRIMITIVE_NANITE_PAGE) != 0u
                    ? (0x80000000u | ((primitive.primitiveKey & 0x1ffffu) << 14u) |
                       (pageTriangle & 0x3fffu))
                    : pageTriangle;
                float candidateT;
                float3 candidateNormal;
                uint candidateMaterial, candidateMaterialSlot;
                float2 candidateBarycentrics;
                uint2 candidateStableId;
                if (GIRayTriangleCandidate(
                        instanceIndex, candidateKey, origin, direction, minimumT,
                        found ? hitT : maximumT, levelIndex, candidateT, candidateNormal,
                        candidateMaterial, candidateMaterialSlot, candidateBarycentrics,
                        candidateStableId))
                {
                    found = true;
                    hitT = candidateT;
                    hitNormal = candidateNormal;
                    materialIndex = candidateMaterial;
                    materialSlot = candidateMaterialSlot;
                    barycentrics = candidateBarycentrics;
                    triangleIndex = candidateKey;
                    stableId = candidateStableId;
                }
            }
        }
    }
    return found;
}

bool GITraceSceneBvh(
    float3 origin, float3 direction, float minimumT, float maximumT, uint levelIndex,
    out float hitT, out float3 hitNormal, out uint materialIndex, out uint materialSlot,
    out float2 barycentrics, out uint instanceIndex, out uint triangleIndex,
    out uint2 stableId)
{
    hitT = maximumT;
    hitNormal = -direction;
    materialIndex = materialSlot = 0u;
    barycentrics = 0.0;
    instanceIndex = triangleIndex = 0xffffffffu;
    stableId = 0u;
    if (_GITlasNodeCount == 0u)
        return false;

    bool found = false;
    uint testedTriangles = 0u;
    uint stack[32];
    uint stackSize = 1u;
    stack[0] = _GITlasNodeOffset;
    [loop]
    while (stackSize > 0u)
    {
        uint nodeIndex = stack[--stackSize];
        if (nodeIndex < _GITlasNodeOffset ||
            nodeIndex >= _GITlasNodeOffset + _GITlasNodeCount)
            continue;
        GIBvhNode node = _GIBvhNodes[nodeIndex];
        float entryT;
        if (!GIRayAabb(origin, direction, node.boundsMin, node.boundsMax, minimumT,
                       found ? hitT : maximumT, entryT))
            continue;
        if (node.primitiveCount == 0u)
        {
            if (stackSize + 2u <= 32u)
            {
                uint leftIndex = node.leftFirst;
                uint rightIndex = node.leftFirst + 1u;
                GIBvhNode leftNode = _GIBvhNodes[leftIndex];
                GIBvhNode rightNode = _GIBvhNodes[rightIndex];
                float leftEntry, rightEntry;
                bool hitLeft = GIRayAabb(origin, direction, leftNode.boundsMin,
                                         leftNode.boundsMax, minimumT,
                                         found ? hitT : maximumT, leftEntry);
                bool hitRight = GIRayAabb(origin, direction, rightNode.boundsMin,
                                          rightNode.boundsMax, minimumT,
                                          found ? hitT : maximumT, rightEntry);
                if (hitLeft && hitRight)
                {
                    uint nearIndex = leftEntry <= rightEntry ? leftIndex : rightIndex;
                    uint farIndex = leftEntry <= rightEntry ? rightIndex : leftIndex;
                    stack[stackSize++] = farIndex;
                    stack[stackSize++] = nearIndex;
                }
                else if (hitLeft)
                    stack[stackSize++] = leftIndex;
                else if (hitRight)
                    stack[stackSize++] = rightIndex;
            }
            continue;
        }
        [loop]
        for (uint leafIndex = 0u; leafIndex < node.primitiveCount; leafIndex++)
        {
            GIBvhPrimitive primitive = _GIBvhPrimitives[node.leftFirst + leafIndex];
            uint candidateInstance = primitive.primitiveKey;
            float candidateT;
            float3 candidateNormal;
            uint candidateMaterial, candidateMaterialSlot, candidateTriangle;
            float2 candidateBarycentrics;
            uint2 candidateStableId;
            if (GITraceInstanceBlas(
                    candidateInstance, origin, direction, minimumT,
                    found ? hitT : maximumT, levelIndex, testedTriangles,
                    candidateT, candidateNormal, candidateMaterial, candidateMaterialSlot,
                    candidateBarycentrics, candidateTriangle, candidateStableId))
            {
                found = true;
                hitT = candidateT;
                hitNormal = candidateNormal;
                materialIndex = candidateMaterial;
                materialSlot = candidateMaterialSlot;
                barycentrics = candidateBarycentrics;
                instanceIndex = candidateInstance;
                triangleIndex = candidateTriangle;
                stableId = candidateStableId;
            }
        }
    }
    return found;
}

bool GIRefineClipmapHit(float3 origin, float3 direction, float voxelHitT,
                        uint hitLayer, uint hitLevel, int3 hitWorldCell,
                        out float refinedT, out float3 refinedNormal,
                        out uint refinedMaterial, out uint refinedMaterialSlot,
                        out float2 refinedBarycentrics, out uint refinedInstanceIndex,
                        out uint refinedTriangleIndex, out uint2 refinedStableId)
{
    refinedT = voxelHitT;
    refinedNormal = -direction;
    refinedMaterial = 0u;
    refinedMaterialSlot = 0u;
    refinedBarycentrics = 0.0;
    refinedInstanceIndex = 0xffffffffu;
    refinedTriangleIndex = 0xffffffffu;
    refinedStableId = 0u;
    GIClipmapLevelData level = _GIClipmapLevels[hitLevel];
    float minimumT = max(0.0, voxelHitT - level.cellSize * 2.0);
    float maximumT = min(_GIMaxTraceDistance, voxelHitT + level.cellSize * 2.5);
    if (GITraceSceneBvh(
            origin, direction, minimumT, maximumT, hitLevel,
            refinedT, refinedNormal, refinedMaterial, refinedMaterialSlot,
            refinedBarycentrics, refinedInstanceIndex, refinedTriangleIndex,
            refinedStableId))
        return true;
    bool found = false;
    uint candidateCount = 0u;
    [loop]
    for (int z = -1; z <= 1; z++)
    [loop]
    for (int y = -1; y <= 1; y++)
    [loop]
    for (int x = -1; x <= 1; x++)
    {
        int3 cell = hitWorldCell + int3(x, y, z);
        int physicalBrick;
        uint localCell;
        bool occupied = hitLayer == 0u
            ? GIReadOccupancy(level, _GIStaticPageTable, _GIStaticOccupancy,
                              cell, physicalBrick, localCell)
            : GIReadOccupancy(level, _GIDynamicPageTable, _GIDynamicOccupancy,
                              cell, physicalBrick, localCell);
        if (!occupied)
            continue;
        uint address = (uint)physicalBrick * GI_SURFACE_WORDS_PER_BRICK + localCell;
        uint identity = hitLayer == 0u ? _GIStaticSurfaceIdentity[address]
                                      : _GIDynamicSurfaceIdentity[address];
        uint triangleIndex = hitLayer == 0u ? _GIStaticSurfacePrimitive[address]
                                           : _GIDynamicSurfacePrimitive[address];
        if (identity == 0u)
            continue;
        if (candidateCount++ >= max(1u, _GITriangleRefinementCandidateLimit))
            return found;
        float candidateT;
        float3 candidateNormal;
        uint candidateMaterial;
        uint candidateMaterialSlot;
        float2 candidateBarycentrics;
        uint2 candidateStableId;
        if (GIRayTriangleCandidate(identity - 1u, triangleIndex, origin, direction,
                                   minimumT, found ? refinedT : maximumT, hitLevel,
                                   candidateT, candidateNormal, candidateMaterial,
                                   candidateMaterialSlot, candidateBarycentrics,
                                   candidateStableId))
        {
            found = true;
            refinedT = candidateT;
            refinedNormal = candidateNormal;
            refinedMaterial = candidateMaterial;
            refinedMaterialSlot = candidateMaterialSlot;
            refinedBarycentrics = candidateBarycentrics;
            refinedInstanceIndex = identity - 1u;
            refinedTriangleIndex = triangleIndex;
            refinedStableId = candidateStableId;
        }
    }
    return found;
}

bool GIConsumeTriangleRefinementBudget()
{
    if (_GITriangleRefinementBudget == 0u)
        return false;
    if (_GITraceCounters[14] >= _GITriangleRefinementBudget)
        return false;
    uint allocation;
    InterlockedAdd(_GITraceCounters[14], 1u, allocation);
    return allocation < _GITriangleRefinementBudget;
}

// The hard budgets used to be consumed in dispatch order. Once an atomic counter filled,
// every row below that point took a different lighting path and exposed a horizontal seam.
// Hash-gate an oversubscribed set across the whole screen first; the atomic remains the
// authoritative cap, while eligible work is spatially uniform and rotates over time.
bool GIValidationGate(uint2 pixel, uint candidateIndex, uint2 size,
                      uint budget, uint candidatesPerPixel, uint salt,
                      float oversubscription)
{
    if (budget == 0u)
        return false;
    float potentialCount = (float)max(size.x, 1u) * (float)max(size.y, 1u) *
                           (float)max(candidatesPerPixel, 1u);
    float probability = saturate(
        (float)budget * oversubscription / max(potentialCount, 1.0));
    if (probability >= 1.0)
        return true;
    uint seed = pixel.x + pixel.y * max(size.x, 1u) +
                candidateIndex * 0x85ebca6bu + _GIFrameIndex * 0x9e3779b9u;
    return GIRandom2(GIHash(seed ^ salt)).x < probability;
}

bool GITraceBvhOnlySpecular(float3 origin, float3 direction, out GIPathPayload payload)
{
    payload = (GIPathPayload)0;
    float hitT;
    float3 hitNormal;
    uint materialIndex, materialSlot, instanceIndex, triangleIndex;
    float2 barycentrics;
    uint2 stableId;
    if (!GITraceSceneBvh(
            origin, direction, 0.02, _GIMaxTraceDistance, 0u,
            hitT, hitNormal, materialIndex, materialSlot, barycentrics,
            instanceIndex, triangleIndex, stableId))
        return false;

    GIInstanceData instance = _GIInstances[instanceIndex];
    GIGeometryData geometry = _GIGeometries[instance.geometryIndex];
    GIGeometryStreamData range = _GIGeometryRanges[instance.geometryIndex];
    float3 ignoredP0, ignoredP1, ignoredP2;
    float2 uv0, uv1, uv2;
    uint loadedSubMesh;
    if (!GILoadRefinementTriangle(
            range, triangleIndex, ignoredP0, ignoredP1, ignoredP2,
            uv0, uv1, uv2, loadedSubMesh))
        return false;
    float baryW = 1.0 - barycentrics.x - barycentrics.y;
    float2 uv = uv0 * baryW + uv1 * barycentrics.x + uv2 * barycentrics.y;
    float3 baseColor, emissive;
    float roughness, metallic;
    GIEvaluateMaterialAtUv(materialIndex, uv, 0u, baseColor, emissive, roughness, metallic);
    bool twoSided = materialIndex < _GIMaterialCount &&
        (_GIMaterials[materialIndex].flags & GI_MATERIAL_DOUBLE_SIDED) != 0u;
    float mainDot = dot(hitNormal, normalize(-_GIMainLightDirection));
    float mainNoL = twoSided ? abs(mainDot) : saturate(mainDot);
    float3 directIrradiance = GIEvaluateTODDiffuseSky(hitNormal) * _GISkyIrradianceScale +
                              _GIMainLightColor * (mainNoL * _GIMainLightBounceScale);
    float3 outgoing = emissive + baseColor * (1.0 - metallic) * directIrradiance * (1.0 / PI);
    float3 f0 = lerp(0.04.xxx, baseColor, metallic);
    outgoing += _GIMainLightColor * GIEvaluateHitGgx(
        hitNormal, normalize(-direction), normalize(-_GIMainLightDirection), f0, roughness);

    payload.radiance = max(0.0, outgoing);
    payload.throughput = 1.0;
    payload.pathLength = payload.hitDistance = hitT;
    payload.solidAnglePdf = payload.proposalPdf = 1.0;
    payload.incomingDirection = direction;
    payload.outgoingDirection = -direction;
    payload.hitPosition = origin + direction * hitT;
    payload.barycentrics = barycentrics;
    payload.geometryId = geometry.sourceObjectId;
    payload.triangleId = triangleIndex;
    payload.geometricNormal = payload.shadingNormal = hitNormal;
    payload.objectId = stableId.x;
    payload.surfaceId = stableId.y;
    payload.materialId = materialIndex < _GIMaterialCount
        ? _GIMaterials[materialIndex].materialId : materialIndex;
    payload.materialSlot = materialSlot;
    payload.instanceRevision = instance.revision;
    payload.geometryRevision = geometry.sourceRevision;
    payload.pathFlags = GI_PATH_VALID | GI_PATH_VISIBILITY_VALID |
                        GI_PATH_FINITE_HIT | GI_PATH_TRIANGLE_REFINED;
    payload.pathDepth = 1u;
    payload.visibilityState = GI_VISIBILITY_VISIBLE;
    return true;
}

void GITraceSpecularWorld(float3 origin, float3 direction, uint preferredLevel,
                          float receiverRoughness, uint2 tracePixel,
                          out GIPathPayload payload)
{
    payload = (GIPathPayload)0;
    payload.radiance = GIEvaluateTODGlossySky(direction, receiverRoughness);
    payload.pathLength = _GIMaxTraceDistance;
    payload.throughput = 1.0;
    payload.solidAnglePdf = 1.0;
    payload.incomingDirection = direction;
    payload.proposalPdf = 1.0;
    payload.outgoingDirection = -direction;
    payload.hitPosition = origin + direction * _GIMaxTraceDistance;
    payload.hitDistance = _GIMaxTraceDistance;
    payload.barycentrics = -1.0;
    payload.geometryId = 0xffffffffu;
    payload.triangleId = 0xffffffffu;
    payload.geometricNormal = -direction;
    payload.shadingNormal = -direction;
    payload.pathFlags = GI_PATH_VALID | GI_PATH_VISIBILITY_VALID;
    payload.materialId = 0xffffffffu;
    payload.materialSlot = 0xffffffffu;
    payload.visibilityState = GI_VISIBILITY_VISIBLE;
    float hitT = _GIMaxTraceDistance;
    uint packedSurface = 0u;
    uint hitIdentity = 0u;
    uint hitLayer = 0u;
    uint hitLevel = 0u;
    int3 hitWorldCell = 0;
    int hitPhysicalBrick = -1;
    uint hitLocalCell = 0u;
    uint traceSteps = 0u;
    bool worldHit = GITraceUnifiedClipmaps(
        _GIClipmapLevels,
        _GIStaticPageTable, _GIStaticOccupancy, _GIStaticSurface, _GIStaticSurfaceIdentity,
        _GIStaticDistance,
        _GIDynamicPageTable, _GIDynamicOccupancy, _GIDynamicSurface, _GIDynamicSurfaceIdentity,
        _GIDynamicDistance,
        origin, direction, _GIMaxTraceDistance, preferredLevel, 0u,
        hitT, packedSurface, hitIdentity, hitLayer, hitLevel, hitWorldCell,
        hitPhysicalBrick, hitLocalCell, traceSteps);
    if (_GIEnableTraceCounters != 0u)
    {
        InterlockedAdd(_GITraceCounters[2], traceSteps);
        InterlockedAdd(_GITraceCounters[worldHit ? 3u : 4u], 1u);
    }
    if (!worldHit)
    {
#if !defined(GI_SPECULAR_COARSE_PASS)
        bool bvhFallback = receiverRoughness <= 0.35 &&
            GIValidationGate(tracePixel, 1u, _GISpecularSize,
                             _GITriangleRefinementBudget, 1u,
                             0x243f6a88u, 4.0) &&
            GIConsumeTriangleRefinementBudget();
        if (bvhFallback)
        {
            GIPathPayload exactPayload;
            if (GITraceBvhOnlySpecular(origin, direction, exactPayload))
                payload = exactPayload;
        }
#endif
        return;
    }

    uint surfaceAddress = (uint)hitPhysicalBrick * GI_SURFACE_WORDS_PER_BRICK + hitLocalCell;
    uint2 stableId = hitLayer == 0u ? _GIStaticSurfaceStableId[surfaceAddress]
                                    : _GIDynamicSurfaceStableId[surfaceAddress];
    uint selectedInstanceIndex = hitIdentity > 0u ? hitIdentity - 1u : 0xffffffffu;
    uint selectedTriangleIndex = hitLayer == 0u
        ? _GIStaticSurfacePrimitive[surfaceAddress]
        : _GIDynamicSurfacePrimitive[surfaceAddress];
    uint selectedMaterialIndex = (packedSurface >> 16u) & 0x7fffu;
    uint selectedMaterialSlot = 0xffffffffu;
    float2 selectedBarycentrics = -1.0;
    float2 selectedUv = 0.0;
    float3 hitNormal = GIUnpackSurfaceNormal(packedSurface);
#if defined(GI_SPECULAR_COARSE_PASS)
    bool needsTriangleRefinement = false;
#else
    bool needsTriangleRefinement = hitLevel <= 1u && receiverRoughness <= 0.35 &&
                                   GIValidationGate(
                                       tracePixel, 0u, _GISpecularSize,
                                       _GITriangleRefinementBudget, 1u,
                                       0x7f4a7c15u, 6.0) &&
                                   GIConsumeTriangleRefinementBudget();
#endif
    if (needsTriangleRefinement)
    {
        float refinedT;
        float3 refinedNormal;
        uint refinedMaterial;
        uint refinedMaterialSlot;
        float2 refinedBarycentrics;
        uint refinedInstanceIndex;
        uint refinedTriangleIndex;
        uint2 refinedStableId;
        if (!GIRefineClipmapHit(origin, direction, hitT, hitLayer, hitLevel, hitWorldCell,
                                refinedT, refinedNormal, refinedMaterial,
                                refinedMaterialSlot, refinedBarycentrics,
                                refinedInstanceIndex, refinedTriangleIndex,
                                refinedStableId))
        {
            payload.radiance = 0.0;
            payload.pathFlags = 0u;
            payload.visibilityState = GI_VISIBILITY_BLOCKED;
            return;
        }
        hitT = refinedT;
        hitNormal = refinedNormal;
        selectedMaterialIndex = refinedMaterial;
        selectedMaterialSlot = refinedMaterialSlot;
        selectedBarycentrics = refinedBarycentrics;
        selectedInstanceIndex = refinedInstanceIndex;
        selectedTriangleIndex = refinedTriangleIndex;
        stableId = refinedStableId;
        payload.pathFlags |= GI_PATH_TRIANGLE_REFINED;
        GIInstanceData refinedInstance = _GIInstances[selectedInstanceIndex];
        GIGeometryStreamData refinedRange = _GIGeometryRanges[refinedInstance.geometryIndex];
        float3 ignoredP0, ignoredP1, ignoredP2;
        float2 refinedUv0, refinedUv1, refinedUv2;
        uint ignoredSubMesh;
        GILoadRefinementTriangle(
            refinedRange, selectedTriangleIndex,
            ignoredP0, ignoredP1, ignoredP2,
            refinedUv0, refinedUv1, refinedUv2, ignoredSubMesh);
        float baryW = 1.0 - selectedBarycentrics.x - selectedBarycentrics.y;
        selectedUv = refinedUv0 * baryW + refinedUv1 * selectedBarycentrics.x +
                     refinedUv2 * selectedBarycentrics.y;
    }

    payload.pathLength = hitT;
    payload.hitDistance = hitT;
    payload.hitPosition = origin + direction * hitT;
    payload.geometricNormal = hitNormal;
    payload.shadingNormal = hitNormal;
    payload.objectId = stableId.x;
    payload.surfaceId = stableId.y;
    payload.barycentrics = selectedBarycentrics;
    payload.triangleId = selectedTriangleIndex;
    payload.pathDepth = 1u;
    payload.pathFlags |= GI_PATH_FINITE_HIT;
    if (selectedInstanceIndex < _GIInstanceCount)
    {
        GIInstanceData selectedInstance = _GIInstances[selectedInstanceIndex];
        GIGeometryData selectedGeometry = _GIGeometries[selectedInstance.geometryIndex];
        payload.geometryId = selectedGeometry.sourceObjectId;
        payload.instanceRevision = selectedInstance.revision;
        payload.geometryRevision = selectedGeometry.sourceRevision;
        if (selectedMaterialSlot == 0xffffffffu)
        {
            GIGeometryStreamData selectedRange = _GIGeometryRanges[selectedInstance.geometryIndex];
            float3 ignoredP0, ignoredP1, ignoredP2;
            float2 ignoredUv0, ignoredUv1, ignoredUv2;
            uint loadedSubMesh;
            if (GILoadRefinementTriangle(
                    selectedRange, selectedTriangleIndex,
                    ignoredP0, ignoredP1, ignoredP2,
                    ignoredUv0, ignoredUv1, ignoredUv2, loadedSubMesh))
                selectedMaterialSlot = loadedSubMesh;
        }
    }
    payload.materialSlot = selectedMaterialSlot;
    payload.materialId = selectedMaterialIndex < _GIMaterialCount
        ? _GIMaterials[selectedMaterialIndex].materialId : selectedMaterialIndex;
    if (_GIDebugHitMaterialColor != 0u)
    {
        payload.radiance = selectedMaterialIndex < _GIMaterialCount
            ? _GIMaterials[selectedMaterialIndex].baseColor.rgb : float3(1.0, 0.0, 1.0);
        return;
    }

    float cacheWeight = 0.0;
    float3 cachedRadiance = GIReadCachedRadiance(
        hitPhysicalBrick, hitLocalCell, hitWorldCell, hitIdentity, hitLayer, hitLevel,
        payload.hitPosition, -direction, cacheWeight);
    payload.radiance = GIShadeSpecularWorldHit(
        packedSurface, payload.hitPosition, hitNormal, normalize(-direction),
        cachedRadiance, cacheWeight, hitLayer, hitPhysicalBrick, hitLocalCell, hitLevel,
        needsTriangleRefinement, selectedMaterialIndex, selectedUv);
    if (_GIEnableTraceCounters != 0u)
        InterlockedAdd(_GITraceCounters[cacheWeight > 1e-5 ? 5u : 6u], 1u);
}

float GILuminance(float3 value)
{
    return dot(max(0.0, value), float3(0.2126, 0.7152, 0.0722));
}

float3 GIClampDiffuseCandidate(float3 radiance)
{
    radiance = max(0.0, radiance);
    float limit = _GIDiffuseFireflyClamp;
    if (limit <= 0.0)
        return radiance;
    float luminance = GILuminance(radiance);
    return radiance * min(1.0, limit / max(luminance, 1e-5));
}

float GIClampMergedReservoirWeight(float candidateWeight, float candidateCount,
                                   float weightSum, float sampleCount, float ratioLimit)
{
    if (weightSum <= 0.0 || sampleCount <= 0.0)
        return candidateWeight;
    float currentMeanWeight = weightSum / sampleCount;
    return min(candidateWeight,
               currentMeanWeight * max(candidateCount, 1.0) * ratioLimit);
}

bool GIReservoirUpdate(inout float weightSum, inout float sampleCount,
                       float candidateWeight, float candidateCount, float randomValue)
{
    candidateWeight = max(0.0, candidateWeight);
    if (candidateCount <= 0.0)
        return false;
    // M counts proposals, not only proposals that happened to see light.  Dropping a
    // zero-weight candidate turns the estimator into a conditional average over lit
    // paths.  The bias grows with ray count and was the main reason 4 SPP appeared much
    // brighter than 1 SPP.  Null candidates cannot be selected, but they still belong in M.
    if (candidateWeight <= 0.0)
    {
        sampleCount += candidateCount;
        return false;
    }
    float nextWeightSum = weightSum + candidateWeight;
    bool selected = randomValue * nextWeightSum < candidateWeight;
    weightSum = nextWeightSum;
    sampleCount += candidateCount;
    return selected;
}

void GIReservoirLimit(inout float weightSum, inout float sampleCount, float maximumCount)
{
    if (sampleCount > maximumCount)
    {
        float scale = maximumCount / sampleCount;
        weightSum *= scale;
        sampleCount = maximumCount;
    }
}

float GIDiffuseTarget(float3 incidentRadiance, float3 primaryNormal, float3 direction)
{
    float cosine = saturate(dot(primaryNormal, direction));
    return GILuminance(max(0.0, incidentRadiance) * cosine);
}

float GIFreshDiffuseWeight(float3 incidentRadiance, float target, float sourcePdf)
{
    float unbiasedWeight = target / max(sourcePdf, 1e-6);
    // A tiny emissive-mixture PDF must not own a whole spatial neighbourhood for many
    // frames. This covers the normal cosine-estimator range with margin and bounds the
    // rare one-SPP proposal outliers that appear as saturated red/cyan islands.
    float robustLimit = max(1e-4, GILuminance(incidentRadiance) * TWO_PI);
    return min(unbiasedWeight, robustLimit);
}

float3 GIDiffuseReservoirEstimate(float3 incidentRadiance, float3 direction,
                                  float3 primaryNormal, float selectedTarget,
                                  float weightSum, float sampleCount)
{
    if (weightSum <= 0.0 || sampleCount <= 0.0 || selectedTarget <= 1e-6)
        return 0.0;
    float3 integrand = max(0.0, incidentRadiance) * saturate(dot(primaryNormal, direction));
    return integrand * (weightSum / max(sampleCount * selectedTarget, 1e-6));
}

float GIReconnectionJacobian(float3 oldDirection, float oldDistance,
                             float3 newDirection, float newDistance,
                             float3 hitNormal, float hitValid)
{
    if (hitValid < 0.5 || oldDistance >= _GIMaxTraceDistance * 0.999)
        return 1.0;
    float oldCosine = max(abs(dot(normalize(hitNormal), -normalize(oldDirection))), 0.05);
    float newCosine = max(abs(dot(normalize(hitNormal), -normalize(newDirection))), 0.05);
    float oldDistanceSquared = max(oldDistance * oldDistance, 1e-4);
    float newDistanceSquared = max(newDistance * newDistance, 1e-4);
    float jacobian = (newCosine * oldDistanceSquared) /
                     (oldCosine * newDistanceSquared);
    // Large reconnect Jacobians turn one rare emissive path into a whole flashing block.
    // Pairwise MIS would be preferable; this bounded form is the robust real-time fallback.
    return clamp(jacobian, 0.25, 4.0);
}

bool GIShortDepthVisibility(float3 origin, float3 hitPosition)
{
    float3 segment = hitPosition - origin;
    float distanceValue = length(segment);
    if (distanceValue <= 0.05)
        return true;
    float thickness = max(0.08, distanceValue * 0.015);
    [unroll]
    for (uint sampleIndex = 1u; sampleIndex <= 3u; sampleIndex++)
    {
        float t = (float)sampleIndex * 0.25;
        float3 samplePosition = origin + segment * t;
        float4 clip = mul(_GIViewProjection, float4(samplePosition, 1.0));
        if (clip.w <= 1e-5)
            continue;
        float2 sampleUv = ComputeNormalizedDeviceCoordinates(
            samplePosition, _GIViewProjection);
        if (any(sampleUv <= 0.0) || any(sampleUv >= 1.0))
            continue;
        float sceneDepth = GILoadDepth(sampleUv);
        if (GIIsBackground(sceneDepth))
            continue;
        float3 scenePosition = GIWorldPosition(sampleUv, sceneDepth);
        float sceneCameraDistance = length(scenePosition - _GICameraPosition);
        float rayCameraDistance = length(samplePosition - _GICameraPosition);
        if (sceneCameraDistance + thickness < rayCameraDistance)
            return false;
    }
    return true;
}

bool GITryReadScreenHitRadiance(float3 hitPosition, float3 screenNormal,
                                float3 outgoingDirection, out float3 radiance)
{
    radiance = 0.0;
    [loop]
    for (uint levelIndex = 0u; levelIndex < 5u; levelIndex++)
    {
        GIClipmapLevelData level = _GIClipmapLevels[levelIndex];
        int3 centerCell = (int3)floor(hitPosition / level.cellSize);
        [loop]
        for (uint offsetIndex = 0u; offsetIndex < 7u; offsetIndex++)
        {
            int3 worldCell = centerCell + GIFilterOffset(offsetIndex);
            [loop]
            for (uint layer = 0u; layer < 2u; layer++)
            {
                int physicalBrick = -1;
                uint localCell = 0u;
                bool occupied = layer == 0u
                    ? GIReadOccupancy(level, _GIStaticPageTable, _GIStaticOccupancy,
                                      worldCell, physicalBrick, localCell)
                    : GIReadOccupancy(level, _GIDynamicPageTable, _GIDynamicOccupancy,
                                      worldCell, physicalBrick, localCell);
                if (!occupied)
                    continue;
                uint surfaceAddress = (uint)physicalBrick * GI_SURFACE_WORDS_PER_BRICK + localCell;
                uint packedSurface = layer == 0u
                    ? _GIStaticSurface[surfaceAddress] : _GIDynamicSurface[surfaceAddress];
                if (abs(dot(GIUnpackSurfaceNormal(packedSurface), screenNormal)) < 0.45)
                    continue;
                uint identity = layer == 0u
                    ? _GIStaticSurfaceIdentity[surfaceAddress]
                    : _GIDynamicSurfaceIdentity[surfaceAddress];
                float cacheWeight;
                float3 candidate = GIReadCachedRadiance(
                    physicalBrick, localCell, worldCell, identity, layer, levelIndex,
                    hitPosition, outgoingDirection, cacheWeight);
                if (cacheWeight > 1e-5)
                {
                    radiance = candidate;
                    return true;
                }
            }
        }
    }
    return false;
}

// A screen trace already gives us an exact visible-surface position.  Query only the
// containing voxel in each clipmap level before falling back to a second world march.
// The former 5 * 7 * 2 search was removed because it cost more than the world trace and
// selected discontinuous neighbours.  Exact containment is both cheaper and stable.
bool GITryGetScreenHitStableId(float3 hitPosition, float3 screenNormal,
                               out uint2 stableId)
{
    stableId = 0u;
    [loop]
    for (uint levelIndex = 0u; levelIndex < GI_CLIPMAP_LEVEL_COUNT; levelIndex++)
    {
        GIClipmapLevelData level = _GIClipmapLevels[levelIndex];
        int3 worldCell = (int3)floor(hitPosition / level.cellSize);
        [unroll]
        for (uint layer = 0u; layer < 2u; layer++)
        {
            int physicalBrick = -1;
            uint localCell = 0u;
            bool occupied = layer == 0u
                ? GIReadOccupancy(level, _GIStaticPageTable, _GIStaticOccupancy,
                                  worldCell, physicalBrick, localCell)
                : GIReadOccupancy(level, _GIDynamicPageTable, _GIDynamicOccupancy,
                                  worldCell, physicalBrick, localCell);
            if (!occupied)
                continue;
            uint address = (uint)physicalBrick * GI_SURFACE_WORDS_PER_BRICK + localCell;
            uint packedSurface = layer == 0u
                ? _GIStaticSurface[address] : _GIDynamicSurface[address];
            if (abs(dot(GIUnpackSurfaceNormal(packedSurface), screenNormal)) < 0.55)
                continue;
            stableId = layer == 0u
                ? _GIStaticSurfaceStableId[address] : _GIDynamicSurfaceStableId[address];
            if (!any(stableId == 0u))
                return true;
        }
    }
    stableId = 0u;
    return false;
}

bool GITryReadScreenHitRadianceFast(float3 hitPosition, float3 screenNormal,
                                    float3 outgoingDirection, out float3 radiance,
                                    out uint2 stableId)
{
    radiance = 0.0;
    stableId = 0u;
    [loop]
    for (uint levelIndex = 0u; levelIndex < GI_CLIPMAP_LEVEL_COUNT; levelIndex++)
    {
        GIClipmapLevelData level = _GIClipmapLevels[levelIndex];
        int3 worldCell = (int3)floor(hitPosition / level.cellSize);
        [unroll]
        for (uint layer = 0u; layer < 2u; layer++)
        {
            int physicalBrick = -1;
            uint localCell = 0u;
            bool occupied = layer == 0u
                ? GIReadOccupancy(level, _GIStaticPageTable, _GIStaticOccupancy,
                                  worldCell, physicalBrick, localCell)
                : GIReadOccupancy(level, _GIDynamicPageTable, _GIDynamicOccupancy,
                                  worldCell, physicalBrick, localCell);
            if (!occupied)
                continue;

            uint address = (uint)physicalBrick * GI_SURFACE_WORDS_PER_BRICK + localCell;
            uint packedSurface = layer == 0u
                ? _GIStaticSurface[address] : _GIDynamicSurface[address];
            float normalAgreement = abs(dot(GIUnpackSurfaceNormal(packedSurface), screenNormal));
            if (normalAgreement < 0.55)
                continue;
            uint identity = layer == 0u
                ? _GIStaticSurfaceIdentity[address] : _GIDynamicSurfaceIdentity[address];
            uint2 candidateStableId = layer == 0u
                ? _GIStaticSurfaceStableId[address] : _GIDynamicSurfaceStableId[address];
            if (any(candidateStableId == 0u))
                continue;
            float cacheWeight;
            float3 candidate = GIReadCachedRadiance(
                physicalBrick, localCell, worldCell, identity, layer, levelIndex,
                hitPosition, outgoingDirection, cacheWeight);
            if (cacheWeight > 1e-5)
            {
                radiance = candidate;
                stableId = candidateStableId;
                return true;
            }
        }
    }
    return false;
}

bool GITryReadScreenHistory(float2 hitUv, float3 hitPosition, float3 hitNormal,
                             float historyMip, out float3 radiance)
{
    radiance = 0.0;
    // The captured colour is composited after the previous frame's GI injection.
    // Without a separate direct-light buffer, reusing it starts a feedback loop rather
    // than a controlled multi-bounce estimator.  Cache/world tracing remains available
    // for the same screen hit below, so rejecting it is correctness-preserving.
    if (_GIEnableSceneColorHistory == 0u)
        return false;
    // A zero reuse setting must be a real current-frame mode.  Previously the
    // temporal pass respected the slider while screen hits still sampled last
    // frame's diffuse buffer, hiding the actual source of reprojection defects.
    if (_GIHistoryValid == 0u ||
        (_GISceneColorHistoryValid == 0u && _GIDiffuseHistoryWeight <= 0.0))
        return false;
    float4 previousClip = mul(_GIPreviousViewProjection, float4(hitPosition, 1.0));
    if (previousClip.w <= 1e-5)
        return false;
    // _GIPreviousViewProjection is a render-texture GPU projection.  Unity's
    // helper applies the required UNITY_UV_STARTS_AT_TOP correction; a manual
    // clip.xy/w mapping only agrees on the horizontal centre line.
    float2 previousUv = ComputeNormalizedDeviceCoordinates(
        hitPosition, _GIPreviousViewProjection);
    if (any(previousUv <= 0.0) || any(previousUv >= 1.0))
        return false;
    uint historyWidth, historyHeight;
    _GIGeometryHistoryRead.GetDimensions(historyWidth, historyHeight);
    int2 previousCenter = clamp(
        (int2)(previousUv * float2(historyWidth, historyHeight)),
        0, int2(historyWidth, historyHeight) - 1);
    uint materialSignature = GIMaterialSignature(hitUv);
    float bestScore = 1e20;
    int2 bestPixel = -1;
    [unroll]
    for (int y = -1; y <= 1; y++)
    [unroll]
    for (int x = -1; x <= 1; x++)
    {
        int2 candidatePixel = clamp(
            previousCenter + int2(x, y), 0, int2(historyWidth, historyHeight) - 1);
        float4 previousGeometry = _GIGeometryHistoryRead.Load(int3(candidatePixel, 0));
        if ((uint)round(previousGeometry.w) != materialSignature)
            continue;
        float3 previousNormal = GIUnpackHistoryNormal(previousGeometry.xy);
        float normalAgreement = dot(previousNormal, hitNormal);
        if (normalAgreement < 0.72)
            continue;
        float2 candidateUv = (float2(candidatePixel) + 0.5) /
                             float2(historyWidth, historyHeight);
        float3 previousPosition = ComputeWorldSpacePosition(
            candidateUv, previousGeometry.z, _GIPreviousInverseViewProjection);
        float3 positionDelta = previousPosition - hitPosition;
        float planeError = abs(dot(positionDelta, hitNormal));
        float distanceSquared = dot(positionDelta, positionDelta);
        if (planeError > 0.15 || distanceSquared > 0.64)
            continue;
        float score = distanceSquared + planeError * 2.0 + (1.0 - normalAgreement) * 0.1;
        if (score < bestScore)
        {
            bestScore = score;
            bestPixel = candidatePixel;
        }
    }
    if (any(bestPixel < 0))
        return false;

    // AKGI screen hits reuse the previous lit scene color.  Rough reflections sample a
    // coarser mip, which restores the frequency content that a six-lobe world cache cannot
    // represent without reintroducing Unity reflection probes.
    if (_GISceneColorHistoryValid != 0u)
    {
        uint sceneWidth, sceneHeight, sceneMipCount;
        _GISceneColorHistory.GetDimensions(0u, sceneWidth, sceneHeight, sceneMipCount);
        float validMip = min(max(0.0, historyMip),
                             max(0.0, (float)sceneMipCount - 1.0));
        radiance = max(0.0, _GISceneColorHistory.SampleLevel(
            sampler_LinearClamp, previousUv, validMip).rgb);
        return true;
    }

    float4 previousLighting = _GIDiffuseHistoryRead.Load(int3(bestPixel, 0));
    if (GIIsBackground(previousLighting.a))
        return false;
    // The history stores incident irradiance at the visible hit. Convert it back to
    // diffuse outgoing radiance before using it as the next path vertex; otherwise every
    // screen-space bounce implicitly loses the Lambert 1/PI contract.
    uint2 hitPixel = GIFullPixelFromUv(hitUv);
    float4 hitGBuffer0 = _GIGBuffer0.Load(int3(hitPixel, 0));
    float4 hitGBuffer1 = _GIGBuffer1.Load(int3(hitPixel, 0));
    uint hitMaterialFlags = (uint)(hitGBuffer0.a * 255.0 + 0.5);
    float hitReflectivity = (hitMaterialFlags & 8u) != 0u
        ? max(hitGBuffer1.r, max(hitGBuffer1.g, hitGBuffer1.b))
        : hitGBuffer1.r;
    float3 hitDiffuseBrdf = max(0.0, hitGBuffer0.rgb) *
                            (1.0 - saturate(hitReflectivity));
    radiance = max(0.0, previousLighting.rgb) * hitDiffuseBrdf * (1.0 / PI);
    return true;
}

bool GIScreenTrace(float3 origin, float3 direction, float perceptualRoughness,
                   out float3 radiance, out float hitDistance,
                   out float3 hitNormal, out float hitValid, out uint2 stableId)
{
    radiance = 0.0;
    hitDistance = _GIMaxTraceDistance;
    hitNormal = -direction;
    hitValid = 0.0;
    stableId = 0u;
    bool recordedGeometryHit = false;
    uint hzbWidth, hzbHeight;
    _GIHzbTexture.GetDimensions(hzbWidth, hzbHeight);
    float traceLimit = min(_GIMaxTraceDistance, max(0.0, _GIScreenTraceDistance));
    if (traceLimit <= 0.0)
        return false;
    float t = max(0.1, _GIClipmapLevels[0].cellSize * 0.75);
    float previousT = t;
    float stepLength = max(0.12, _GIClipmapLevels[0].cellSize * 0.75);
    [loop]
    for (uint iteration = 0u; iteration < 16u && t < traceLimit; iteration++)
    {
        float3 rayPoint = origin + direction * t;
        float4 clip = mul(_GIViewProjection, float4(rayPoint, 1.0));
        if (clip.w <= 1e-5)
            break;
        float2 uv = ComputeNormalizedDeviceCoordinates(rayPoint, _GIViewProjection);
        if (any(uv <= 0.001) || any(uv >= 0.999))
            break;

        float projectedStepPixels = stepLength * max(hzbWidth, hzbHeight) /
                                    max(t, _GIClipmapLevels[0].cellSize);
        float mip = _GIUseHzb != 0u
            ? clamp(floor(log2(max(1.0, projectedStepPixels))) - 1.0,
                    0.0, max(0.0, (float)_GIHzbMipCount - 1.0))
            : 0.0;
        float hierarchyDepth = _GIUseHzb != 0u
            ? _GIHzbTexture.SampleLevel(sampler_PointClamp, uv, mip)
            : GILoadDepth(uv);
        if (GIIsBackground(hierarchyDepth))
        {
            previousT = t;
            t += stepLength;
            stepLength = min(stepLength * 1.45, 8.0);
            continue;
        }
        float rayDepth = clip.z / clip.w;
        float depthThickness = 2e-4 + abs(hierarchyDepth) * 5e-4;
        if (!GIRayDepthBehindScene(rayDepth, hierarchyDepth, depthThickness))
        {
            previousT = t;
            t += stepLength;
            stepLength = min(stepLength * 1.45, 8.0);
            continue;
        }

        // Descend to the exact full-resolution depth and refine the crossing interval. The
        // hierarchy is only an accelerator; final acceptance never uses a coarse mip value.
        float low = previousT;
        float high = t;
        float2 hitUv = uv;
        [unroll]
        for (uint refine = 0u; refine < 5u; refine++)
        {
            float mid = (low + high) * 0.5;
            float3 midPoint = origin + direction * mid;
            float4 midClip = mul(_GIViewProjection, float4(midPoint, 1.0));
            float2 midUv = ComputeNormalizedDeviceCoordinates(midPoint, _GIViewProjection);
            if (midClip.w <= 1e-5 || any(midUv <= 0.0) || any(midUv >= 1.0))
            {
                low = mid;
                continue;
            }
            float sceneDepth = GILoadDepth(midUv);
            if (GIIsBackground(sceneDepth))
            {
                low = mid;
                continue;
            }
            float midDepth = midClip.z / midClip.w;
            if (GIRayDepthBehindScene(midDepth, sceneDepth, depthThickness))
            {
                high = mid;
                hitUv = midUv;
            }
            else
                low = mid;
        }
        float3 hitPosition = origin + direction * high;
        float exactDepth = GILoadDepth(hitUv);
        if (!GIIsBackground(exactDepth))
        {
            hitPosition = GIWorldPosition(hitUv, exactDepth);
            if (!recordedGeometryHit && _GIEnableTraceCounters != 0u)
            {
                InterlockedAdd(_GITraceCounters[7], 1u);
                recordedGeometryHit = true;
            }
        }
        float3 screenHitNormal = GILoadNormal(hitUv);
        float2 originUv = ComputeNormalizedDeviceCoordinates(origin, _GIViewProjection);
        float screenDistancePixels = length(hitUv - originUv) *
            max((float)_GIFullSize.x, (float)_GIFullSize.y);
        float coneDiameter = max(1.0,
            perceptualRoughness * perceptualRoughness * screenDistancePixels * 0.5);
        float historyMip = clamp(log2(coneDiameter), 0.0, 8.0);
        if (GITryReadScreenHistory(
                hitUv, hitPosition, screenHitNormal, historyMip, radiance))
        {
            // Screen history supplies radiance, but the persistent path still needs the
            // exact world-cache identity.  Without it strict temporal/spatial
            // reconnection rejects every finite screen hit on the following frame.
            GITryGetScreenHitStableId(hitPosition, screenHitNormal, stableId);
            hitDistance = length(hitPosition - origin);
            hitNormal = screenHitNormal;
            hitValid = 1.0;
            return true;
        }

        // Reprojected screen radiance is often unavailable for newly exposed pixels.  The
        // geometry is nevertheless known, so sample its containing clipmap voxel instead
        // of enqueueing a second 50+ step march from the primary surface.
        if (GITryReadScreenHitRadianceFast(
                hitPosition, screenHitNormal, -direction, radiance, stableId))
        {
            hitDistance = length(hitPosition - origin);
            hitNormal = screenHitNormal;
            hitValid = 1.0;
            return true;
        }

        // Only genuinely uncached screen hits enter the compact world-miss queue.
        return false;
    }
    return false;
}

[numthreads(8, 8, 1)]
void TraceDiffuseScreen(uint3 dispatchId : SV_DispatchThreadID)
{
    if (any(dispatchId.xy >= _GIDiffuseSize))
        return;
    float2 uv = GIUvFromPixel(dispatchId.xy, _GIDiffuseSize);
    float depth = GILoadDepth(uv);
    if (_GIEnableDiffuse == 0u || GIIsBackground(depth))
    {
        _GICurrentDiffuse[dispatchId.xy] = 0.0;
        _GICurrentDiffuseRay[dispatchId.xy] = 0.0;
        _GICurrentDiffuseStats[dispatchId.xy] = 0.0;
        _GICurrentDiffuseHit[dispatchId.xy] = 0.0;
        _GICurrentDiffuseReprojection[dispatchId.xy] = 0xffffffffu;
        return;
    }

    float3 normal = GILoadNormal(uv);
    float3 position = GIWorldPosition(uv, depth);

    float3 origin = position + normal * max(0.01, _GIClipmapLevels[0].cellSize * 0.1);
    float3 selectedRadiance = 0.0;
    float3 selectedDirection = normal;
    float selectedDistance = _GIMaxTraceDistance;
    float3 selectedHitNormal = normal;
    float selectedHitValid = 0.0;
    uint2 selectedStableId = 0u;
    float selectedSourcePdf = 1.0 / PI;
    float selectedAge = 0.0;
    float selectedTarget = 1e-5;
    float weightSum = 0.0;
    float sampleCount = 0.0;
    uint missMask = 0u;
    uint rayCount = clamp(_GIDiffuseRayCount, 1u, 4u);
    uint2 previousPixel;
    float2 previousUv;
    float historyValidity = GITemporalDiffuseMatch(
        uv, depth, normal, GIMaterialSignature(uv),
        previousPixel, previousUv);
    _GICurrentDiffuseReprojection[dispatchId.xy] = historyValidity > 0.0
        ? previousPixel.x + previousPixel.y * _GIDiffuseSize.x
        : 0xffffffffu;
    // A 2x2 low-resolution quad is one screen probe. At the default one-ray setting,
    // rotate the emitting lane every frame instead of tracing all four lanes and then
    // throwing three vector estimates away during reservoir selection. SpatialDiffuse
    // broadcasts the active lane through its geometry-gated probe reconstruction, while
    // per-pixel temporal reservoirs retain the other lanes. Disoccluded pixels still get
    // a valid depth/normal record and are reconstructed from their active probe lane.
    bool interleavedProbe = _GIDiffuseRayCount == 1u &&
        _GIDiffuseSize.x * 4u >= _GIFullSize.x &&
        _GIDiffuseSize.y * 4u >= _GIFullSize.y;
    if (interleavedProbe)
    {
        uint lane = (dispatchId.x & 1u) | ((dispatchId.y & 1u) << 1u);
        uint activeLane = _GIFrameIndex & 3u;
        if (lane != activeLane)
        {
            _GICurrentDiffuse[dispatchId.xy] = float4(0.0, 0.0, 0.0, depth);
            _GICurrentDiffuseRay[dispatchId.xy] = float4(normal, _GIMaxTraceDistance);
            _GICurrentDiffuseStats[dispatchId.xy] = 0.0;
            _GICurrentDiffuseHit[dispatchId.xy] = 0.0;
            return;
        }
    }
    if (historyValidity <= 0.0 && _GIDisocclusionExtraRayBudget > 0u &&
        _GIDisocclusionRayCount > rayCount)
    {
        uint desiredExtra = min(4u, _GIDisocclusionRayCount) - rayCount;
        uint pixelCount = max(1u, _GIDiffuseSize.x * _GIDiffuseSize.y);
        // Hash-gate contenders before the atomic reservation. This scatters the bounded
        // work over a camera cut instead of spending the entire budget on the first rows.
        float selectionProbability = saturate(
            (float)(_GIDisocclusionExtraRayBudget * 4u) /
            (float)max(1u, pixelCount * desiredExtra));
        uint gateSeed = GIHash(dispatchId.x + dispatchId.y * _GIDiffuseSize.x +
                               _GIFrameIndex * 0x9e3779b9u);
        if (GIRandom2(gateSeed).x < selectionProbability)
        {
            uint reservationStart;
            InterlockedAdd(_GITraceCounters[12], desiredExtra, reservationStart);
            uint allowedExtra = reservationStart < _GIDisocclusionExtraRayBudget
                ? min(desiredExtra, _GIDisocclusionExtraRayBudget - reservationStart)
                : 0u;
            rayCount += allowedExtra;
        }
    }
    [loop]
    for (uint ray = 0u; ray < rayCount; ray++)
    {
        uint seed = dispatchId.x + dispatchId.y * _GIDiffuseSize.x +
                    (_GIFrameIndex * 9781u + ray * 6271u);
        // Lambertian final gather is cosine weighted.  With one fresh candidate per
        // pixel this removes the avoidable cosine variance of uniform-hemisphere rays.
        float3 direction;
        float sourcePdf;
        if (!GIChooseDiffuseDirection(dispatchId.xy, ray, origin, normal,
                                       direction, sourcePdf))
        {
            // Rejected emissive-cone proposals are valid null samples from the mixture.
            // Counting only successful proposals produces the same conditional-light bias
            // as discarding a traced black path.
            sampleCount += 1.0;
            continue;
        }
        float3 candidateRadiance;
        float candidateDistance;
        float3 candidateHitNormal;
        float candidateHitValid;
        uint2 candidateStableId;
        if (_GIEnableTraceCounters != 0u)
            InterlockedAdd(_GITraceCounters[0], 1u);
        if (GIScreenTrace(origin, direction, 0.0, candidateRadiance, candidateDistance,
                          candidateHitNormal, candidateHitValid, candidateStableId))
        {
            candidateRadiance = GIClampDiffuseCandidate(candidateRadiance);
            if (_GIEnableTraceCounters != 0u)
                InterlockedAdd(_GITraceCounters[1], 1u);
            float target = GIDiffuseTarget(candidateRadiance, normal, direction);
            if (GIReservoirUpdate(weightSum, sampleCount,
                                  GIFreshDiffuseWeight(candidateRadiance, target, sourcePdf), 1.0,
                                  GIRandom2(seed ^ 0x68bc21ebu).x))
            {
                selectedRadiance = candidateRadiance;
                selectedDirection = direction;
                selectedDistance = candidateDistance;
                selectedHitNormal = candidateHitNormal;
                selectedHitValid = candidateHitValid;
                selectedStableId = candidateStableId;
                selectedSourcePdf = sourcePdf;
                selectedAge = 0.0;
                selectedTarget = max(target, 1e-5);
            }
        }
        else
            missMask |= 1u << ray;
    }
    _GICurrentDiffuse[dispatchId.xy] = float4(selectedRadiance, depth);
    _GICurrentDiffuseRay[dispatchId.xy] = float4(selectedDirection, selectedDistance);
    _GICurrentDiffuseStats[dispatchId.xy] = float4(
        weightSum, sampleCount, selectedTarget, (float)missMask);
    _GICurrentDiffuseHit[dispatchId.xy] = GIEncodeDiffuseHit(
        selectedHitNormal, selectedHitValid, selectedStableId);
    if (missMask != 0u)
        _GIDiffuseMissQueue.Append(dispatchId.x + dispatchId.y * _GIDiffuseSize.x);
}

[numthreads(1, 1, 1)]
void BuildDiffuseMissArgs(uint3 dispatchId : SV_DispatchThreadID)
{
    uint missCount = _GIDiffuseMissDispatchArgs[0];
    _GIDiffuseMissDispatchArgs[3] = missCount;
    _GIDiffuseMissDispatchArgs[0] = (missCount + 63u) / 64u;
    _GIDiffuseMissDispatchArgs[1] = 1u;
    _GIDiffuseMissDispatchArgs[2] = 1u;
}

[numthreads(64, 1, 1)]
void TraceDiffuseWorldMisses(uint3 dispatchId : SV_DispatchThreadID)
{
    uint missCount = _GIDiffuseMissDispatchArgs[3];
    if (dispatchId.x >= missCount)
        return;
    uint linearPixel = _GIDiffuseMissQueueRead[dispatchId.x];
    uint2 pixel = uint2(linearPixel % _GIDiffuseSize.x, linearPixel / _GIDiffuseSize.x);
    float2 uv = GIUvFromPixel(pixel, _GIDiffuseSize);
    float4 current = _GICurrentDiffuse[pixel];
    float4 rayRecord = _GICurrentDiffuseRay[pixel];
    float4 stats = _GICurrentDiffuseStats[pixel];
    float4 hitRecord = _GICurrentDiffuseHit[pixel];
    uint missMask = (uint)round(stats.w);
    float3 normal = GILoadNormal(uv);
    float3 position = GIWorldPosition(uv, current.a);
    float3 origin = position + normal * max(0.01, _GIClipmapLevels[0].cellSize * 0.1);
    float3 selectedRadiance = current.rgb;
    float3 selectedDirection = rayRecord.xyz;
    float selectedDistance = rayRecord.w;
    float3 selectedHitNormal = GIDecodeDiffuseHitNormal(hitRecord);
    float selectedHitValid = hitRecord.w;
    uint2 selectedStableId = GIDecodeDiffuseHitStableId(hitRecord);
    float selectedSourcePdf = GIDiffuseMixturePdf(
        origin, normal, normalize(selectedDirection));
    float selectedAge = 0.0;
    float selectedTarget = max(stats.z, 1e-5);
    float weightSum = stats.x;
    float sampleCount = stats.y;
    // The queue may contain bits emitted by the bounded disocclusion supplement.  Iterating
    // only the base ray count silently discarded those world misses, so selected pixels paid
    // for extra screen traces without receiving the corresponding Clipmap samples.
    uint rayCount = clamp(max(_GIDiffuseRayCount, _GIDisocclusionRayCount), 1u, 4u);
    [loop]
    for (uint ray = 0u; ray < rayCount; ray++)
    {
        if ((missMask & (1u << ray)) == 0u)
            continue;
        uint seed = pixel.x + pixel.y * _GIDiffuseSize.x +
                    (_GIFrameIndex * 9781u + ray * 6271u);
        float3 direction;
        float sourcePdf;
        if (!GIChooseDiffuseDirection(pixel, ray, origin, normal,
                                       direction, sourcePdf))
        {
            sampleCount += 1.0;
            continue;
        }
        float candidateDistance;
        float3 candidateRadiance = 0.0;
        float3 candidateHitNormal;
        float candidateHitValid;
        uint2 candidateStableId;
        GITraceRadianceDetailed(origin, direction, 0u, candidateRadiance, candidateDistance,
                                candidateHitNormal, candidateHitValid, candidateStableId);
        candidateRadiance = GIClampDiffuseCandidate(candidateRadiance);
        float target = GIDiffuseTarget(candidateRadiance, normal, direction);
        if (GIReservoirUpdate(weightSum, sampleCount,
                              GIFreshDiffuseWeight(candidateRadiance, target, sourcePdf), 1.0,
                              GIRandom2(seed ^ 0x02e5be93u).y))
        {
            selectedRadiance = candidateRadiance;
            selectedDirection = direction;
            selectedDistance = candidateDistance;
            selectedHitNormal = candidateHitNormal;
            selectedHitValid = candidateHitValid;
            selectedStableId = candidateStableId;
            selectedSourcePdf = sourcePdf;
            selectedAge = 0.0;
            selectedTarget = max(target, 1e-5);
        }
    }
    _GICurrentDiffuse[pixel] = float4(selectedRadiance, current.a);
    _GICurrentDiffuseRay[pixel] = float4(selectedDirection, selectedDistance);
    _GICurrentDiffuseStats[pixel] = float4(
        weightSum, sampleCount, selectedTarget, selectedSourcePdf);
    _GICurrentDiffuseHit[pixel] = GIEncodeDiffuseHit(
        selectedHitNormal, selectedHitValid, selectedStableId);
}

float2 GIContinuousPreviousUv(float2 uv, float currentDepth, float2 geometryUv)
{
    float3 currentPosition = GIWorldPosition(uv, currentDepth);
    float2 matrixUv = ComputeNormalizedDeviceCoordinates(
        currentPosition, _GIPreviousViewProjection);
    float2 motion = _GIMotionTexture.Load(int3(GIFullPixelFromUv(uv), 0));
    float2 motionUv = uv - motion;
    float matrixDistance = dot(matrixUv - geometryUv, matrixUv - geometryUv);
    float motionDistance = dot(motionUv - geometryUv, motionUv - geometryUv);
    return (_GIUseMotionVectors != 0u && motionDistance < matrixDistance)
        ? motionUv : matrixUv;
}

float GITemporalDiffuseMatch(float2 uv, float currentDepth, float3 currentNormal,
                             uint currentMaterial, out uint2 previousPixel,
                             out float2 previousUv)
{
    previousPixel = 0u;
    previousUv = uv;
    if (_GIHistoryValid == 0u)
        return 0.0;

    float3 currentPosition = GIWorldPosition(uv, currentDepth);
    float2 motion = _GIMotionTexture.Load(int3(GIFullPixelFromUv(uv), 0));
    float2 motionUv = uv - motion;

    // Nanite's procedural VBuffer path does not contribute object motion to URP's regular
    // MotionVectors draw.  A zero vector therefore means "unknown", not "same pixel" when
    // the camera moves.  Reproject the reconstructed world point with the previous camera
    // matrix for static Nanite geometry, and keep the motion-vector candidate for dynamic
    // regular geometry.  Geometry validation below chooses the correct mapping.
    float4 previousClip = mul(_GIPreviousViewProjection, float4(currentPosition, 1.0));
    float2 matrixUv = ComputeNormalizedDeviceCoordinates(
        currentPosition, _GIPreviousViewProjection);
    float2 predictedUvs[2];
    predictedUvs[0] = matrixUv;
    predictedUvs[1] = motionUv;

    uint width, height;
    _GIGeometryHistoryRead.GetDimensions(width, height);
    float bestScore = 1e20;
    int2 bestPixel = -1;

    [unroll]
    for (uint reprojection = 0u;
         reprojection < (_GIUseMotionVectors != 0u ? 2u : 1u);
         reprojection++)
    {
        float2 predictedUv = predictedUvs[reprojection];
        bool projectionValid = reprojection == 0u ? previousClip.w > 0.0 : true;
        if (!projectionValid || any(predictedUv <= 0.0) || any(predictedUv >= 1.0))
            continue;
        int2 predictedPixel = clamp(
            (int2)(predictedUv * float2(width, height)), 0, int2(width, height) - 1);

        // Low-resolution history and full-resolution motion do not share texel centres.
        // Search the local footprint for both predictions and select by reconstructed
        // world-space agreement, not by which reprojection source happened to run first.
        [unroll]
        for (int y = -1; y <= 1; y++)
        [unroll]
        for (int x = -1; x <= 1; x++)
        {
            int2 candidatePixel = clamp(
                predictedPixel + int2(x, y), 0, int2(width, height) - 1);
            float4 previousGeometry = _GIGeometryHistoryRead.Load(int3(candidatePixel, 0));
            if ((uint)round(previousGeometry.w) != currentMaterial)
                continue;

            float3 previousNormal = GIUnpackHistoryNormal(previousGeometry.xy);
            float normalAgreement = dot(previousNormal, currentNormal);
            if (normalAgreement < 0.85)
                continue;

            float2 candidateUv = (float2(candidatePixel) + 0.5) / float2(width, height);
            float3 previousPosition = ComputeWorldSpacePosition(
                candidateUv, previousGeometry.z, _GIPreviousInverseViewProjection);
            float3 positionDelta = previousPosition - currentPosition;
            float planeError = abs(dot(positionDelta, currentNormal));
            float distanceSquared = dot(positionDelta, positionDelta);
            // A fixed 0.7 m radius can reproject onto a neighbouring instance when many
            // copies share the same coarse material signature (the stress scene is exactly
            // such a case).  Scale with projected footprint, but cap the search tightly so
            // disocclusions become new history instead of inheriting another object's light.
            float cameraDistance = length(currentPosition - _GICameraPosition);
            float positionLimit = clamp(cameraDistance * 0.0015, 0.03, 0.25);
            float planeLimit = clamp(cameraDistance * 0.0005, 0.015, 0.08);
            if (planeError > planeLimit ||
                distanceSquared > positionLimit * positionLimit)
                continue;

            float score = distanceSquared + planeError * 2.0 +
                          (1.0 - normalAgreement) * 0.1 +
                          dot(float2(x, y), float2(x, y)) * 0.002;
            if (score < bestScore)
            {
                bestScore = score;
                bestPixel = candidatePixel;
            }
        }
    }

    if (any(bestPixel < 0))
        return 0.0;
    previousPixel = (uint2)bestPixel;
    previousUv = (float2(bestPixel) + 0.5) / float2(width, height);
    return 1.0;
}

[numthreads(8, 8, 1)]
void TemporalDiffuse(uint3 dispatchId : SV_DispatchThreadID)
{
    uint diffuseWidth, diffuseHeight;
    _GICurrentDiffuseRead.GetDimensions(diffuseWidth, diffuseHeight);
    uint2 diffuseSize = uint2(diffuseWidth, diffuseHeight);
    if (any(dispatchId.xy >= diffuseSize))
        return;
    float2 uv = GIUvFromPixel(dispatchId.xy, diffuseSize);
    float4 current = _GICurrentDiffuseRead.Load(int3(dispatchId.xy, 0));
    if (_GIEnableDiffuse == 0u || GIIsBackground(current.a))
    {
        _GIDiffuseReservoirRadianceWrite[dispatchId.xy] = 0.0;
        _GIDiffuseReservoirRayWrite[dispatchId.xy] = 0.0;
        _GIDiffuseReservoirStatsWrite[dispatchId.xy] = 0.0;
        _GIDiffuseReservoirHitWrite[dispatchId.xy] = 0.0;
        return;
    }
    float4 currentRay = _GICurrentDiffuseRayRead.Load(int3(dispatchId.xy, 0));
    float4 currentStats = _GICurrentDiffuseStatsRead.Load(int3(dispatchId.xy, 0));
    float4 currentHit = _GICurrentDiffuseHitRead.Load(int3(dispatchId.xy, 0));
    float3 currentNormal = GILoadNormal(uv);
    bool hasCurrentSample = currentStats.x > 0.0 && currentStats.y > 0.0;
    float3 selectedRadiance = hasCurrentSample ? current.rgb : 0.0;
    float3 selectedDirection = hasCurrentSample ? normalize(currentRay.xyz) : currentNormal;
    float selectedDistance = hasCurrentSample ? currentRay.w : _GIMaxTraceDistance;
    float3 selectedHitNormal = hasCurrentSample ? GIDecodeDiffuseHitNormal(currentHit) : currentNormal;
    float selectedHitValid = hasCurrentSample ? currentHit.w : 0.0;
    uint2 selectedStableId = hasCurrentSample ? GIDecodeDiffuseHitStableId(currentHit) : 0u;
    float3 currentPosition = GIWorldPosition(uv, current.a);
    float3 currentOriginForPdf = currentPosition + currentNormal *
        max(0.01, _GIClipmapLevels[0].cellSize * 0.1);
    float selectedSourcePdf = hasCurrentSample
        ? GIDiffuseMixturePdf(currentOriginForPdf, currentNormal, selectedDirection)
        : 1.0 / PI;
    float selectedAge = 0.0;
    float selectedTarget = hasCurrentSample ? max(currentStats.z, 1e-5) : 1e-5;
    float weightSum = max(0.0, currentStats.x);
    float sampleCount = max(0.0, currentStats.y);
    // TraceDiffuseScreen already performed the expensive two-source, 3x3 world-space
    // reprojection search to budget disocclusion rays.  Reuse that exact answer here and
    // in the denoiser instead of repeating 18 geometry-history tests three times/pixel.
    uint reprojection = _GICurrentDiffuseReprojectionRead.Load(
        int3(dispatchId.xy, 0));
    float validity = reprojection != 0xffffffffu ? 1.0 : 0.0;
    uint2 previousPixel = validity > 0.0
        ? uint2(reprojection % diffuseSize.x, reprojection / diffuseSize.x) : 0u;
    float2 previousUv = validity > 0.0
        ? GIUvFromPixel(previousPixel, diffuseSize) : uv;
    if (validity > 0.0)
    {
        float4 previousRadiance = _GIDiffuseReservoirRadianceRead.Load(int3(previousPixel, 0));
        float4 previousRay = _GIDiffuseReservoirRayRead.Load(int3(previousPixel, 0));
        float4 previousStats = _GIDiffuseReservoirStatsRead.Load(int3(previousPixel, 0));
        float4 previousHit = _GIDiffuseReservoirHitRead.Load(int3(previousPixel, 0));
        float4 previousGeometry = _GIGeometryHistoryRead.Load(int3(previousPixel, 0));
        if (previousStats.y > 0.0)
        {
            if (_GIEnableTraceCounters != 0u)
                InterlockedAdd(_GITraceCounters[8], 1u);
            float reusedCount = min(20.0, previousStats.y);
            if (previousStats.x <= 0.0)
            {
                // A fully dark previous reservoir still represents M traced proposals.
                // Carrying only reservoirs that selected light creates temporal bright bias.
                sampleCount += reusedCount;
            }
            else
            {
            float3 previousOrigin = ComputeWorldSpacePosition(
                previousUv, previousGeometry.z, _GIPreviousInverseViewProjection);
            float3 previousNormal = GIUnpackHistoryNormal(previousGeometry.xy);
            previousOrigin += previousNormal * max(0.01, _GIClipmapLevels[0].cellSize * 0.1);
            float3 currentOrigin = currentPosition + currentNormal *
                                   max(0.01, _GIClipmapLevels[0].cellSize * 0.1);
            bool skyRay = previousHit.w < 0.5 ||
                          previousRay.w >= _GIMaxTraceDistance * 0.999;
            float3 previousHitNormal = GIDecodeDiffuseHitNormal(previousHit);
            uint2 previousStableId = GIDecodeDiffuseHitStableId(previousHit);
            float3 hitPoint = previousOrigin + normalize(previousRay.xyz) * previousRay.w;
            float3 shiftedDirection = skyRay
                ? normalize(previousRay.xyz) : normalize(hitPoint - currentOrigin);
            float shiftedDistance = skyRay
                ? _GIMaxTraceDistance : length(hitPoint - currentOrigin);
            float secondaryFacing = skyRay ? 1.0 :
                (dot(previousHitNormal, -shiftedDirection) > 0.05 ? 1.0 : 0.0);
            // A freshly traced/validated finite path remains valid while the receiver is
            // effectively stationary. Revalidate it periodically (or immediately after
            // motion) instead of repeating the same long world march every frame. This is
            // a bounded visibility cache, not an unchecked history shortcut: endpoint ID,
            // geometry reprojection and facing tests above still have to match.
            bool reusedVisibility = !skyRay && previousStats.w < 4.0 &&
                length(previousOrigin - currentOrigin) <=
                    max(0.02, _GIClipmapLevels[0].cellSize * 0.25) &&
                !any(previousStableId == 0u);
            bool strictVisibility = false;
            bool deferredVisibility = false;
            if (!skyRay && !reusedVisibility)
            {
                bool scheduledValidation = GIValidationGate(
                    dispatchId.xy, 0u, diffuseSize,
                    _GIDiffuseVisibilityBudget, 1u,
                    0x243f6a88u, 5.0);
                if (scheduledValidation && GIConsumeDiffuseVisibilityBudget())
                {
                    strictVisibility = GIStrictReconnectionVisibility(
                        currentOrigin, hitPoint, previousStableId, 1.0);
                }
                else
                {
                    // A hard ray budget is an amortization policy, not evidence that a
                    // previously validated path became occluded.  Rejecting every path
                    // which lost the budget lottery injected a dark sample into most
                    // reservoirs every fourth frame.  Defer that validation while the
                    // receiver and persistent endpoint identity remain unchanged.
                    deferredVisibility = !any(previousStableId == 0u);
                }
                if (!strictVisibility && !deferredVisibility)
                    secondaryFacing = 0.0;
            }
            float shiftedTarget = GIDiffuseTarget(
                previousRadiance.rgb, currentNormal, shiftedDirection) * secondaryFacing;
            if (shiftedTarget <= 1e-6)
            {
                // The shifted representative is a valid zero-contribution proposal.
                sampleCount += reusedCount;
            }
            else
            {
                if (_GIEnableTraceCounters != 0u)
                    InterlockedAdd(_GITraceCounters[9], 1u);
                // Keep the temporal reservoir large enough for one low-SPP path to
                // actually converge.  Ten was an accidental cap left over from the
                // first diagnostic implementation; AKGI/ReSTIR uses 20 temporal
                // candidates before spatial reuse.
                // Persistent Spatial reservoirs used to carry as many as 100 effective
                // samples. Reusing their full W while declaring only M=20 multiplies the
                // mean weight by up to five every frame. Normalize W to the reused M before
                // applying target/Jacobian shifts; this also makes old history safe after a
                // shader hot reload.
                float reusedWeightSum = previousStats.x *
                    (reusedCount / max(previousStats.y, 1.0));
                float jacobian = GIReconnectionJacobian(
                    previousRay.xyz, previousRay.w, shiftedDirection, shiftedDistance,
                    previousHitNormal, previousHit.w);
                float targetRatio = min(
                    shiftedTarget / max(previousStats.z, 1e-6), 4.0);
                float candidateWeight = reusedWeightSum *
                    targetRatio * jacobian * validity;
                candidateWeight = GIClampMergedReservoirWeight(
                    candidateWeight, reusedCount, weightSum, sampleCount, 8.0);
                uint seed = dispatchId.x + dispatchId.y * diffuseSize.x +
                            _GIFrameIndex * 0x9e3779b9u;
                if (GIReservoirUpdate(weightSum, sampleCount, candidateWeight,
                                      reusedCount, GIRandom2(seed).x))
                {
                    selectedRadiance = previousRadiance.rgb;
                    selectedDirection = shiftedDirection;
                    selectedDistance = shiftedDistance;
                    selectedHitNormal = previousHitNormal;
                    selectedHitValid = previousHit.w;
                    selectedStableId = previousStableId;
                    selectedSourcePdf = max(previousRadiance.a, 1e-6);
                    selectedAge = skyRay ? min(previousStats.w + 1.0, 255.0) :
                        (strictVisibility ? 0.0 : min(previousStats.w + 1.0, 12.0));
                    selectedTarget = max(shiftedTarget, 1e-5);
                }
            }
            }
        }
    }
    GIReservoirLimit(weightSum, sampleCount, 20.0);
    _GIDiffuseReservoirRadianceWrite[dispatchId.xy] = float4(
        selectedRadiance, selectedSourcePdf);
    _GIDiffuseReservoirRayWrite[dispatchId.xy] = float4(selectedDirection, selectedDistance);
    _GIDiffuseReservoirStatsWrite[dispatchId.xy] = float4(
        weightSum, sampleCount, selectedTarget, selectedAge);
    _GIDiffuseReservoirHitWrite[dispatchId.xy] = GIEncodeDiffuseHit(
        selectedHitNormal, selectedHitValid, selectedStableId);
}

float3 GIDiffuseTonemap(float3 color)
{
    return color / (1.0 + GILuminance(color));
}

float3 GIDiffuseInverseTonemap(float3 color)
{
    return color / max(1.0 - GILuminance(color), 1e-3);
}

[numthreads(8, 8, 1)]
void SpatialDiffuse(uint3 dispatchId : SV_DispatchThreadID)
{
    if (any(dispatchId.xy >= _GIDiffuseSize))
        return;
    float2 uv = GIUvFromPixel(dispatchId.xy, _GIDiffuseSize);
    float depth = GILoadDepth(uv);
    if (_GIEnableDiffuse == 0u || GIIsBackground(depth))
    {
        _GICurrentDiffuse[dispatchId.xy] = 0.0;
        _GIDiffuseReservoirRadianceWrite[dispatchId.xy] = 0.0;
        _GIDiffuseReservoirRayWrite[dispatchId.xy] = 0.0;
        _GIDiffuseReservoirStatsWrite[dispatchId.xy] = 0.0;
        _GIDiffuseReservoirHitWrite[dispatchId.xy] = 0.0;
        return;
    }

    float3 centerNormal = GILoadNormal(uv);
    float3 centerPosition = GIWorldPosition(uv, depth);
    uint centerMaterial = GIMaterialSignature(uv);
    float originOffset = max(0.01, _GIClipmapLevels[0].cellSize * 0.1);
    float3 centerOrigin = centerPosition + centerNormal * originOffset;
    float4 centerRadianceRecord = _GIDiffuseReservoirRadianceRead.Load(int3(dispatchId.xy, 0));
    float4 centerRayRecord = _GIDiffuseReservoirRayRead.Load(int3(dispatchId.xy, 0));
    float4 centerStats = _GIDiffuseReservoirStatsRead.Load(int3(dispatchId.xy, 0));
    float4 centerHit = _GIDiffuseReservoirHitRead.Load(int3(dispatchId.xy, 0));

    float3 selectedRadiance = centerRadianceRecord.rgb;
    float3 selectedDirection = normalize(centerRayRecord.xyz);
    float selectedDistance = centerRayRecord.w;
    float3 selectedHitNormal = GIDecodeDiffuseHitNormal(centerHit);
    float selectedHitValid = centerHit.w;
    uint2 selectedStableId = GIDecodeDiffuseHitStableId(centerHit);
    float selectedSourcePdf = max(centerRadianceRecord.a, 1e-6);
    float selectedAge = centerStats.w;
    float selectedTarget = max(centerStats.z, 1e-6);
    // Spatial neighbours are already temporally resampled reservoirs with heavily
    // overlapping histories. Treat each reservoir as one representative estimate by
    // preserving W/M, rather than pretending that all of its M paths are independent.
    // Reusing full M recursively made a single red/cyan emitter path own a whole screen
    // patch for many frames.
    float centerInputCount = max(0.0, centerStats.y);
    float weightSum = centerInputCount > 0.0
        ? max(0.0, centerStats.x) / centerInputCount : 0.0;
    float reservoirCount = centerInputCount > 0.0 ? 1.0 : 0.0;
    // Keep an unmodified center fallback. Spatial candidates are selected using cheap
    // geometry/radiometric tests first; only the final finite winner pays for strict
    // world visibility. If that one reconnection fails, restoring both the payload and
    // W/M avoids treating several unvalidated neighbours as black samples.
    // The aligned 2x2 lanes are one directional screen probe.  ReSTIR selection alone
    // still emits one coloured representative and therefore does not reduce RGB variance.
    // Form a geometry-gated vector estimate from the four persistent temporal lanes.  At
    // one ray/probe only one lane is refreshed per frame; reading CurrentDiffuse here used
    // to see the other three lanes as explicit nulls, so the advertised four-direction
    // reconstruction was in fact still a single red/cyan representative.  The temporal
    // reservoirs retain the four independently rotated strata without adding world rays.
    float3 probeEstimateSum = 0.0;
    float probeEstimateWeight = 0.0;
    uint probeEstimateCount = 0u;
    bool compactProbeGrid = _GIDiffuseSize.x * 4u < _GIFullSize.x ||
                            _GIDiffuseSize.y * 4u < _GIFullSize.y;
    int2 alignedProbeBase = compactProbeGrid
        ? (int2)dispatchId.xy
        : (int2)(dispatchId.xy & uint2(~1u, ~1u));
    uint laneCount = compactProbeGrid ? 1u : 4u;
    [unroll]
    for (uint lane = 0u; lane < 4u; lane++)
    {
        if (lane >= laneCount)
            break;
        int2 lanePixel = clamp(
            alignedProbeBase + int2(lane & 1u, (lane >> 1u) & 1u),
            0, (int2)_GIDiffuseSize - 1);
        float2 laneUv = GIUvFromPixel((uint2)lanePixel, _GIDiffuseSize);
        float laneDepth = GILoadDepth(laneUv);
        if (GIIsBackground(laneDepth) ||
            GIMaterialSignature(laneUv) != centerMaterial)
            continue;
        float3 laneNormal = GILoadNormal(laneUv);
        float normalAgreement = dot(centerNormal, laneNormal);
        if (normalAgreement < 0.90)
            continue;
        float3 lanePosition = GIWorldPosition(laneUv, laneDepth);
        float3 receiverOffset = lanePosition - centerPosition;
        float receiverDistance = length(receiverOffset);
        float planeError = abs(dot(receiverOffset, centerNormal));
        float cameraDistance = length(centerPosition - _GICameraPosition);
        // Bound the far-field footprint. The old slope admitted separate repeated props
        // into one 2x2 directional probe and made one coloured path cover both objects.
        float receiverLimit = min(0.50, max(0.12, cameraDistance * 0.0015));
        if (receiverDistance > receiverLimit ||
            planeError > max(0.025, receiverDistance * 0.05))
            continue;

        float4 laneStats = _GIDiffuseReservoirStatsRead.Load(int3(lanePixel, 0));
        if (laneStats.y <= 0.0)
            continue;
        float geometryWeight = pow(saturate(normalAgreement), 16.0) *
            exp2(-planeError * 24.0);
        float3 laneEstimate = 0.0;
        if (laneStats.x > 0.0)
        {
            float4 laneRadiance = _GIDiffuseReservoirRadianceRead.Load(
                int3(lanePixel, 0));
            float4 laneRay = _GIDiffuseReservoirRayRead.Load(int3(lanePixel, 0));
            float4 laneHit = _GIDiffuseReservoirHitRead.Load(int3(lanePixel, 0));
            float3 laneOrigin = lanePosition + laneNormal * originOffset;
            bool skyPath = laneHit.w < 0.5 ||
                           laneRay.w >= _GIMaxTraceDistance * 0.999;
            // A finite lane is a segment from its own receiver. It cannot be shifted like
            // a sky direction unless both receivers lie inside the same C0-cell-scale
            // neighbourhood. The path reservoir below already follows this rule; the
            // displayed vector estimate must follow it too.
            bool locallyReusableFinitePath = skyPath ||
                (receiverDistance <= max(0.08, _GIClipmapLevels[0].cellSize) &&
                 planeError <= max(0.02, _GIClipmapLevels[0].cellSize * 0.15) &&
                 laneHit.w >= 0.5 &&
                 !any(GIDecodeDiffuseHitStableId(laneHit) == 0u));
            if (!locallyReusableFinitePath)
                continue;
            float3 hitNormal = GIDecodeDiffuseHitNormal(laneHit);
            float3 hitPosition = laneOrigin + normalize(laneRay.xyz) * laneRay.w;
            float3 shiftedDirection = skyPath
                ? normalize(laneRay.xyz) : normalize(hitPosition - centerOrigin);
            float shiftedDistance = skyPath
                ? _GIMaxTraceDistance : length(hitPosition - centerOrigin);
            float secondaryFacing = skyPath ? 1.0 :
                (dot(hitNormal, -shiftedDirection) > 0.05 ? 1.0 : 0.0);
            float shiftedTarget = GIDiffuseTarget(
                laneRadiance.rgb, centerNormal, shiftedDirection) * secondaryFacing;
            if (shiftedTarget > 1e-6)
            {
                float shiftedWeight = laneStats.x * min(
                    shiftedTarget / max(laneStats.z, 1e-6), 2.0) *
                    clamp(GIReconnectionJacobian(
                        laneRay.xyz, laneRay.w, shiftedDirection, shiftedDistance,
                        hitNormal, laneHit.w), 0.5, 2.0);
                laneEstimate = GIDiffuseReservoirEstimate(
                    laneRadiance.rgb, shiftedDirection, centerNormal,
                    shiftedTarget, shiftedWeight, laneStats.y);
                laneEstimate = GIClampDiffuseCandidate(
                    laneEstimate * (1.0 / PI)) * PI;
            }
        }
        // Dark/null proposals must participate or the reconstruction is biased bright.
        // Average the display estimator in compressed-radiance space. The persistent
        // reservoir keeps the unmodified HDR path and remains the source of truth; this
        // only prevents one rare cyan/emissive lane from painting the entire 2x2 probe.
        probeEstimateSum += GIDiffuseTonemap(max(0.0, laneEstimate)) * geometryWeight;
        probeEstimateWeight += geometryWeight;
        probeEstimateCount++;
    }

    uint spatialSampleCount = min(_GIDiffuseSpatialSamples, 8u);
    float radius = max(1.0, _GIDiffuseSpatialRadius);
    // Keep the neighbour footprint fixed in screen space. Temporal candidates already use
    // a low-discrepancy sequence; rotating this large footprint every frame was visible as
    // quarter-resolution bright/dark blocks swapping places.
    uint baseSeed = dispatchId.x + dispatchId.y * _GIDiffuseSize.x;
    uint selectionSeed = baseSeed ^ (_GIFrameIndex * 0x9e3779b9u);
    float rotation = GIRandom2(baseSeed).x * TWO_PI;
    [unroll]
    for (uint sampleIndex = 0u; sampleIndex < 8u; sampleIndex++)
    {
        if (sampleIndex >= spatialSampleCount)
            break;
        int2 samplePixel;
        float2 sampleOffset;
        if (!compactProbeGrid && sampleIndex < 3u)
        {
            // First consume the other three lanes of the aligned 2x2 directional probe.
            // These lanes cover complementary cosine strata without adding a world ray.
            uint centerLane = (dispatchId.x & 1u) | ((dispatchId.y & 1u) << 1u);
            uint sampleLane = (centerLane + sampleIndex + 1u) & 3u;
            int2 probeBase = (int2)(dispatchId.xy & uint2(~1u, ~1u));
            samplePixel = probeBase + int2(sampleLane & 1u, (sampleLane >> 1u) & 1u);
            samplePixel = clamp(samplePixel, 0, (int2)_GIDiffuseSize - 1);
            sampleOffset = (float2)(samplePixel - (int2)dispatchId.xy);
        }
        else
        {
            float sampleFraction = ((float)sampleIndex + 0.5) /
                                   max((float)spatialSampleCount, 1.0);
            float angle = rotation + (float)sampleIndex * 2.39996323;
            sampleOffset = float2(cos(angle), sin(angle)) *
                           (1.0 + (radius - 1.0) * sqrt(sampleFraction));
            samplePixel = clamp((int2)dispatchId.xy + (int2)round(sampleOffset),
                                0, (int2)_GIDiffuseSize - 1);
        }
        float2 sampleUv = GIUvFromPixel((uint2)samplePixel, _GIDiffuseSize);
        float sampleDepth = GILoadDepth(sampleUv);
        if (GIIsBackground(sampleDepth) ||
            GIMaterialSignature(sampleUv) != centerMaterial)
            continue;
        float3 sampleNormal = GILoadNormal(sampleUv);
        float normalAgreement = dot(centerNormal, sampleNormal);
        if (normalAgreement < 0.85)
            continue;
        float3 samplePosition = GIWorldPosition(sampleUv, sampleDepth);
        float3 surfaceOffset = samplePosition - centerPosition;
        float surfaceDistance = length(surfaceOffset);
        float cameraDistance = length(centerPosition - _GICameraPosition);
        float maximumSurfaceDistance = min(0.75, max(
            0.16, cameraDistance * 0.0012 * max(1.0, length(sampleOffset))));
        if (surfaceDistance > maximumSurfaceDistance)
            continue;
        float planeError = abs(dot(surfaceOffset, centerNormal));
        if (planeError > max(0.05, surfaceDistance * 0.08))
            continue;
        float reconstructionWeight = pow(saturate(normalAgreement), 16.0) *
            exp2(-planeError * 24.0);

        float4 candidateRadianceRecord =
            _GIDiffuseReservoirRadianceRead.Load(int3(samplePixel, 0));
        float4 candidateRay = _GIDiffuseReservoirRayRead.Load(int3(samplePixel, 0));
        float4 candidateStats = _GIDiffuseReservoirStatsRead.Load(int3(samplePixel, 0));
        float4 candidateHit = _GIDiffuseReservoirHitRead.Load(int3(samplePixel, 0));
        if (candidateStats.y <= 0.0)
            continue;

        const float reusedCandidateCount = 1.0;
        if (candidateStats.x <= 0.0)
        {
            // Geometry-compatible null reservoirs are part of the quadrature as well.
            // They add no W and cannot be selected, but omitting their M biases the probe
            // toward whichever lane happened to see sky or an emitter.
            reservoirCount += reusedCandidateCount;
            if (compactProbeGrid)
            {
                probeEstimateWeight += reconstructionWeight;
                probeEstimateCount++;
            }
            continue;
        }

        float3 sampleOrigin = samplePosition + sampleNormal * originOffset;
        bool skyPath = candidateHit.w < 0.5 ||
                       candidateRay.w >= _GIMaxTraceDistance * 0.999;
        float3 candidateHitNormal = GIDecodeDiffuseHitNormal(candidateHit);
        uint2 candidateStableId = GIDecodeDiffuseHitStableId(candidateHit);
        if (!skyPath && any(candidateStableId == 0u))
            continue;
        float3 hitPosition = sampleOrigin + normalize(candidateRay.xyz) * candidateRay.w;
        float3 shiftedDirection = skyPath
            ? normalize(candidateRay.xyz) : normalize(hitPosition - centerOrigin);
        float shiftedDistance = skyPath
            ? _GIMaxTraceDistance : length(hitPosition - centerOrigin);
        bool reusableVisibility = !skyPath && candidateHit.w >= 0.5 &&
            candidateStats.w < 4.0 &&
            length(sampleOrigin - centerOrigin) <=
                max(0.08, _GIClipmapLevels[0].cellSize) &&
            planeError <= max(0.02, _GIClipmapLevels[0].cellSize * 0.15) &&
            normalAgreement >= 0.90;
        float secondaryFacing = skyPath ? 1.0 :
            (dot(candidateHitNormal, -shiftedDirection) > 0.05 ? 1.0 : 0.0);
        float shiftedTarget = GIDiffuseTarget(
            candidateRadianceRecord.rgb, centerNormal, shiftedDirection) * secondaryFacing;
        if (shiftedTarget <= 1e-6)
        {
            reservoirCount += reusedCandidateCount;
            if (compactProbeGrid)
            {
                probeEstimateWeight += reconstructionWeight;
                probeEstimateCount++;
            }
            continue;
        }
        // Wide finite-path reconnection was the remaining expensive spatial visibility
        // march and a major source of coloured islands.  Temporal reuse already validates
        // long paths. Spatial reuse is restricted to sky or a tight coplanar receiver
        // neighbourhood, where the cached segment is locally reusable.
        if (!skyPath && !reusableVisibility)
            continue;
        float targetRatio = min(
            shiftedTarget / max(candidateStats.z, 1e-6), 4.0);
        // Geometry compatibility above is an acceptance test, not radiometric
        // throughput. Multiplying W by a bilateral weight while adding the candidate's
        // full M made W/M shrink with every spatial merge and darkened the image whenever
        // Spatial Samples was enabled.
        float candidateMeanWeight = candidateStats.x / max(candidateStats.y, 1.0);
        float reconnectionJacobian = GIReconnectionJacobian(
            candidateRay.xyz, candidateRay.w, shiftedDirection, shiftedDistance,
            candidateHitNormal, candidateHit.w);
        float candidateWeight = candidateMeanWeight * targetRatio *
            reconnectionJacobian;
        if (compactProbeGrid && all(samplePixel != (int2)dispatchId.xy))
        {
            // Keep path selection as a persistent ReSTIR reservoir, but reconstruct the
            // displayed diffuse irradiance as a vector mean of independent neighbouring
            // reservoirs.  Selecting one representative is unbiased yet produces exactly
            // the red/cyan speckle the user observed at one SPP; averaging their W/M
            // estimates removes that variance without tracing additional rays.
            float shiftedWeightSum = candidateStats.x * min(targetRatio, 2.0) *
                clamp(reconnectionJacobian, 0.5, 2.0);
            float3 candidateEstimate = GIDiffuseReservoirEstimate(
                candidateRadianceRecord.rgb, shiftedDirection, centerNormal,
                shiftedTarget, shiftedWeightSum, candidateStats.y);
            candidateEstimate = GIClampDiffuseCandidate(
                candidateEstimate * (1.0 / PI)) * PI;
            probeEstimateSum += GIDiffuseTonemap(max(0.0, candidateEstimate)) *
                reconstructionWeight;
            probeEstimateWeight += reconstructionWeight;
            probeEstimateCount++;
        }
        candidateWeight = GIClampMergedReservoirWeight(
            candidateWeight, reusedCandidateCount,
            weightSum, reservoirCount, 4.0);
        // The strict visibility allocator is an RW buffer. Keep SpatialDiffuse below the
        // D3D11 eight-UAV limit by writing only final colour + persistent payload; the
        // duplicated current ray/hit/stats records are no longer consumed after this pass.
        if (GIReservoirUpdate(
                weightSum, reservoirCount, candidateWeight,
                reusedCandidateCount,
                GIRandom2(selectionSeed ^ GIHash(sampleIndex + 1u)).y))
        {
            selectedRadiance = candidateRadianceRecord.rgb;
            selectedDirection = shiftedDirection;
            selectedDistance = shiftedDistance;
            selectedHitNormal = candidateHitNormal;
            selectedHitValid = candidateHit.w;
            selectedStableId = candidateStableId;
            selectedSourcePdf = max(candidateRadianceRecord.a, 1e-6);
            selectedAge = skyPath ? candidateStats.w :
                (reusableVisibility ? min(candidateStats.w + 1.0, 4.0) : 0.0);
            selectedTarget = max(shiftedTarget, 1e-5);
        }
    }

    // The spatial stage combines N+1 representative reservoirs, not their recursively
    // overlapping path counts. Final colour/moments history remains the long accumulator.
    GIReservoirLimit(weightSum, reservoirCount,
                     (float)spatialSampleCount + 1.0);
    float3 estimate = GIDiffuseReservoirEstimate(
        selectedRadiance, selectedDirection, centerNormal,
        selectedTarget, weightSum, reservoirCount);
    if (probeEstimateCount >= 2u && probeEstimateWeight > 1e-5)
    {
        float3 probeEstimate = GIDiffuseInverseTonemap(
            probeEstimateSum / probeEstimateWeight);
        float probeConfidence = saturate((float)(probeEstimateCount - 1u) / 3.0);
        float reconstructionStrength = compactProbeGrid ? 0.90 : 0.80;
        estimate = lerp(
            estimate, probeEstimate, probeConfidence * reconstructionStrength);
    }
    // Bound the final estimator as well as individual paths: reconnection ratios can still
    // amplify a legal candidate. The limit is expressed as radiance; irradiance is PI times
    // that scale for cosine sampling.
    estimate = GIClampDiffuseCandidate(estimate * (1.0 / PI)) * PI;
    _GICurrentDiffuse[dispatchId.xy] = float4(max(0.0, estimate), depth);
    // Spatial reuse is the final path reservoir for this pixel. Persist it instead of
    // throwing it away and making the next frame restart from the temporal-only result.
    _GIDiffuseReservoirRadianceWrite[dispatchId.xy] = float4(
        selectedRadiance, selectedSourcePdf);
    _GIDiffuseReservoirRayWrite[dispatchId.xy] = float4(
        selectedDirection, selectedDistance);
    float persistentWeightSum = weightSum;
    float persistentCount = reservoirCount;
    // Persist only the representative spatial set. Temporal adds one fresh proposal next
    // frame; final colour history, rather than a path locked at M=20, performs convergence.
    GIReservoirLimit(persistentWeightSum, persistentCount, 8.0);
    _GIDiffuseReservoirStatsWrite[dispatchId.xy] = float4(
        persistentWeightSum, persistentCount, selectedTarget, selectedAge);
    _GIDiffuseReservoirHitWrite[dispatchId.xy] = GIEncodeDiffuseHit(
        selectedHitNormal, selectedHitValid, selectedStableId);
}

float3 GIClipDiffuseHistory(Texture2D<float4> currentTexture, uint2 pixel,
                            uint2 size, float3 history, float historyLength)
{
    float2 centerUv = GIUvFromPixel(pixel, size);
    float3 centerNormal = GILoadNormal(centerUv);
    uint centerMaterial = GIMaterialSignature(centerUv);
    float3 mean = 0.0;
    float3 secondMoment = 0.0;
    float count = 0.0;
    [unroll]
    for (int y = -1; y <= 1; y++)
    [unroll]
    for (int x = -1; x <= 1; x++)
    {
        uint2 samplePixel = (uint2)clamp(
            (int2)pixel + int2(x, y), 0, (int2)size - 1);
        float4 sampleValue = currentTexture.Load(int3(samplePixel, 0));
        if (GIIsBackground(sampleValue.a))
            continue;
        float2 sampleUv = GIUvFromPixel(samplePixel, size);
        if (GIMaterialSignature(sampleUv) != centerMaterial ||
            dot(GILoadNormal(sampleUv), centerNormal) < 0.85)
            continue;
        float3 mapped = GIDiffuseTonemap(max(0.0, sampleValue.rgb));
        mean += mapped;
        secondMoment += mapped * mapped;
        count += 1.0;
    }
    float3 mappedHistory = GIDiffuseTonemap(max(0.0, history));
    if (count <= 0.0 || historyLength >= 4.0)
        return mappedHistory;
    mean /= count;
    float3 variance = max(0.0, secondMoment / count - mean * mean);
    // Do not force a stable red history into a one-frame cyan neighbourhood (or vice
    // versa). Luminance moments handle exposure changes; this wider RGB envelope lets
    // temporal blending average chroma noise instead of making coloured patches switch.
    float3 extent = max(2.5 * sqrt(variance), 0.025 + mean * 0.12);
    return clamp(mappedHistory,
                 max(0.0, mean - extent), mean + extent);
}

float3 GIBootstrapDiffuse(Texture2D<float4> currentTexture, uint2 pixel,
                          uint2 size, float3 current)
{
    float2 centerUv = GIUvFromPixel(pixel, size);
    float3 centerNormal = GILoadNormal(centerUv);
    uint centerMaterial = GIMaterialSignature(centerUv);
    float3 mean = 0.0;
    float3 secondMoment = 0.0;
    float count = 0.0;
    [unroll]
    for (int y = -2; y <= 2; y++)
    [unroll]
    for (int x = -2; x <= 2; x++)
    {
        uint2 samplePixel = (uint2)clamp(
            (int2)pixel + int2(x, y), 0, (int2)size - 1);
        float4 sampleValue = currentTexture.Load(int3(samplePixel, 0));
        if (GIIsBackground(sampleValue.a))
            continue;
        float2 sampleUv = GIUvFromPixel(samplePixel, size);
        if (GIMaterialSignature(sampleUv) != centerMaterial ||
            dot(GILoadNormal(sampleUv), centerNormal) < 0.85)
            continue;
        float3 mapped = GIDiffuseTonemap(max(0.0, sampleValue.rgb));
        mean += mapped;
        secondMoment += mapped * mapped;
        count += 1.0;
    }

    // A thin silhouette may have no useful same-surface neighbourhood.  In that case
    // retaining the center is safer than borrowing unrelated lighting across an edge.
    if (count < 2.0)
        return max(0.0, current);
    mean /= count;
    float3 variance = max(0.0, secondMoment / count - mean * mean);
    float3 extent = max(2.0 * sqrt(variance), 0.012 + mean * 0.06);
    float3 mappedCurrent = GIDiffuseTonemap(max(0.0, current));
    float3 clippedCurrent = clamp(
        mappedCurrent, max(0.0, mean - extent), mean + extent);
    // This value seeds a multi-frame history, so retaining the noisy centre as the primary
    // value makes one initial sky ray decay for many frames.  The geometry-gated mean is a
    // better history prior; keep 20% of the centre to preserve legitimate local contrast.
    return GIDiffuseInverseTonemap(lerp(mean, clippedCurrent, 0.20));
}

bool GITryReadSurfaceSkyPrior(float3 position, float3 normal,
                              out float3 priorIrradiance, out float priorConfidence)
{
    priorIrradiance = 0.0;
    priorConfidence = 0.0;
    // The middle validity byte stores the amortized cosine sky visibility measured by
    // Surface Cache updates.  It is a safe primary-surface prior: unlike cached outgoing
    // radiance it contains no primary direct-light/albedo term that Final Gather could
    // accidentally count twice.
    [loop]
    for (uint levelIndex = 0u; levelIndex < GI_CLIPMAP_LEVEL_COUNT; levelIndex++)
    {
        GIClipmapLevelData level = _GIClipmapLevels[levelIndex];
        int3 worldCell = (int3)floor(position / level.cellSize);
        [unroll]
        for (uint layerIteration = 0u; layerIteration < 2u; layerIteration++)
        {
            // Prefer the dynamic overlay when both layers occupy the same cell.
            uint layer = 1u - layerIteration;
            int physicalBrick = -1;
            uint localCell = 0u;
            bool occupied = layer == 0u
                ? GIReadOccupancy(level, _GIStaticPageTable, _GIStaticOccupancy,
                                  worldCell, physicalBrick, localCell)
                : GIReadOccupancy(level, _GIDynamicPageTable, _GIDynamicOccupancy,
                                  worldCell, physicalBrick, localCell);
            if (!occupied)
                continue;
            uint address = (uint)physicalBrick * GI_SURFACE_WORDS_PER_BRICK + localCell;
            uint packedSurface = layer == 0u
                ? _GIStaticSurface[address] : _GIDynamicSurface[address];
            float normalAgreement = abs(dot(GIUnpackSurfaceNormal(packedSurface), normal));
            if (normalAgreement < 0.60)
                continue;
            uint validity = layer == 0u
                ? _GIStaticValidity[address] : _GIDynamicValidity[address];
            float confidence = (validity & 0xffu) / 255.0;
            if (confidence <= 0.05)
                continue;
            float skyVisibility = ((validity >> 8u) & 0xffu) / 255.0;
            priorIrradiance = GIEvaluateTODDiffuseSky(normal) *
                              (_GISkyIrradianceScale * skyVisibility);
            priorConfidence = confidence * saturate(
                (normalAgreement - 0.60) * (1.0 / 0.40));
            return true;
        }
    }
    return false;
}

[numthreads(8, 8, 1)]
void DenoiseDiffuse(uint3 dispatchId : SV_DispatchThreadID)
{
    uint width, height;
    _GICurrentDiffuseRead.GetDimensions(width, height);
    uint2 diffuseSize = uint2(width, height);
    if (any(dispatchId.xy >= diffuseSize))
        return;
    float4 current = _GICurrentDiffuseRead.Load(int3(dispatchId.xy, 0));
    if (_GIEnableDiffuse == 0u || GIIsBackground(current.a))
    {
        _GIDiffuseHistoryWrite[dispatchId.xy] = 0.0;
        _GIDiffuseMomentsWrite[dispatchId.xy] = 0.0;
        return;
    }

    float2 uv = GIUvFromPixel(dispatchId.xy, diffuseSize);
    float3 currentNormal = GILoadNormal(uv);
    uint reprojection = _GICurrentDiffuseReprojectionRead.Load(
        int3(dispatchId.xy, 0));
    float validity = reprojection != 0xffffffffu ? 1.0 : 0.0;
    uint2 previousPixel = validity > 0.0
        ? uint2(reprojection % diffuseSize.x, reprojection / diffuseSize.x) : 0u;
    float2 previousUv = validity > 0.0
        ? GIUvFromPixel(previousPixel, diffuseSize) : uv;
    float3 result = max(0.0, current.rgb);
    // Disoccluded pixels have no trustworthy temporal accumulator.  Clamp their first
    // one-SPP estimate against only same-material, same-normal neighbours in compressed
    // radiance space.  This prevents a single sky/emissive proposal from owning the new
    // region for tens of frames without adding work once temporal history is valid.
    if (validity <= 0.0)
    {
        result = GIBootstrapDiffuse(
            _GICurrentDiffuseRead, dispatchId.xy, diffuseSize, result);
        float3 worldPosition = GIWorldPosition(uv, current.a);
        float3 skyPrior;
        float skyPriorConfidence;
        if (GITryReadSurfaceSkyPrior(
                worldPosition, currentNormal, skyPrior, skyPriorConfidence))
        {
            // Only suppress a multi-stop first-frame overshoot.  The prior does not replace
            // the estimator and does not affect valid history, so emissive/direct bounce
            // detail can still converge upward while an indoor sky sample cannot seed a
            // long bright-to-dark tail.
            float resultLuminance = GILuminance(result);
            float priorLuminance = GILuminance(skyPrior);
            float priorCeiling = priorLuminance * 3.0 + 0.20;
            if (resultLuminance > priorCeiling)
            {
                float3 limited = result * (priorCeiling / max(resultLuminance, 1e-5));
                float overshootStops = log2(
                    (resultLuminance + 0.02) / (priorCeiling + 0.02));
                float priorWeight = skyPriorConfidence *
                    saturate((overshootStops - 0.5) * 0.5) * 0.75;
                result = lerp(result, limited, priorWeight);
            }
        }
    }
    float currentLuminance = GILuminance(result);
    float firstMoment = currentLuminance;
    float secondMoment = currentLuminance * currentLuminance;
    float historyLength = 1.0;
    float variance = 0.0;
    float reservoirAge = max(0.0,
        _GICurrentDiffuseStatsRead.Load(int3(dispatchId.xy, 0)).w);
    if (validity > 0.0)
    {
        float4 previous = _GIDiffuseHistoryRead.Load(int3(previousPixel, 0));
        if (!GIIsBackground(previous.a))
        {
            float4 previousMoments = _GIDiffuseMomentsRead.Load(int3(previousPixel, 0));
            float oldLength = clamp(previousMoments.z, 0.0, 64.0);
            // Min/max clipping to a single noisy frame erased almost all of a 0.98
            // history blend and produced persistent dark rows.  Clip in compressed
            // radiance space only while history is being established. Once geometry-
            // validated history has four frames, a noisy one-SPP neighbourhood is not a
            // valid rejection envelope and must not overwrite its RGB accumulator.
            float3 mappedPrevious = GIClipDiffuseHistory(
                _GICurrentDiffuseRead, dispatchId.xy, diffuseSize,
                max(0.0, previous.rgb), oldLength);
            float previousLuminance = GILuminance(max(0.0, previous.rgb));
            float logDifference = abs(log2(
                (currentLuminance + 0.02) / (previousLuminance + 0.02)));
            // React only to multi-stop changes.  Ordinary Monte-Carlo variation must not
            // collapse the configured history weight every frame.
            // A newly selected path (age=0) is precisely where rare emissive hits are
            // noisiest. Keep stronger final history for it; only let a persistent path
            // trigger reactive lighting change behaviour after several matching frames.
            float historyConfidence = saturate(oldLength * 0.125);
            float oldVariance = max(0.0, previousMoments.y -
                previousMoments.x * previousMoments.x);
            float noise = saturate(sqrt(oldVariance) /
                max(previousMoments.x + 0.05, 0.05));
            // A one-SPP dark/null result is common Monte-Carlo evidence, not proof that a
            // red or cyan bounce disappeared. The old asymmetric stale-energy test reset
            // history on every miss and froze coloured blotches in place. React quickly
            // to a convincing energy increase; let decreases decay through the bounded
            // accumulator until a separate fast-history signal is available.
            bool energyIncrease = currentLuminance > previousLuminance * 4.0 + 0.25;
            float reactive = energyIncrease
                ? saturate((logDifference - 2.0) * 0.30) * historyConfidence *
                  lerp(1.0, 0.35, noise)
                : 0.0;
            float configuredHistory = saturate(_GIDiffuseHistoryWeight);
            // High-variance one-SPP pixels need a longer accumulator, while stable pixels
            // retain the artist-facing response configured by Diffuse History Weight.
            // NRD keeps a separate short "fast history" so noisy long history does not
            // impose a one-second lighting lag. We retain one buffer, but enforce the same
            // response bound: high variance may extend the 0.88 default to ~16 frames,
            // never to the former ~33-frame 0.97 accumulator.
            float historyCap = configuredHistory > 0.0
                ? lerp(configuredHistory, max(configuredHistory, 0.94), noise)
                : 0.0;
            float historyWeight = min(historyCap, oldLength / (oldLength + 1.0)) *
                                  validity * lerp(1.0, 0.35, reactive);
            float3 mappedCurrent = GIDiffuseTonemap(result);
            result = GIDiffuseInverseTonemap(
                lerp(mappedCurrent, mappedPrevious, historyWeight));

            float momentHistory = min(0.97, oldLength / (oldLength + 1.0)) *
                                  validity * lerp(1.0, 0.20, reactive);
            firstMoment = lerp(currentLuminance, previousMoments.x, momentHistory);
            secondMoment = lerp(currentLuminance * currentLuminance,
                                previousMoments.y, momentHistory);
            historyLength = reactive > 0.75
                ? 1.0 : min(oldLength + 1.0, 64.0);
            variance = max(0.0, secondMoment - firstMoment * firstMoment);
        }
    }
    _GIDiffuseHistoryWrite[dispatchId.xy] = float4(max(0.0, result), current.a);
    _GIDiffuseMomentsWrite[dispatchId.xy] = float4(
        firstMoment, secondMoment, historyLength, variance);
}

int2 GIDiffuseFilterOffset(uint sampleIndex)
{
    if (sampleIndex == 1u) return int2( 1,  0);
    if (sampleIndex == 2u) return int2(-1,  0);
    if (sampleIndex == 3u) return int2( 0,  1);
    if (sampleIndex == 4u) return int2( 0, -1);
    if (sampleIndex == 5u) return int2( 1,  1);
    if (sampleIndex == 6u) return int2(-1,  1);
    if (sampleIndex == 7u) return int2( 1, -1);
    if (sampleIndex == 8u) return int2(-1, -1);
    return 0;
}

[numthreads(8, 8, 1)]
void FilterDiffuse(uint3 dispatchId : SV_DispatchThreadID)
{
    uint width, height;
    _GIDiffuseFiltered.GetDimensions(width, height);
    uint2 size = uint2(width, height);
    if (any(dispatchId.xy >= size))
        return;
    float4 center = _GIDiffuseFiltered.Load(int3(dispatchId.xy, 0));
    if (_GIEnableDiffuse == 0u || GIIsBackground(center.a))
    {
        _GIDiffuseDenoised[dispatchId.xy] = 0.0;
        return;
    }

    float2 centerUv = GIUvFromPixel(dispatchId.xy, size);
    float3 centerNormal = GILoadNormal(centerUv);
    float3 centerPosition = GIWorldPosition(centerUv, center.a);
    uint centerMaterial = GIMaterialSignature(centerUv);
    float3 sum = 0.0;
    float weightSum = 0.0;
    float centerLuminance = GILuminance(max(0.0, center.rgb));
    float4 centerMoments = _GIDiffuseMomentsRead.Load(int3(dispatchId.xy, 0));
    float centerSigma = sqrt(max(centerMoments.w,
        centerMoments.y - centerMoments.x * centerMoments.x));
    float centerNoise = saturate(centerSigma /
        max(centerMoments.x + 0.05, 0.05));
    // Two separable cross iterations (step 1 and 2) provide a 13-point diamond support
    // while requiring ten taps total.  The old two 3x3 iterations required eighteen taps
    // and repeatedly fetched full-resolution depth/normal/material for diagonal samples;
    // those diagonals are already reached by the second cross iteration.
    [unroll]
    for (uint sampleIndex = 0u; sampleIndex < 5u; sampleIndex++)
    {
        int2 samplePixel = clamp(
            (int2)dispatchId.xy + GIDiffuseFilterOffset(sampleIndex) *
            (int)max(_GIDiffuseAtrousStep, 1u),
                                 0, (int2)size - 1);
        float4 sampleValue = _GIDiffuseFiltered.Load(int3(samplePixel, 0));
        if (GIIsBackground(sampleValue.a))
            continue;
        float2 sampleUv = GIUvFromPixel((uint2)samplePixel, size);
        if (GIMaterialSignature(sampleUv) != centerMaterial)
            continue;
        float3 sampleNormal = GILoadNormal(sampleUv);
        float normalAgreement = saturate(dot(centerNormal, sampleNormal));
        if (normalAgreement < 0.85)
            continue;
        float3 samplePosition = GIWorldPosition(sampleUv, sampleValue.a);
        float3 positionDelta = samplePosition - centerPosition;
        float surfaceDistance = length(positionDelta);
        float planeError = abs(dot(positionDelta, centerNormal));
        float cameraDistance = length(centerPosition - _GICameraPosition);
        float filterFootprint = max(1.0, (float)_GIDiffuseAtrousStep);
        float surfaceLimit = max(0.16, cameraDistance * 0.0030 * filterFootprint);
        if (surfaceDistance > surfaceLimit ||
            planeError > max(0.04, surfaceDistance * 0.06))
            continue;
        // Do not protect a noisy centre sample from its valid neighbours. Geometry,
        // material and plane tests preserve actual edges; variance controls how strongly
        // the filter is allowed to average radiometric disagreement.
        float centerKernelWeight = lerp(6.0, 2.0, centerNoise);
        float kernelWeight = sampleIndex == 0u ? centerKernelWeight :
                             (sampleIndex <= 4u ? 2.0 : 1.0);
        float sampleLuminance = GILuminance(max(0.0, sampleValue.rgb));
        float logLuminanceDelta = abs(log2(
            (sampleLuminance + 0.05) / (centerLuminance + 0.05)));
        float sampleVariance = _GIDiffuseMomentsRead.Load(int3(samplePixel, 0)).w;
        float sigma = max(0.025, centerSigma + sqrt(max(0.0, sampleVariance)));
        float relativeSigma = saturate(
            sigma / max(centerLuminance + 0.05, 0.05));
        float luminanceWeight = exp2(-logLuminanceDelta *
            lerp(1.25, 0.12, relativeSigma));
        float weight = kernelWeight * pow(normalAgreement, 32.0) *
                       exp2(-planeError * 16.0) * luminanceWeight;
        sum += max(0.0, sampleValue.rgb) * weight;
        weightSum += weight;
    }
    float3 result = weightSum > 1e-5 ? sum / weightSum : max(0.0, center.rgb);
    _GIDiffuseDenoised[dispatchId.xy] = float4(result, center.a);
}

groupshared uint gSpecularTileActive;

[numthreads(8, 8, 1)]
void TraceSpecular(uint3 dispatchId : SV_DispatchThreadID, uint groupIndex : SV_GroupIndex)
{
    if (groupIndex == 0u)
        gSpecularTileActive = 0u;
    GroupMemoryBarrierWithGroupSync();
    bool inBounds = all(dispatchId.xy < _GISpecularSize);
    float2 uv = inBounds ? GIUvFromPixel(dispatchId.xy, _GISpecularSize) : 0.0;
    float depth = inBounds ? GILoadDepth(uv) : 0.0;
    float roughness = inBounds ? saturate(1.0 - _GIGBuffer2.Load(int3(GIFullPixelFromUv(uv), 0)).a) : 1.0;
    bool eligible = _GIEnableSpecular != 0u && inBounds && !GIIsBackground(depth) &&
                    roughness >= _GIMinSpecularRoughness && roughness <= _GIMaxSpecularRoughness;
    if (eligible)
        InterlockedOr(gSpecularTileActive, 1u);
    if (inBounds)
    {
        _GICurrentSpecular[dispatchId.xy] = float4(0.0, 0.0, 0.0, depth);
        _GICurrentSpecularRay[dispatchId.xy] = 0.0;
        _GICurrentSpecularHit[dispatchId.xy] = 0.0;
        _GICurrentSpecularStats[dispatchId.xy] = 0.0;
        _GICurrentSpecularId[dispatchId.xy] = 0u;
    }
    GroupMemoryBarrierWithGroupSync();
    if (!inBounds || gSpecularTileActive == 0u || !eligible)
        return;

    // Preserve full-rate geometric detail for near mirrors.  Rough lobes are already
    // represented by a persistent temporal reservoir and low-resolution spatial reuse;
    // tracing both checkerboard phases every frame repeats almost identical million-ray
    // work at 4K.  Alternating parity retains the 0.375 sample grid and refreshes every
    // receiver within two frames, unlike lowering the resolution to 0.25 (which caused
    // the former screen-space split line and permanently discarded spatial samples).
    bool checkerboardRough = roughness > 0.20;
    uint checkerboardPhase = (dispatchId.x ^ dispatchId.y) & 1u;
    if (checkerboardRough && checkerboardPhase != (_GIFrameIndex & 1u))
        return;

    float3 normal = GILoadNormal(uv);
    float3 position = GIWorldPosition(uv, depth);
    float3 viewDirection = normalize(_GICameraPosition - position);
    uint seed = dispatchId.x + dispatchId.y * _GISpecularSize.x + _GIFrameIndex * 12289u;
    float3 direction = GIGgxDirection(normal, viewDirection, roughness, GIRandom2(seed));
    uint preferredLevel = (uint)clamp(floor(roughness * 5.0), 0.0, 5.0);
    float3 origin = position + normal * max(0.01, _GIClipmapLevels[0].cellSize * 0.1);
    // Specular correctness is world-space only. HZB/scene colour remains a diffuse
    // candidate accelerator and is deliberately not an SSR source for reflections.
    GIPathPayload payload;
    GITraceSpecularWorld(
        origin, direction, preferredLevel, roughness, dispatchId.xy, payload);
    float sourcePdf = GIGgxDirectionPdf(normal, viewDirection, direction, roughness);
    bool pathValid = (payload.pathFlags & GI_PATH_VALID) != 0u;
    float targetPdf = pathValid ? max(1e-6,
        GILuminance(max(0.0, payload.radiance)) *
        GIGgxReuseWeight(normal, viewDirection, direction, roughness)) : 0.0;
    float candidateWeight = pathValid ? targetPdf / sourcePdf : 0.0;
    payload.solidAnglePdf = sourcePdf;
    payload.proposalPdf = sourcePdf;
    payload.targetPdf = targetPdf;
    payload.weightSum = candidateWeight;
    payload.proposalCount = 1.0;
    _GICurrentSpecular[dispatchId.xy] = float4(payload.radiance, depth);
    _GICurrentSpecularRay[dispatchId.xy] = float4(
        payload.incomingDirection, payload.hitDistance);
    _GICurrentSpecularHit[dispatchId.xy] = float4(
        payload.shadingNormal, (float)payload.pathFlags);
    _GICurrentSpecularStats[dispatchId.xy] = float4(sourcePdf, targetPdf, candidateWeight, 1.0);
    _GICurrentSpecularId[dispatchId.xy] = uint2(payload.objectId, payload.surfaceId);
}

// Keep the coarse Clipmap proposal and exact triangle refinement in separate kernels.
// Unity's D3D frontend aborts when both large traversal graphs are inlined into one
// TraceSpecular program.  This pass is budget-gated and only replaces a proposal after
// the unified TLAS/BLAS finds an authoritative nearest triangle.
[numthreads(8, 8, 1)]
void RefineSpecular(uint3 dispatchId : SV_DispatchThreadID)
{
    if (any(dispatchId.xy >= _GISpecularSize) || _GIEnableSpecular == 0u)
        return;
    float2 uv = GIUvFromPixel(dispatchId.xy, _GISpecularSize);
    float depth = GILoadDepth(uv);
    if (GIIsBackground(depth))
        return;
    float roughness = saturate(
        1.0 - _GIGBuffer2.Load(int3(GIFullPixelFromUv(uv), 0)).a);
    if (roughness < _GIMinSpecularRoughness ||
        roughness > min(_GIMaxSpecularRoughness, 0.35))
        return;
    if (!GIValidationGate(dispatchId.xy, 0u, _GISpecularSize,
                          _GITriangleRefinementBudget, 1u,
                          0x7f4a7c15u, 6.0) ||
        !GIConsumeTriangleRefinementBudget())
        return;

    float4 rayRecord = _GICurrentSpecularRay[dispatchId.xy];
    float rayLengthSquared = dot(rayRecord.xyz, rayRecord.xyz);
    if (rayLengthSquared <= 1e-6)
        return;
    float3 direction = rayRecord.xyz * rsqrt(rayLengthSquared);
    float3 normal = GILoadNormal(uv);
    float3 position = GIWorldPosition(uv, depth);
    float3 origin = position + normal * max(
        0.01, _GIClipmapLevels[0].cellSize * 0.1);
    GIPathPayload payload;
    if (!GITraceBvhOnlySpecular(origin, direction, payload))
        return;

    float3 viewDirection = normalize(_GICameraPosition - position);
    float sourcePdf = GIGgxDirectionPdf(
        normal, viewDirection, direction, roughness);
    float targetPdf = max(1e-6,
        GILuminance(max(0.0, payload.radiance)) *
        GIGgxReuseWeight(normal, viewDirection, direction, roughness));
    float candidateWeight = targetPdf / max(sourcePdf, 1e-6);
    _GICurrentSpecular[dispatchId.xy] = float4(payload.radiance, depth);
    _GICurrentSpecularRay[dispatchId.xy] = float4(
        direction, payload.hitDistance);
    _GICurrentSpecularHit[dispatchId.xy] = float4(
        payload.shadingNormal, (float)payload.pathFlags);
    _GICurrentSpecularStats[dispatchId.xy] = float4(
        sourcePdf, targetPdf, candidateWeight, 1.0);
    _GICurrentSpecularId[dispatchId.xy] = uint2(
        payload.objectId, payload.surfaceId);
}

bool GIConsumeSpecularVisibilityBudget()
{
    if (_GISpecularVisibilityBudget == 0u)
        return false;
    // Once a dispatch has exhausted its hard budget, avoid making every remaining
    // low-resolution pixel contend on the same global atomic.  The atomic is still the
    // authoritative reservation for the small race window before exhaustion.
    if (_GITraceCounters[13] >= _GISpecularVisibilityBudget)
        return false;
    uint allocation;
    InterlockedAdd(_GITraceCounters[13], 1u, allocation);
    return allocation < _GISpecularVisibilityBudget;
}

bool GIConsumeDiffuseVisibilityBudget()
{
    if (_GIDiffuseVisibilityBudget == 0u)
        return false;
    if (_GITraceCounters[15] >= _GIDiffuseVisibilityBudget)
        return false;
    uint allocation;
    InterlockedAdd(_GITraceCounters[15], 1u, allocation);
    return allocation < _GIDiffuseVisibilityBudget;
}

bool GIStrictReconnectionVisibility(float3 origin, float3 targetPosition,
                                    uint2 targetStableId, float roughness)
{
    float3 segment = targetPosition - origin;
    float distanceValue = length(segment);
    if (distanceValue <= 0.03 || any(targetStableId == 0u))
        return false;
    float3 direction = segment / distanceValue;
    float bvhHitT;
    float3 bvhHitNormal;
    uint bvhMaterial, bvhMaterialSlot, bvhInstance, bvhTriangle;
    float2 bvhBarycentrics;
    uint2 bvhStableId;
    float bvhTolerance = max(_GIClipmapLevels[0].cellSize * 0.35, distanceValue * 0.0075);
    if (GITraceSceneBvh(
            origin, direction, 0.02, distanceValue + bvhTolerance, 0u,
            bvhHitT, bvhHitNormal, bvhMaterial, bvhMaterialSlot,
            bvhBarycentrics, bvhInstance, bvhTriangle, bvhStableId))
        return bvhStableId.x == targetStableId.x &&
               (((targetStableId.y & 0x80000000u) != 0u) ||
                bvhStableId.y == targetStableId.y) &&
               abs(bvhHitT - distanceValue) <= bvhTolerance;
    float hitT;
    uint packedSurface;
    uint hitIdentity;
    uint hitLayer;
    uint hitLevel;
    int3 hitWorldCell;
    int hitPhysicalBrick;
    uint hitLocalCell;
    uint traceSteps;
    bool hit = GITraceUnifiedClipmaps(
        _GIClipmapLevels,
        _GIStaticPageTable, _GIStaticOccupancy, _GIStaticSurface, _GIStaticSurfaceIdentity,
        _GIStaticDistance,
        _GIDynamicPageTable, _GIDynamicOccupancy, _GIDynamicSurface, _GIDynamicSurfaceIdentity,
        _GIDynamicDistance,
        origin, direction, distanceValue + _GIClipmapLevels[0].cellSize * 1.5,
        0u, 0u, hitT, packedSurface, hitIdentity, hitLayer, hitLevel, hitWorldCell,
        hitPhysicalBrick, hitLocalCell, traceSteps);
    if (!hit)
        return false;
    uint address = (uint)hitPhysicalBrick * GI_SURFACE_WORDS_PER_BRICK + hitLocalCell;
    uint2 hitStableId = hitLayer == 0u ? _GIStaticSurfaceStableId[address]
                                      : _GIDynamicSurfaceStableId[address];
    if (any(hitStableId != targetStableId))
        return false;
    float tolerance = max(_GIClipmapLevels[hitLevel].cellSize * 2.5, distanceValue * 0.02);
    if (roughness <= 0.35 && hitLevel <= 1u && GIConsumeTriangleRefinementBudget())
    {
        float refinedT;
        float3 refinedNormal;
        uint refinedMaterial;
        uint refinedMaterialSlot;
        float2 refinedBarycentrics;
        uint refinedInstanceIndex;
        uint refinedTriangleIndex;
        uint2 refinedStableId;
        if (!GIRefineClipmapHit(origin, direction, hitT, hitLayer, hitLevel, hitWorldCell,
                                refinedT, refinedNormal, refinedMaterial,
                                refinedMaterialSlot, refinedBarycentrics,
                                refinedInstanceIndex, refinedTriangleIndex,
                                refinedStableId) ||
            any(refinedStableId != targetStableId))
            return false;
        hitT = refinedT;
        tolerance = max(_GIClipmapLevels[hitLevel].cellSize * 0.5, distanceValue * 0.01);
    }
    return abs(hitT - distanceValue) <= tolerance;
}

float GISpecularReservoirTarget(float3 radiance, float3 normal, float3 viewDirection,
                                float3 direction, float roughness)
{
    return max(1e-6, GILuminance(max(0.0, radiance)) *
        GIGgxReuseWeight(normal, viewDirection, direction, roughness));
}

[numthreads(8, 8, 1)]
void TemporalSpecularReservoir(uint3 dispatchId : SV_DispatchThreadID)
{
    if (any(dispatchId.xy >= _GISpecularSize))
        return;
    float2 uv = GIUvFromPixel(dispatchId.xy, _GISpecularSize);
    float4 currentRadiance = _GICurrentSpecularRead.Load(int3(dispatchId.xy, 0));
    float4 currentRay = _GICurrentSpecularRayRead.Load(int3(dispatchId.xy, 0));
    float4 currentHit = _GICurrentSpecularHitRead.Load(int3(dispatchId.xy, 0));
    float4 currentStats = _GICurrentSpecularStatsRead.Load(int3(dispatchId.xy, 0));
    uint2 currentId = _GICurrentSpecularIdRead.Load(int3(dispatchId.xy, 0));
    float depth = currentRadiance.a;
    float roughness = saturate(1.0 - _GIGBuffer2.Load(int3(GIFullPixelFromUv(uv), 0)).a);
    bool eligible = _GIEnableSpecular != 0u && !GIIsBackground(depth) &&
                    roughness >= _GIMinSpecularRoughness && roughness <= _GIMaxSpecularRoughness;
    if (!eligible)
    {
        _GISpecularReservoirRadianceWrite[dispatchId.xy] = 0.0;
        _GISpecularReservoirRayWrite[dispatchId.xy] = 0.0;
        _GISpecularReservoirHitWrite[dispatchId.xy] = 0.0;
        _GISpecularReservoirStatsWrite[dispatchId.xy] = 0.0;
        _GISpecularReservoirIdWrite[dispatchId.xy] = 0u;
        _GISpecularMomentsWrite[dispatchId.xy] = 0.0;
        return;
    }

    float3 normal = GILoadNormal(uv);
    float3 position = GIWorldPosition(uv, depth);
    float3 origin = position + normal * max(0.01, _GIClipmapLevels[0].cellSize * 0.1);
    float3 viewDirection = normalize(_GICameraPosition - position);
    // Checkerboard-skipped pixels retain receiver depth but currentStats.w == 0. They
    // are not black/sky proposals and must not increase M or replace valid history.
    bool hasFreshProposal = currentStats.w > 0.0;
    float3 selectedRadiance = hasFreshProposal ? max(0.0, currentRadiance.rgb) : 0.0;
    float4 selectedRay = hasFreshProposal ? currentRay : 0.0;
    float4 selectedHit = hasFreshProposal ? currentHit : 0.0;
    uint2 selectedId = hasFreshProposal ? currentId : 0u;
    float selectedSourcePdf = hasFreshProposal ? max(currentStats.x, 1e-6) : 0.0;
    float selectedTarget = hasFreshProposal ? max(currentStats.y, 1e-6) : 0.0;
    float weightSum = hasFreshProposal ? max(0.0, currentStats.z) : 0.0;
    float proposalCount = hasFreshProposal ? max(1.0, currentStats.w) : 0.0;
    float age = 0.0;
    float4 previousMoments = 0.0;
    bool hasPreviousMoments = false;

    float2 previousGeometryUv;
    uint2 ignoredPixel;
    float validity = GITemporalDiffuseMatch(
        uv, depth, normal, GIMaterialSignature(uv), ignoredPixel,
        previousGeometryUv);
    if (_GIHistoryValid != 0u && validity > 0.0)
    {
        float2 previousSpecularUv = GIContinuousPreviousUv(
            uv, depth, previousGeometryUv);
        validity *= all(previousSpecularUv > 0.0) &&
                    all(previousSpecularUv < 1.0) ? 1.0 : 0.0;
        uint2 previousPixel = min((uint2)(saturate(previousSpecularUv) *
                                          float2(_GISpecularSize)),
                                  _GISpecularSize - 1u);
        float4 previousRadiance = _GISpecularReservoirRadianceRead.Load(int3(previousPixel, 0));
        float4 previousRay = _GISpecularReservoirRayRead.Load(int3(previousPixel, 0));
        float4 previousHit = _GISpecularReservoirHitRead.Load(int3(previousPixel, 0));
        float4 previousStats = _GISpecularReservoirStatsRead.Load(int3(previousPixel, 0));
        uint2 previousId = _GISpecularReservoirIdRead.Load(int3(previousPixel, 0));
        if (previousStats.y > 0.0 && previousRay.w > 0.0)
        {
            previousMoments = _GISpecularMomentsRead.Load(int3(previousPixel, 0));
            hasPreviousMoments = previousMoments.z > 0.0 && validity > 0.0;
            float4 previousGeometry = _GIGeometryHistoryRead.SampleLevel(
                sampler_PointClamp, previousGeometryUv, 0);
            float3 previousOrigin = ComputeWorldSpacePosition(
                previousGeometryUv, previousGeometry.z,
                _GIPreviousInverseViewProjection);
            previousOrigin += GIUnpackHistoryNormal(previousGeometry.xy) *
                              max(0.01, _GIClipmapLevels[0].cellSize * 0.1);
            uint previousFlags = (uint)round(previousHit.w);
            bool finite = (previousFlags & GI_PATH_FINITE_HIT) != 0u &&
                          previousRay.w < _GIMaxTraceDistance * 0.999;
            float3 hitPosition = previousOrigin + normalize(previousRay.xyz) * previousRay.w;
            float3 shiftedDirection = finite ? normalize(hitPosition - origin)
                                             : normalize(previousRay.xyz);
            float shiftedDistance = finite ? length(hitPosition - origin) : _GIMaxTraceDistance;
            bool reusedVisibility = finite &&
                (previousFlags & GI_PATH_VISIBILITY_VALID) != 0u &&
                previousStats.w < 4.0 &&
                length(previousOrigin - origin) <=
                    max(0.02, _GIClipmapLevels[0].cellSize * 0.25) &&
                !any(previousId == 0u);
            bool strictVisibility = false;
            if (finite && !reusedVisibility)
                strictVisibility = GIValidationGate(
                        dispatchId.xy, 0u, _GISpecularSize,
                        _GISpecularVisibilityBudget, 1u,
                        0x13198a2eu, 5.0) &&
                    GIConsumeSpecularVisibilityBudget() &&
                    GIStrictReconnectionVisibility(origin, hitPosition, previousId, roughness);
            bool visible = !finite || reusedVisibility || strictVisibility;
            float shiftedTarget = visible ? GISpecularReservoirTarget(
                previousRadiance.rgb, normal, viewDirection, shiftedDirection, roughness) : 0.0;
            float reusedCount = min(previousStats.y, lerp(8.0, 20.0, roughness));
            if (shiftedTarget > 1e-6)
            {
                float normalizedWeight = previousStats.x *
                    (reusedCount / max(previousStats.y, 1.0));
                float candidateWeight = normalizedWeight * min(
                    shiftedTarget / max(previousStats.z, 1e-6), 4.0) * validity;
                candidateWeight = GIClampMergedReservoirWeight(
                    candidateWeight, reusedCount, weightSum, proposalCount, 6.0);
                uint seed = dispatchId.x + dispatchId.y * _GISpecularSize.x +
                            _GIFrameIndex * 0x9e3779b9u;
                if (GIReservoirUpdate(weightSum, proposalCount, candidateWeight,
                                      reusedCount, GIRandom2(seed).x))
                {
                    selectedRadiance = previousRadiance.rgb;
                    selectedRay = float4(shiftedDirection, shiftedDistance);
                    selectedHit = previousHit;
                    selectedHit.w = (float)(previousFlags | GI_PATH_VISIBILITY_VALID);
                    selectedId = previousId;
                    selectedSourcePdf = max(previousRadiance.a, 1e-6);
                    selectedTarget = shiftedTarget;
                    age = finite
                        ? (strictVisibility ? 0.0 : min(previousStats.w + 1.0, 4.0))
                        : min(previousStats.w + 1.0, roughness <= 0.2 ? 8.0 : 20.0);
                }
            }
            else
                proposalCount += reusedCount;
        }
    }
    GIReservoirLimit(weightSum, proposalCount, roughness <= 0.2 ? 12.0 : 24.0);
    _GISpecularReservoirRadianceWrite[dispatchId.xy] = float4(selectedRadiance, selectedSourcePdf);
    _GISpecularReservoirRayWrite[dispatchId.xy] = selectedRay;
    _GISpecularReservoirHitWrite[dispatchId.xy] = selectedHit;
    _GISpecularReservoirStatsWrite[dispatchId.xy] = float4(
        weightSum, proposalCount, selectedTarget, age);
    _GISpecularReservoirIdWrite[dispatchId.xy] = selectedId;

    // Track independent fresh observations at trace resolution. Checkerboard holes carry
    // moments without increasing the sample count; otherwise alternating null proposals
    // would report artificial zero variance and keep dense metallic sparkles forever.
    float4 nextMoments = 0.0;
    if (hasPreviousMoments)
    {
        nextMoments = previousMoments;
        if (hasFreshProposal)
        {
            float observation = GILuminance(max(0.0, currentRadiance.rgb));
            float variance = max(0.0,
                previousMoments.y - previousMoments.x * previousMoments.x);
            float sigma = sqrt(variance);
            float radius = max(0.10,
                previousMoments.x * 0.75 + sigma * 4.0);
            observation = clamp(observation,
                max(0.0, previousMoments.x - radius),
                previousMoments.x + radius);
            float historyLength = min(previousMoments.z + 1.0, 32.0);
            float alpha = 1.0 / historyLength;
            nextMoments.x = lerp(previousMoments.x, observation, alpha);
            nextMoments.y = lerp(previousMoments.y,
                                 observation * observation, alpha);
            nextMoments.z = historyLength;
        }
    }
    else if (hasFreshProposal)
    {
        float observation = GILuminance(max(0.0, currentRadiance.rgb));
        nextMoments = float4(observation, observation * observation, 1.0, 0.0);
    }
    _GISpecularMomentsWrite[dispatchId.xy] = nextMoments;
}

[numthreads(8, 8, 1)]
void SpatialSpecularReservoir(uint3 dispatchId : SV_DispatchThreadID)
{
    if (any(dispatchId.xy >= _GISpecularSize))
        return;
    float2 uv = GIUvFromPixel(dispatchId.xy, _GISpecularSize);
    float depth = GILoadDepth(uv);
    float roughness = saturate(1.0 - _GIGBuffer2.Load(int3(GIFullPixelFromUv(uv), 0)).a);
    if (_GIEnableSpecular == 0u || GIIsBackground(depth) ||
        roughness < _GIMinSpecularRoughness || roughness > _GIMaxSpecularRoughness)
    {
        _GISpecularReservoirSpatialRadiance[dispatchId.xy] = 0.0;
        _GISpecularReservoirSpatialRay[dispatchId.xy] = 0.0;
        _GISpecularReservoirSpatialHit[dispatchId.xy] = 0.0;
        _GISpecularReservoirSpatialStats[dispatchId.xy] = 0.0;
        _GISpecularReservoirSpatialId[dispatchId.xy] = 0u;
        return;
    }
    float3 normal = GILoadNormal(uv);
    float3 position = GIWorldPosition(uv, depth);
    uint centerMaterial = GIMaterialSignature(uv);
    float3 origin = position + normal * max(0.01, _GIClipmapLevels[0].cellSize * 0.1);
    float3 viewDirection = normalize(_GICameraPosition - position);
    float4 selectedRadiance = _GISpecularReservoirRadianceRead.Load(int3(dispatchId.xy, 0));
    float4 selectedRay = _GISpecularReservoirRayRead.Load(int3(dispatchId.xy, 0));
    float4 selectedHit = _GISpecularReservoirHitRead.Load(int3(dispatchId.xy, 0));
    float4 selectedStats = _GISpecularReservoirStatsRead.Load(int3(dispatchId.xy, 0));
    uint2 selectedId = _GISpecularReservoirIdRead.Load(int3(dispatchId.xy, 0));
    float selectedVisibilityAge = selectedStats.w;
    float weightSum = max(0.0, selectedStats.x);
    float proposalCount = max(0.0, selectedStats.y);
    float selectedTarget = max(selectedStats.z, 1e-6);
    float4 centerRadiance = selectedRadiance;
    float4 centerRay = selectedRay;
    float4 centerHit = selectedHit;
    float4 centerStats = selectedStats;
    uint2 centerId = selectedId;
    float centerVisibilityAge = selectedVisibilityAge;
    float centerWeightSum = weightSum;
    float centerProposalCount = proposalCount;
    float centerTarget = selectedTarget;
    bool selectedSpatialNeighbour = false;
    bool selectedSpatialNeedsStrictVisibility = false;
    float3 selectedSpatialHitPosition = 0.0;
    uint sampleCount = min(_GISpecularSpatialSamples, roughness <= 0.2 ? 2u : 4u);
    [loop]
    for (uint sampleIndex = 0u; sampleIndex < sampleCount; sampleIndex++)
    {
        uint seed = dispatchId.x + dispatchId.y * _GISpecularSize.x +
                    _GIFrameIndex * 8191u + sampleIndex * 131u;
        float2 randomValue = GIRandom2(seed);
        float angle = TWO_PI * randomValue.x;
        float radius = lerp(1.0, 5.0, roughness * roughness) * sqrt(randomValue.y);
        int2 samplePixel = clamp((int2)dispatchId.xy +
            (int2)round(float2(cos(angle), sin(angle)) * radius),
            0, (int2)_GISpecularSize - 1);
        if (all(samplePixel == (int2)dispatchId.xy))
            continue;
        float2 sampleUv = GIUvFromPixel((uint2)samplePixel, _GISpecularSize);
        float sampleDepth = GILoadDepth(sampleUv);
        float3 sampleNormal = GILoadNormal(sampleUv);
        if (GIIsBackground(sampleDepth) ||
            GIMaterialSignature(sampleUv) != centerMaterial ||
            dot(normal, sampleNormal) < lerp(0.98, 0.8, roughness))
            continue;
        float3 samplePosition = GIWorldPosition(sampleUv, sampleDepth);
        float3 receiverOffset = samplePosition - position;
        float receiverDistance = length(receiverOffset);
        float planeError = abs(dot(receiverOffset, normal));
        float cameraDistance = length(position - _GICameraPosition);
        float screenOffset = max(
            1.0, length((float2)(samplePixel - (int2)dispatchId.xy)));
        float receiverLimit = min(0.75, max(
            0.10, cameraDistance * 0.0012 * screenOffset));
        if (receiverDistance > receiverLimit ||
            planeError > max(0.025, receiverDistance * 0.05))
            continue;
        float4 candidateRadiance = _GISpecularReservoirRadianceRead.Load(int3(samplePixel, 0));
        float4 candidateRay = _GISpecularReservoirRayRead.Load(int3(samplePixel, 0));
        float4 candidateHit = _GISpecularReservoirHitRead.Load(int3(samplePixel, 0));
        float4 candidateStats = _GISpecularReservoirStatsRead.Load(int3(samplePixel, 0));
        uint2 candidateId = _GISpecularReservoirIdRead.Load(int3(samplePixel, 0));
        if (candidateStats.y <= 0.0 || candidateRay.w <= 0.0)
            continue;
        float3 sampleOrigin = samplePosition + sampleNormal *
                              max(0.01, _GIClipmapLevels[0].cellSize * 0.1);
        uint flags = (uint)round(candidateHit.w);
        bool finite = (flags & GI_PATH_FINITE_HIT) != 0u &&
                      candidateRay.w < _GIMaxTraceDistance * 0.999;
        if (finite && any(candidateId == 0u))
            continue;
        float3 hitPosition = sampleOrigin + normalize(candidateRay.xyz) * candidateRay.w;
        float3 shiftedDirection = finite ? normalize(hitPosition - origin)
                                         : normalize(candidateRay.xyz);
        float shiftedDistance = finite ? length(hitPosition - origin) : _GIMaxTraceDistance;
        bool reusableVisibility = finite &&
            (flags & GI_PATH_VISIBILITY_VALID) != 0u &&
            candidateStats.w < 4.0 &&
            length(sampleOrigin - origin) <=
                max(0.02, _GIClipmapLevels[0].cellSize * 0.25);
        float shiftedTarget = GISpecularReservoirTarget(
            candidateRadiance.rgb, normal, viewDirection, shiftedDirection, roughness);
        float reusedCount = min(candidateStats.y, 8.0);
        float normalizedWeight = candidateStats.x * (reusedCount / max(candidateStats.y, 1.0));
        float candidateWeight = normalizedWeight * min(
            shiftedTarget / max(candidateStats.z, 1e-6), 4.0);
        candidateWeight = GIClampMergedReservoirWeight(
            candidateWeight, reusedCount, weightSum, proposalCount, 4.0);
        if (GIReservoirUpdate(weightSum, proposalCount, candidateWeight, reusedCount,
                              GIRandom2(seed ^ 0xa511e9b3u).y))
        {
            selectedRadiance = candidateRadiance;
            selectedRay = float4(shiftedDirection, shiftedDistance);
            selectedHit = candidateHit;
            selectedStats = candidateStats;
            selectedId = candidateId;
            selectedTarget = shiftedTarget;
            selectedVisibilityAge = finite
                ? (reusableVisibility ? min(candidateStats.w + 1.0, 4.0) : 0.0)
                : candidateStats.w;
            selectedSpatialNeighbour = true;
            selectedSpatialNeedsStrictVisibility = finite && !reusableVisibility;
            selectedSpatialHitPosition = hitPosition;
        }
    }
    if (selectedSpatialNeighbour && selectedSpatialNeedsStrictVisibility)
    {
        bool winnerVisible = GIValidationGate(
                dispatchId.xy, 0u, _GISpecularSize,
                _GISpecularVisibilityBudget, 1u,
                0x9e3779b9u, 7.0) &&
            GIConsumeSpecularVisibilityBudget() &&
            GIStrictReconnectionVisibility(
                origin, selectedSpatialHitPosition, selectedId, roughness);
        if (winnerVisible)
        {
            uint selectedFlags = (uint)round(selectedHit.w);
            selectedHit.w = (float)(selectedFlags | GI_PATH_VISIBILITY_VALID);
            selectedVisibilityAge = 0.0;
        }
        else
        {
            selectedRadiance = centerRadiance;
            selectedRay = centerRay;
            selectedHit = centerHit;
            selectedStats = centerStats;
            selectedId = centerId;
            selectedVisibilityAge = centerVisibilityAge;
            selectedTarget = centerTarget;
            weightSum = centerWeightSum;
            proposalCount = centerProposalCount;
        }
    }
    GIReservoirLimit(weightSum, proposalCount, roughness <= 0.2 ? 16.0 : 32.0);
    _GISpecularReservoirSpatialRadiance[dispatchId.xy] = selectedRadiance;
    _GISpecularReservoirSpatialRay[dispatchId.xy] = selectedRay;
    _GISpecularReservoirSpatialHit[dispatchId.xy] = selectedHit;
    _GISpecularReservoirSpatialStats[dispatchId.xy] = float4(
        weightSum, proposalCount, selectedTarget, selectedVisibilityAge);
    _GISpecularReservoirSpatialId[dispatchId.xy] = selectedId;
}

float3 GISpecularF0(uint2 fullPixel, out float roughness)
{
    float4 gBuffer0 = _GIGBuffer0.Load(int3(fullPixel, 0));
    float3 packedSpecular = _GIGBuffer1.Load(int3(fullPixel, 0)).rgb;
    roughness = saturate(1.0 - _GIGBuffer2.Load(int3(fullPixel, 0)).a);
    uint materialFlags = (uint)(gBuffer0.a * 255.0 + 0.5);
    bool usesSpecularWorkflow = (materialFlags & 8u) != 0u;
    float metallicEstimate = saturate((packedSpecular.r - 0.04) / 0.96);
    return usesSpecularWorkflow
        ? max(0.0, packedSpecular)
        : lerp(0.04.xxx, gBuffer0.rgb, metallicEstimate);
}

float GIGgxReuseWeight(float3 normal, float3 viewDirection, float3 lightDirection, float roughness)
{
    float noV = max(1e-3, dot(normal, viewDirection));
    float noL = max(0.0, dot(normal, lightDirection));
    float3 halfVector = normalize(viewDirection + lightDirection);
    float noH = max(0.0, dot(normal, halfVector));
    float voH = max(1e-3, dot(viewDirection, halfVector));
    float alpha = max(roughness * roughness, 0.0025);
    float alpha2 = alpha * alpha;
    float denominator = max(PI * pow(noH * noH * (alpha2 - 1.0) + 1.0, 2.0), 1e-5);
    float distribution = alpha2 / denominator;
    return min(64.0, distribution * noL / max(4.0 * noV * voH, 1e-4));
}

float3 GIEnvironmentBrdf(float3 f0, float roughness, float noV)
{
    // Epic's compact split-sum approximation. This restores the FG term separated
    // by the ratio estimator without requiring another project texture asset.
    float4 c0 = float4(-1.0, -0.0275, -0.572, 0.022);
    float4 c1 = float4(1.0, 0.0425, 1.04, -0.04);
    float4 r = roughness * c0 + c1;
    float a004 = min(r.x * r.x, exp2(-9.28 * noV)) * r.x + r.y;
    float2 ab = float2(-1.04, 1.04) * a004 + r.zw;
    return f0 * ab.x + ab.y;
}

[numthreads(8, 8, 1)]
void ResolveSpecular(uint3 dispatchId : SV_DispatchThreadID)
{
    if (any(dispatchId.xy >= _GIFullSize))
        return;
    float2 uv = GIUvFromPixel(dispatchId.xy, _GIFullSize);
    float depth = GILoadDepth(uv);
    float roughness;
    float3 f0 = GISpecularF0(dispatchId.xy, roughness);
    bool eligible = _GIEnableSpecular != 0u && !GIIsBackground(depth) &&
                    roughness >= _GIMinSpecularRoughness && roughness <= _GIMaxSpecularRoughness;
    if (!eligible)
    {
        _GIResolvedSpecular[dispatchId.xy] = 0.0;
        _GIResolvedSpecularRay[dispatchId.xy] = 0.0;
        return;
    }

    float3 position = GIWorldPosition(uv, depth);
    float3 normal = GILoadNormal(uv);
    float3 viewDirection = normalize(_GICameraPosition - position);
    float2 tracePosition = uv * float2(_GISpecularSize) - 0.5;
    int2 basePixel = (int2)floor(tracePosition);
    float2 bilinearFraction = frac(tracePosition);
    uint centerMaterial = GIMaterialSignature(uv);
    float3 lightingSum = 0.0;
    float weightSum = 0.0;
    float bestWeight = -1.0;
    float4 bestRay = 0.0;

    [unroll]
    for (int y = 0; y <= 1; y++)
    [unroll]
    for (int x = 0; x <= 1; x++)
    {
        int2 samplePixel = clamp(basePixel + int2(x, y), 0, (int2)_GISpecularSize - 1);
        float4 rayRecord = _GISpecularReservoirSpatialRay.Load(samplePixel);
        if (rayRecord.a <= 0.0)
            continue;
        float2 sampleUv = GIUvFromPixel((uint2)samplePixel, _GISpecularSize);
        float sampleDepth = GILoadDepth(sampleUv);
        if (GIIsBackground(sampleDepth))
            continue;
        if (GIMaterialSignature(sampleUv) != centerMaterial)
            continue;
        float3 sampleNormal = GILoadNormal(sampleUv);
        if (dot(normal, sampleNormal) < lerp(0.985, 0.78, roughness))
            continue;
        uint2 sampleFullPixel = GIFullPixelFromUv(sampleUv);
        float sampleRoughness = saturate(
            1.0 - _GIGBuffer2.Load(int3(sampleFullPixel, 0)).a);
        if (abs(sampleRoughness - roughness) > max(0.04, roughness * 0.25))
            continue;
        float3 samplePosition = GIWorldPosition(sampleUv, sampleDepth);
        float3 receiverOffset = samplePosition - position;
        float receiverDistance = length(receiverOffset);
        float planeError = abs(dot(receiverOffset, normal));
        float cameraDistance = length(position - _GICameraPosition);
        float receiverLimit = min(0.75, max(0.10,
            cameraDistance * 0.0015 *
            max(1.0, length((float2)samplePixel - tracePosition))));
        if (receiverDistance > receiverLimit ||
            planeError > max(0.025, receiverDistance * 0.05))
            continue;
        float3 sampleOrigin = samplePosition + sampleNormal * 0.05;
        float3 hitPoint = sampleOrigin + rayRecord.xyz * rayRecord.a;
        bool skyRay = rayRecord.a >= _GIMaxTraceDistance * 0.999;
        float3 reusedDirection = skyRay ? normalize(rayRecord.xyz) : normalize(hitPoint - position);
        float bilinearWeight = (x != 0 ? bilinearFraction.x : 1.0 - bilinearFraction.x) *
                               (y != 0 ? bilinearFraction.y : 1.0 - bilinearFraction.y);
        float weight = GIGgxReuseWeight(
            normal, viewDirection, reusedDirection, roughness) * bilinearWeight;
        if (weight <= 1e-6)
            continue;
        float4 reservoirRadiance = _GISpecularReservoirSpatialRadiance.Load(samplePixel);
        float4 reservoirStats = _GISpecularReservoirSpatialStats.Load(samplePixel);
        float reservoirNormalization = reservoirStats.y > 0.0 && reservoirStats.z > 1e-6
            ? reservoirStats.x * max(reservoirRadiance.a, 1e-6) /
              max(reservoirStats.y * reservoirStats.z, 1e-6)
            : 0.0;
        float3 sampleLighting = reservoirRadiance.rgb * min(reservoirNormalization, 4.0);
        lightingSum += sampleLighting * weight;
        weightSum += weight;
        if (weight > bestWeight)
        {
            bestWeight = weight;
            float currentHitDistance = skyRay ? _GIMaxTraceDistance : length(hitPoint - position);
            bestRay = float4(reusedDirection, currentHitDistance);
        }
    }

    float noV = saturate(dot(normal, viewDirection));
    // A missing low-resolution footprint means "no estimate", not a world-space sky
    // miss. Injecting TOD glossy sky here created permanent coloured islands at
    // silhouettes/checkerboard gaps, which history then treated as real lighting.
    float3 ratioLighting = weightSum > 1e-4
        ? lightingSum / weightSum
        : 0.0;
    float3 specular = ratioLighting * GIEnvironmentBrdf(f0, roughness, noV);
    _GIResolvedSpecular[dispatchId.xy] = float4(max(0.0, specular), depth);
    _GIResolvedSpecularRay[dispatchId.xy] = bestRay;
}

float3 GISpecularTonemap(float3 color)
{
    return color / (1.0 + dot(color, float3(0.2126, 0.7152, 0.0722)));
}

float3 GISpecularInverseTonemap(float3 color)
{
    return color / max(1.0 - dot(color, float3(0.2126, 0.7152, 0.0722)), 1e-3);
}

int2 GISpecularTemporalOffset(uint index)
{
    if (index == 1u) return int2( 1, 0);
    if (index == 2u) return int2(-1, 0);
    if (index == 3u) return int2(0,  1);
    if (index == 4u) return int2(0, -1);
    return 0;
}

float GISpecularHistoryMatch(float2 uv, float depth, float3 normal,
                             out float2 previousUv, out float3 history)
{
    previousUv = uv;
    history = 0.0;
    if (_GIHistoryValid == 0u)
        return 0.0;

    float3 currentPosition = GIWorldPosition(uv, depth);
    float2 motion = _GIMotionTexture.Load(int3(GIFullPixelFromUv(uv), 0));
    float2 candidates[2];
    candidates[0] = ComputeNormalizedDeviceCoordinates(
        currentPosition, _GIPreviousViewProjection);
    candidates[1] = uv - motion;
    float bestScore = 1e20;
    [unroll]
    for (uint candidateIndex = 0u;
         candidateIndex < (_GIUseMotionVectors != 0u ? 2u : 1u);
         candidateIndex++)
    {
        float2 candidateUv = candidates[candidateIndex];
        if (any(candidateUv <= 0.0) || any(candidateUv >= 1.0))
            continue;
        // Specular history is RGBA16F: alpha is the previous authoritative device
        // depth. Point sampling keeps depth and radiance on the same receiver at edges.
        float4 candidateHistory = _GISpecularHistoryRead.SampleLevel(
            sampler_PointClamp, candidateUv, 0);
        if (GIIsBackground(candidateHistory.a))
            continue;
        float3 previousPosition = ComputeWorldSpacePosition(
            candidateUv, candidateHistory.a, _GIPreviousInverseViewProjection);
        float3 positionDelta = previousPosition - currentPosition;
        float distanceSquared = dot(positionDelta, positionDelta);
        float planeError = abs(dot(positionDelta, normal));
        float cameraDistance = length(currentPosition - _GICameraPosition);
        float positionLimit = clamp(cameraDistance * 0.0015, 0.025, 0.30);
        float planeLimit = clamp(cameraDistance * 0.0005, 0.012, 0.10);
        if (distanceSquared > positionLimit * positionLimit ||
            planeError > planeLimit)
            continue;
        float score = distanceSquared + planeError * 2.0;
        if (score < bestScore)
        {
            bestScore = score;
            previousUv = candidateUv;
            history = max(0.0, candidateHistory.rgb);
        }
    }
    return bestScore < 1e19 ? 1.0 : 0.0;
}

[numthreads(8, 8, 1)]
void TemporalSpecular(uint3 dispatchId : SV_DispatchThreadID)
{
    if (any(dispatchId.xy >= _GIFullSize))
        return;
    float2 uv = GIUvFromPixel(dispatchId.xy, _GIFullSize);
    // ResolvedSpecular is B10G11R11 and has no alpha channel. The former code treated
    // current.a as device depth (always 1 on this format), so every world-position test
    // and history reprojection was invalid. Always fetch authoritative scene depth.
    float depth = GILoadDepth(uv);
    float4 current = _GIResolvedSpecularRead.Load(int3(dispatchId.xy, 0));
    float4 rayRecord = _GIResolvedSpecularRayRead.Load(int3(dispatchId.xy, 0));
    float roughness = saturate(1.0 - _GIGBuffer2.Load(int3(dispatchId.xy, 0)).a);
    bool eligible = _GIEnableSpecular != 0u && !GIIsBackground(depth) &&
                    roughness >= _GIMinSpecularRoughness &&
                    roughness <= _GIMaxSpecularRoughness;
    if (!eligible)
    {
        _GISpecularHistoryWrite[dispatchId.xy] = 0.0;
        return;
    }

    float3 normal = GILoadNormal(uv);
    float3 position = GIWorldPosition(uv, depth);
    float2 previousUv;
    float3 history;
    float validity = GISpecularHistoryMatch(
        uv, depth, normal, previousUv, history);
    uint material = GIMaterialSignature(uv);

    uint2 momentPixel = min((uint2)(uv * float2(_GISpecularSize)),
                            _GISpecularSize - 1u);
    float4 moments = _GISpecularMomentsRead.Load(int3(momentPixel, 0));
    float historyLength = validity > 0.0 ? max(1.0, moments.z) : 0.0;
    bool hasCurrentEstimate = rayRecord.a > 0.0 &&
        all(isfinite(current.rgb)) && all(current.rgb >= 0.0);

    // A checkerboard/null footprint is missing data, not a black observation. Preserve a
    // validated history verbatim instead of alternating it with zero on high-metal pixels.
    if (!hasCurrentEstimate)
    {
        _GISpecularHistoryWrite[dispatchId.xy] =
            historyLength > 0.0 ? float4(history, depth) : 0.0;
        return;
    }

    int2 centerPixel = (int2)dispatchId.xy;
    int2 maximumPixel = (int2)_GIFullSize - 1;
    float3 compressedSum = 0.0;
    float weightSum = 0.0;
    float luminanceSum = 0.0;
    float luminanceSquaredSum = 0.0;
    [unroll]
    for (uint sampleIndex = 0u; sampleIndex < 5u; sampleIndex++)
    {
        int2 samplePixel = clamp(
            centerPixel + GISpecularTemporalOffset(sampleIndex),
            0, maximumPixel);
        float4 sampleRay = _GIResolvedSpecularRayRead.Load(int3(samplePixel, 0));
        if (sampleRay.a <= 0.0)
            continue;
        float2 sampleUv = GIUvFromPixel((uint2)samplePixel, _GIFullSize);
        float sampleDepth = GILoadDepth(sampleUv);
        if (GIIsBackground(sampleDepth) ||
            GIMaterialSignature(sampleUv) != material)
            continue;
        float3 sampleNormal = GILoadNormal(sampleUv);
        float normalAgreement = dot(normal, sampleNormal);
        if (normalAgreement < lerp(0.985, 0.82, roughness))
            continue;
        float sampleRoughness = saturate(
            1.0 - _GIGBuffer2.Load(int3(samplePixel, 0)).a);
        if (abs(sampleRoughness - roughness) > max(0.035, roughness * 0.20))
            continue;
        float3 samplePosition = GIWorldPosition(sampleUv, sampleDepth);
        float3 positionDelta = samplePosition - position;
        float surfaceDistance = length(positionDelta);
        float planeError = abs(dot(positionDelta, normal));
        float cameraDistance = length(position - _GICameraPosition);
        float surfaceLimit = min(0.50, max(0.08, cameraDistance * 0.0015));
        if (surfaceDistance > surfaceLimit ||
            planeError > max(0.02, surfaceDistance * 0.05))
            continue;
        float3 sampleValue = max(0.0,
            _GIResolvedSpecularRead.Load(int3(samplePixel, 0)).rgb);
        float kernelWeight = sampleIndex == 0u ? 2.0 : 1.0;
        float weight = kernelWeight * pow(saturate(normalAgreement), 24.0);
        float luminance = GILuminance(sampleValue);
        compressedSum += GISpecularTonemap(sampleValue) * weight;
        luminanceSum += luminance * weight;
        luminanceSquaredSum += luminance * luminance * weight;
        weightSum += weight;
    }

    float3 currentMean = weightSum > 1e-5
        ? GISpecularInverseTonemap(compressedSum / weightSum)
        : max(0.0, current.rgb);
    float localMean = weightSum > 1e-5
        ? luminanceSum / weightSum : GILuminance(max(0.0, current.rgb));
    float localVariance = weightSum > 1e-5
        ? max(0.0, luminanceSquaredSum / weightSum - localMean * localMean)
        : 0.0;
    float localSigma = sqrt(localVariance);
    float momentVariance = max(0.0, moments.y - moments.x * moments.x);
    float momentNoise = saturate(sqrt(momentVariance) /
        max(moments.x + 0.05, 0.05));

    float ignoredRoughness;
    float3 f0 = GISpecularF0(dispatchId.xy, ignoredRoughness);
    float metallicConfidence = saturate(
        (max(f0.r, max(f0.g, f0.b)) - 0.04) / 0.70);
    float spatialWeight = saturate(max(momentNoise,
        localSigma / max(localMean + 0.05, 0.05)) *
        (roughness * roughness * 0.75 + metallicConfidence * 0.18));
    float3 currentFiltered = GISpecularInverseTonemap(lerp(
        GISpecularTonemap(max(0.0, current.rgb)),
        GISpecularTonemap(currentMean), spatialWeight));

    if (historyLength > 0.0)
    {
        float currentLuminance = GILuminance(currentFiltered);
        float historyLuminance = GILuminance(history);
        float noise = max(momentNoise,
            localSigma / max(currentLuminance + 0.05, 0.05));
        float clampRadius = max(0.05,
            currentLuminance * (0.25 + noise * 1.50) + localSigma * 2.0);
        // Mature history is not forced back into one noisy frame's min/max envelope.
        if (historyLength >= 4.0)
            clampRadius *= 2.0;
        float clampedLuminance = clamp(historyLuminance,
            max(0.0, currentLuminance - clampRadius),
            currentLuminance + clampRadius);
        if (historyLuminance > 1e-5)
            history *= clampedLuminance / historyLuminance;
    }

    float temporalWeight = historyLength > 0.0
        ? min(saturate(_GISpecularHistoryWeight),
              historyLength / (historyLength + 1.0)) * validity
        : 0.0;
    float3 result = GISpecularInverseTonemap(lerp(
        GISpecularTonemap(currentFiltered),
        GISpecularTonemap(max(0.0, history)), temporalWeight));
    _GISpecularHistoryWrite[dispatchId.xy] = float4(max(0.0, result), depth);
}

[numthreads(8, 8, 1)]
void SpatialSpecular(uint3 dispatchId : SV_DispatchThreadID)
{
    if (any(dispatchId.xy >= _GIFullSize))
        return;
    float2 uv = GIUvFromPixel(dispatchId.xy, _GIFullSize);
    float depth = GILoadDepth(uv);
    float roughness = saturate(1.0 - _GIGBuffer2.Load(int3(dispatchId.xy, 0)).a);
    bool eligible = _GIEnableSpecular != 0u && !GIIsBackground(depth) &&
                    roughness >= _GIMinSpecularRoughness && roughness <= _GIMaxSpecularRoughness;
    if (!eligible)
    {
        _GISpecularSpatial[dispatchId.xy] = 0.0;
        return;
    }

    float3 centerNormal = GILoadNormal(uv);
    float3 sum = GISpecularTonemap(_GISpecularTemporalRead.Load(int3(dispatchId.xy, 0)).rgb);
    float weightSum = 1.0;
    float radius = lerp(1.0, 12.0, roughness * roughness);
    uint sampleCount = clamp(_GISpecularSpatialSamples, 1u, 8u);
    [loop]
    for (uint sampleIndex = 0u; sampleIndex < sampleCount; sampleIndex++)
    {
        uint seed = dispatchId.x + dispatchId.y * _GIFullSize.x +
                    _GIFrameIndex * 8191u + sampleIndex * 131u;
        float2 randomValue = GIRandom2(seed);
        float angle = TWO_PI * randomValue.x;
        float2 offset = float2(cos(angle), sin(angle)) * (sqrt(randomValue.y) * radius);
        int2 samplePixel = clamp((int2)dispatchId.xy + (int2)round(offset), 0, (int2)_GIFullSize - 1);
        float2 sampleUv = GIUvFromPixel((uint2)samplePixel, _GIFullSize);
        float sampleDepth = GILoadDepth(sampleUv);
        if (GIIsBackground(sampleDepth))
            continue;
        float3 sampleNormal = GILoadNormal(sampleUv);
        float sampleRoughness = saturate(1.0 - _GIGBuffer2.Load(int3(samplePixel, 0)).a);
        float depthWeight = exp2(-abs(sampleDepth - depth) * 512.0);
        float normalWeight = pow(saturate(dot(centerNormal, sampleNormal)), 16.0);
        float roughnessWeight = exp2(-abs(sampleRoughness - roughness) * 16.0);
        float weight = depthWeight * normalWeight * roughnessWeight;
        sum += GISpecularTonemap(_GISpecularTemporalRead.Load(int3(samplePixel, 0)).rgb) * weight;
        weightSum += weight;
    }
    float3 filtered = GISpecularInverseTonemap(sum / max(weightSum, 1e-4));
    _GISpecularSpatial[dispatchId.xy] = float4(
        max(0.0, filtered) * _GISpecularIntensity, depth);
}

[numthreads(8, 8, 1)]
void UpdateGeometryHistory(uint3 dispatchId : SV_DispatchThreadID)
{
    if (any(dispatchId.xy >= _GIDiffuseSize))
        return;
    float2 uv = GIUvFromPixel(dispatchId.xy, _GIDiffuseSize);
    float depth = GILoadDepth(uv);
    float3 normal = GIIsBackground(depth) ? float3(0.0, 1.0, 0.0) : GILoadNormal(uv);
    _GIGeometryHistoryWrite[dispatchId.xy] = float4(
        GIPackHistoryNormal(normal), depth, (float)GIMaterialSignature(uv));
}

float3 GIBilateralSample(Texture2D<float4> textureValue, float2 uv, float depth)
{
    uint width;
    uint height;
    textureValue.GetDimensions(width, height);
    float2 position = uv * float2(width, height) - 0.5;
    int2 basePixel = (int2)floor(position);
    float3 sum = 0.0;
    float weightSum = 0.0;
    uint centerMaterial = GIMaterialSignature(uv);
    float3 centerNormal = GILoadNormal(uv);
    float3 centerPosition = GIWorldPosition(uv, depth);
    float cameraDistance = length(centerPosition - _GICameraPosition);
    float3 fallback = 0.0;
    float fallbackScore = 1e20;
    bool hasFallback = false;
    // Standard 2x2 bilinear footprint. The former symmetric 3x3 resolve performed nine
    // depth/normal/GBuffer signatures for every 4K output pixel (~0.5 ms on the target).
    // floor(position)+{0,1} preserves the correct low-resolution phase without the old
    // round-based midpoint discontinuity.
    [unroll]
    for (int y = 0; y <= 1; y++)
    [unroll]
    for (int x = 0; x <= 1; x++)
    {
        int2 pixel = clamp(basePixel + int2(x, y), 0, int2(width, height) - 1);
        float4 sampleValue = textureValue.Load(int3(pixel, 0));
        float2 sampleUv = (float2(pixel) + 0.5) / float2(width, height);
        if (GIIsBackground(sampleValue.a))
            continue;
        if (GIMaterialSignature(sampleUv) != centerMaterial)
            continue;
        float3 sampleNormal = GILoadNormal(sampleUv);
        float normalAgreement = saturate(dot(centerNormal, sampleNormal));
        float3 samplePosition = GIWorldPosition(sampleUv, sampleValue.a);
        float3 receiverOffset = samplePosition - centerPosition;
        float receiverDistance = length(receiverOffset);
        float planeError = abs(dot(receiverOffset, centerNormal));
        // Device depth is monotonic.  A relative difference is sufficient for this
        // resolve and avoids relying on URP camera constants that are not guaranteed
        // to be visible to a standalone compute shader.
        float depthDelta = abs(sampleValue.a - depth) / max(abs(depth), 1e-4);
        float2 delta = abs(position - float2(pixel));
        float receiverLimit = max(
            0.12, cameraDistance * 0.0025 * max(1.0, length(delta)));
        if (receiverDistance > receiverLimit ||
            planeError > max(0.025, receiverDistance * 0.06))
            continue;
        float fallbackCandidateScore = depthDelta * 48.0 +
                                       (1.0 - normalAgreement) * 4.0 +
                                       dot(delta, delta) * 0.01;
        if (normalAgreement >= 0.65 && fallbackCandidateScore < fallbackScore)
        {
            fallbackScore = fallbackCandidateScore;
            fallback = sampleValue.rgb;
            hasFallback = true;
        }
        if (normalAgreement < 0.80)
            continue;
        float depthWeight = exp2(-depthDelta * 64.0);
        float spatialWeight = exp2(-dot(delta, delta) * 0.75);
        float normalWeight = pow(normalAgreement, 32.0);
        float weight = depthWeight * max(spatialWeight, 1e-4) *
                       normalWeight;
        // HDR-linear interpolation lets one rare emissive/cache sample dominate a full
        // 4x4 output footprint. Interpolate the display reconstruction in the same
        // reversible compressed-radiance domain as temporal diffuse history.
        sum += GIDiffuseTonemap(max(0.0, sampleValue.rgb)) * weight;
        weightSum += weight;
    }
    // If all four weighted samples fail the strict normal test, retain the nearest
    // material-compatible sample rather than pulling radiance across an edge.
    return weightSum > 1e-6
        ? GIDiffuseInverseTonemap(sum / weightSum)
        : (hasFallback ? fallback : 0.0);
}

[numthreads(8, 8, 1)]
void UpsampleLighting(uint3 dispatchId : SV_DispatchThreadID)
{
    if (any(dispatchId.xy >= _GIFullSize))
        return;
    float2 uv = GIUvFromPixel(dispatchId.xy, _GIFullSize);
    float depth = _GIDepthTexture.Load(int3(dispatchId.xy, 0));
    if (GIIsBackground(depth))
    {
        _GIFullLighting[dispatchId.xy] = 0.0;
        return;
    }
    float3 diffuse = GIBilateralSample(_GIDiffuseFiltered, uv, depth);
    float3 specular = _GISpecularFiltered.Load(int3(dispatchId.xy, 0)).rgb;
    float3 albedo = _GIGBuffer0.Load(int3(dispatchId.xy, 0)).rgb;
    float3 combined = diffuse * albedo * (_GIDiffuseIntensity / PI) +
                      specular * _GISpecularIntensity;
    _GIFullLighting[dispatchId.xy] = float4(max(0.0, combined), 1.0);
}

[numthreads(8, 8, 1)]
void UpsampleDiffuseIrradiance(uint3 dispatchId : SV_DispatchThreadID)
{
    if (any(dispatchId.xy >= _GIFullSize))
        return;
    float2 uv = GIUvFromPixel(dispatchId.xy, _GIFullSize);
    float depth = _GIDepthTexture.Load(int3(dispatchId.xy, 0));
    if (GIIsBackground(depth))
    {
        _GIFullLighting[dispatchId.xy] = 0.0;
        return;
    }
    float3 irradiance;
    if (_GIDiffuseDebugStage == 1u)
    {
        // Raw spatial reservoir estimate, before temporal accumulation.
        irradiance = GIBilateralSample(_GICurrentDiffuseRead, uv, depth);
    }
    else if (_GIDiffuseDebugStage == 2u)
    {
        // Temporal accumulation before the final geometry-aware filter.
        irradiance = GIBilateralSample(_GIDiffuseHistoryRead, uv, depth);
    }
    else if (_GIDiffuseDebugStage == 3u)
    {
        uint2 previousPixel;
        float2 previousUv;
        float validity = GITemporalDiffuseMatch(
            uv, depth, GILoadNormal(uv), GIMaterialSignature(uv),
            previousPixel, previousUv);
        irradiance = validity > 0.0 ? float3(0.0, 1.0, 0.0) : float3(1.0, 0.0, 0.0);
    }
    else if (_GIDiffuseDebugStage == 4u)
    {
        float2 motion = _GIMotionTexture.Load(int3(dispatchId.xy, 0));
        irradiance = float3(motion * 32.0 + 0.5, 0.0);
    }
    else
    {
        irradiance = GIBilateralSample(_GIDiffuseFiltered, uv, depth);
    }
    // This is irradiance, not final shaded color. URP applies albedo and 1/PI once.
    irradiance *= _GIDiffuseIntensity;
    _GIFullLighting[dispatchId.xy] = float4(max(0.0, irradiance), 1.0);
}
