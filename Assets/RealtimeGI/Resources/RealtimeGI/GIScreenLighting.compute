#pragma kernel GatherWorldDiffuse
#pragma multi_compile _ _GBUFFER_NORMALS_OCT
#pragma target 5.0

// Screen GI is a deterministic query of the sparse free-space probe field.  It contains no
// history, reprojection, screen trace, HZB, random sequence, scene-colour, reservoir or Unity
// environment input.  Camera movement therefore cannot restart world GI convergence.

#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Packing.hlsl"
#include "../../Shaders/GIClipmapCommon.hlsl"

Texture2D<float> _GIDepthTexture;
Texture2D<float4> _GINormalsTexture;
RWTexture2D<float4> _GIFullLighting;
RWTexture2D<float4> _GISpecularLightingTexture;

StructuredBuffer<GIClipmapLevelData> _GIClipmapLevels;
StructuredBuffer<int> _GIStaticPageTable;
StructuredBuffer<uint> _GIStaticIrradiance;
StructuredBuffer<uint> _GIStaticIrradianceValidity;
StructuredBuffer<int> _GIDynamicPageTable;
StructuredBuffer<uint> _GIDynamicIrradiance;
StructuredBuffer<uint> _GIDynamicIrradianceValidity;

float4x4 _GIInverseViewProjection;
float4 _GIViewportSize;
float _GIDiffuseIntensity;

bool GIIsBackground(float depth)
{
#if UNITY_REVERSED_Z
    return depth <= 1e-6;
#else
    return depth >= 0.999999;
#endif
}

float3 GIDecodeNormal(float3 packed)
{
#if defined(_GBUFFER_NORMALS_OCT)
    float2 remapped = Unpack888ToFloat2(packed);
    return normalize(UnpackNormalOctQuadEncode(remapped * 2.0 - 1.0));
#else
    return normalize(packed);
#endif
}

float3 GIUnpackRgb9E5(uint packed)
{
    if (packed == 0u)
        return 0.0;
    uint3 mantissa = uint3(packed & 0x1ffu, (packed >> 9u) & 0x1ffu,
                           (packed >> 18u) & 0x1ffu);
    int exponentValue = (int)((packed >> 27u) & 0x1fu) - 15;
    return float3(mantissa) * exp2((float)exponentValue - 9.0);
}

int GIFloorDiv2(int value)
{
    return value >> 1;
}

bool GIReadProbe(
    GIClipmapLevelData level,
    StructuredBuffer<int> pageTable,
    StructuredBuffer<uint> irradiance,
    StructuredBuffer<uint> validity,
    int3 probeCoordinate,
    float3 receiverNormal,
    out float3 value)
{
    // Probe centres form a global four-cell lattice.  Two lattice positions are stored in
    // every physical Brick, so crossing a Brick boundary has no special rendering path.
    int3 worldBrick = int3(GIFloorDiv2(probeCoordinate.x), GIFloorDiv2(probeCoordinate.y),
                           GIFloorDiv2(probeCoordinate.z));
    int3 localProbe = probeCoordinate - worldBrick * GI_IRRADIANCE_PROBE_AXIS;
    int3 worldCell = worldBrick * GI_BRICK_SIZE + localProbe * 4 + 2;
    int physicalBrick;
    uint ignoredLocalCell;
    if (!GIResolvePhysicalBrick(level, pageTable, worldCell, physicalBrick, ignoredLocalCell))
    {
        value = 0.0;
        return false;
    }

    uint probeIndex = (uint)(localProbe.x + localProbe.y * GI_IRRADIANCE_PROBE_AXIS +
                             localProbe.z * GI_IRRADIANCE_PROBE_AXIS * GI_IRRADIANCE_PROBE_AXIS);
    uint probeAddress = (uint)physicalBrick * GI_IRRADIANCE_PROBES_PER_BRICK + probeIndex;
    if (validity[probeAddress] == 0u)
    {
        value = 0.0;
        return false;
    }

    uint baseAddress = (uint)physicalBrick * GI_IRRADIANCE_WORDS_PER_BRICK +
                       probeIndex * GI_RADIANCE_LOBE_COUNT;
    float3 irradianceSum = 0.0;
    float normalization = 0.0;
    const float3 axes[6] = {
        float3(1.0, 0.0, 0.0), float3(-1.0, 0.0, 0.0),
        float3(0.0, 1.0, 0.0), float3(0.0, -1.0, 0.0),
        float3(0.0, 0.0, 1.0), float3(0.0, 0.0, -1.0)
    };
    [unroll]
    for (uint lobe = 0u; lobe < GI_RADIANCE_LOBE_COUNT; lobe++)
    {
        float weight = max(0.0, dot(receiverNormal, axes[lobe]));
        irradianceSum += GIUnpackRgb9E5(irradiance[baseAddress + lobe]) * weight;
        normalization += weight;
    }
    // Six axes are a low-frequency quadrature of the incoming hemisphere, not surface
    // radiance rebroadcast.  GIComposite applies the receiver Lambert BRDF exactly once.
    value = normalization > 1e-5 ? irradianceSum * (3.14159265359 / normalization) : 0.0;
    return true;
}

bool GIQueryLevel(uint levelIndex, float3 receiverPosition, float3 receiverNormal,
                  out float3 irradiance)
{
    GIClipmapLevelData level = _GIClipmapLevels[levelIndex];
    float probeSpacing = level.cellSize * 4.0;
    float3 coordinate = receiverPosition / probeSpacing - 0.5;
    int3 baseProbe = (int3)floor(coordinate);
    float3 fraction = frac(coordinate);
    float3 sum = 0.0;
    float totalWeight = 0.0;
    [unroll]
    for (int z = 0; z <= 1; z++)
    [unroll]
    for (int y = 0; y <= 1; y++)
    [unroll]
    for (int x = 0; x <= 1; x++)
    {
        int3 offset = int3(x, y, z);
        float3 axisWeight = lerp(1.0 - fraction, fraction, float3(offset));
        float weight = axisWeight.x * axisWeight.y * axisWeight.z;
        float3 sample;
        // Dynamic probes contain a complete unified-scene trace, so an available dynamic
        // overlay replaces the co-located static field rather than doubling sky/lighting.
        bool found = GIReadProbe(level, _GIDynamicPageTable, _GIDynamicIrradiance,
                                 _GIDynamicIrradianceValidity, baseProbe + offset,
                                 receiverNormal, sample);
        if (!found)
            found = GIReadProbe(level, _GIStaticPageTable, _GIStaticIrradiance,
                                _GIStaticIrradianceValidity, baseProbe + offset,
                                receiverNormal, sample);
        if (found)
        {
            sum += sample * weight;
            totalWeight += weight;
        }
    }
    irradiance = totalWeight > 1e-5 ? sum / totalWeight : 0.0;
    return totalWeight > 1e-5;
}

[numthreads(8, 8, 1)]
void GatherWorldDiffuse(uint3 dispatchId : SV_DispatchThreadID)
{
    uint2 size = max((uint2)_GIViewportSize.xy, 1u);
    if (any(dispatchId.xy >= size))
        return;

    float depth = _GIDepthTexture.Load(int3(dispatchId.xy, 0));
    if (GIIsBackground(depth))
    {
        _GIFullLighting[dispatchId.xy] = 0.0;
        _GISpecularLightingTexture[dispatchId.xy] = 0.0;
        return;
    }

    float2 uv = (float2(dispatchId.xy) + 0.5) / float2(size);
    float3 receiverPosition = ComputeWorldSpacePosition(uv, depth, _GIInverseViewProjection);
    float3 receiverNormal = GIDecodeNormal(_GINormalsTexture.Load(int3(dispatchId.xy, 0)).xyz);
    float3 irradiance = 0.0;
    [loop]
    for (uint level = 0u; level < GI_CLIPMAP_LEVEL_COUNT; level++)
    {
        if (GIQueryLevel(level, receiverPosition, receiverNormal, irradiance))
            break;
    }
    _GIFullLighting[dispatchId.xy] = float4(max(0.0, irradiance * _GIDiffuseIntensity), 1.0);
    _GISpecularLightingTexture[dispatchId.xy] = 0.0;
}
