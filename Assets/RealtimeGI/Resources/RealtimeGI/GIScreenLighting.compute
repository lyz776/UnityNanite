#pragma kernel TraceDiffuse
#pragma kernel TemporalDiffuse
#pragma kernel TraceSpecular
#pragma kernel ResolveSpecular
#pragma kernel TemporalSpecular
#pragma kernel SpatialSpecular
#pragma kernel UpdateGeometryHistory
#pragma kernel UpsampleLighting
#pragma multi_compile _ _GBUFFER_NORMALS_OCT
#pragma target 5.0

// Final gather consumes persistent world-space radiance; it does not shade world hits inline.

#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Packing.hlsl"
