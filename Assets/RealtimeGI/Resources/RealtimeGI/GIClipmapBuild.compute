struct GINanitePageTableEntry
{
    uint slotIndex;
    uint byteAddress;
    uint packedBytes;
    uint flags;
    uint meshIndex;
    uint localPageIndex;
    uint generation;
    uint reserved;
};

struct GINaniteResidentPageEntry
{
    uint vertexBase;
    uint indexBase;
    uint vertexCount;
    uint indexCount;
    uint flags;
    uint generation;
    uint reserved0;
    uint reserved1;
};

struct GINaniteResidentVertex
{
    float3 position;
    float2 uv;
    float3 normal;
    float4 tangent;
};

StructuredBuffer<GINanitePageTableEntry> _GINanitePageTable;
StructuredBuffer<GINaniteResidentPageEntry> _GINaniteResidentPageTable;
StructuredBuffer<uint> _GINaniteResidencyBits;
StructuredBuffer<GINaniteResidentVertex> _GINaniteResidentVertices;
StructuredBuffer<uint> _GINaniteResidentIndices;
StructuredBuffer<uint> _GINaniteResidentTriangleSubMeshes;
StructuredBuffer<GIClipmapLevelData> _GIClipmapLevels;
